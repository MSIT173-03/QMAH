* text=auto

# 第三方前端套件保留原始內容，不做換行轉換或一般文字差異比較。
QMAH.Web/wwwroot/lib/** -text -diff linguist-vendored

# Database source and generated full restore script remain reviewable text.
database/*.sql text eol=lf

# Azure Linux 設定不能隨 Windows checkout 轉成 CRLF。
deploy/azure-demo/*.sh text eol=lf
deploy/azure-demo/*.service text eol=lf
deploy/azure-demo/*.timer text eol=lf
deploy/azure-demo/Caddyfile text eol=lf

# Docker 啟動腳本在容器內執行，不能轉成 CRLF。
deploy/docker/*.sh text eol=lf
deploy/docker/nginx.conf text eol=lf
