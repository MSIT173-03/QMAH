@model QMAH.Web.Areas.User.ViewModels.LoginViewModel

@{
    Layout = "/Views/Shared/Auth/_AuthLayout.cshtml";
    ViewData["Title"] = "管理員登入";
}

<div class="qmah-auth-page">
    <div class="qmah-auth-art" aria-hidden="true">
        <span class="qmah-auth-shape qmah-auth-orbit qmah-auth-orbit--one"></span>
        <span class="qmah-auth-shape qmah-auth-orbit qmah-auth-orbit--two"></span>
        <span class="qmah-auth-shape qmah-auth-diamond"></span>
        <span class="qmah-auth-shape qmah-auth-square"></span>
        <span class="qmah-auth-line qmah-auth-line--one"></span>
        <span class="qmah-auth-line qmah-auth-line--two"></span>
        <span class="qmah-auth-dot qmah-auth-dot--one"></span>
        <span class="qmah-auth-dot qmah-auth-dot--two"></span>
        <span class="qmah-auth-dot qmah-auth-dot--three"></span>
    </div>

    <div class="qmah-auth-shell">
        <section class="qmah-auth-brand" aria-labelledby="auth-title">
            <img class="qmah-auth-logo qmah-auth-logo--light" src="~/images/brand/qmah-logo.svg" alt="清明鑑定屋 QMAH" />
            <img class="qmah-auth-logo qmah-auth-logo--dark" src="~/images/brand/qmah-logo-dark.svg" alt="清明鑑定屋 QMAH" />
            <div class="qmah-auth-kicker"><span aria-hidden="true"></span>QMAH 管理後台</div>
            <h1 id="auth-title">登入管理後台</h1>
            <p>使用管理員帳號進入清明鑑定屋工作台。</p>
        </section>

        <section class="qmah-auth-panel" aria-labelledby="login-form-title">
            <div class="qmah-auth-panel-header">
                <span class="avatar avatar-md bg-blue-lt" aria-hidden="true"><i class="ti ti-lock-open-2"></i></span>
                <div>
                    <h2 id="login-form-title">登入</h2>
                    <p>使用管理員帳號繼續。</p>
                </div>
            </div>

            <form asp-area="User" asp-controller="Account" asp-action="Login" method="post" class="qmah-auth-form" data-qmah-auth-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger qmah-auth-validation" role="alert" aria-live="assertive"></div>

                <div class="mb-3 qmah-auth-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus aria-describedby="email-error" />
                    <span id="email-error" asp-validation-for="Email" class="text-danger" aria-live="polite"></span>
                </div>
                <div class="mb-3 qmah-auth-field">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group qmah-password-field">
                        <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" aria-describedby="password-error" />
                        <button type="button" class="btn btn-outline-secondary qmah-password-toggle" data-qmah-password-toggle aria-controls="Password" aria-pressed="false" aria-label="顯示密碼">
                            <i class="ti ti-eye" aria-hidden="true"></i><span class="visually-hidden">顯示密碼</span>
                        </button>
                    </div>
                    <span id="password-error" asp-validation-for="Password" class="text-danger" aria-live="polite"></span>
                </div>
                <label class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <span class="form-check-label">記住我</span>
                </label>
                <button type="submit" class="btn btn-primary w-100" data-qmah-auth-submit>
                    <i class="ti ti-login me-1" aria-hidden="true"></i><span data-qmah-submit-label>登入</span>
                </button>
                <p class="qmah-auth-note"><i class="ti ti-shield-lock" aria-hidden="true"></i> 僅限授權的管理人員使用</p>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector("[data-qmah-auth-form]");
            const password = document.querySelector("#Password");
            const toggle = document.querySelector("[data-qmah-password-toggle]");
            const submit = document.querySelector("[data-qmah-auth-submit]");
            const submitLabel = submit?.querySelector("[data-qmah-submit-label]");

            toggle?.addEventListener("click", () => {
                if (!password) return;
                const isVisible = password.type === "text";
                password.type = isVisible ? "password" : "text";
                toggle.setAttribute("aria-pressed", String(!isVisible));
                toggle.setAttribute("aria-label", isVisible ? "顯示密碼" : "隱藏密碼");
                toggle.querySelector("i")?.classList.toggle("ti-eye", isVisible);
                toggle.querySelector("i")?.classList.toggle("ti-eye-off", !isVisible);
                toggle.querySelector(".visually-hidden").textContent = isVisible ? "顯示密碼" : "隱藏密碼";
            });

            form?.addEventListener("submit", (event) => {
                if (form.classList.contains("qmah-is-submitting")) {
                    event.preventDefault();
                    return;
                }

                form.classList.add("qmah-is-submitting");
                form.setAttribute("aria-busy", "true");
                if (submit) submit.disabled = true;
                if (submitLabel) submitLabel.textContent = "登入中…";
            });
        })();
    </script>
}
