@model QMAH.Web.Areas.User.ViewModels.LoginViewModel

@{
    Layout = "/Views/Shared/Auth/_AuthLayout.cshtml";
    ViewData["Title"] = "管理員登入";

    var rawArtifactImages = ViewData["LoginArtifactImages"] as string[] ?? Array.Empty<string>();
    var artifactImages = rawArtifactImages
        .Where(path => !string.IsNullOrWhiteSpace(path))
        .Select(path =>
        {
            if (Uri.TryCreate(path, UriKind.Absolute, out _)) return path;
            if (path.StartsWith("~/", StringComparison.Ordinal)) return Url.Content(path);
            if (path.StartsWith("/", StringComparison.Ordinal)) return Url.Content("~" + path);
            return Url.Content("~/" + path.TrimStart('/'));
        })
        .Where(path => !string.IsNullOrWhiteSpace(path))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    var ribbonCount = artifactImages.Length switch
    {
        <= 8 => 2,
        <= 18 => 3,
        _ => 4
    };

    var ribbonRows = Enumerable.Range(0, ribbonCount)
        .Select(ribbon => artifactImages.Where((_, index) => index % ribbonCount == ribbon).ToArray())
        .ToArray();
}

<div class="qmah-auth-page">
    <section class="qmah-auth-scene" aria-label="清明鑑定屋文物典藏牆">
        @if (artifactImages.Length > 0)
        {
            <div class="qmah-auth-editorial-wall" aria-hidden="true">
                @for (var ribbonIndex = 0; ribbonIndex < ribbonRows.Length; ribbonIndex++)
                {
                    var ribbonItems = ribbonRows[ribbonIndex];
                    if (ribbonItems.Length == 0)
                    {
                        continue;
                    }

                    var direction = ribbonIndex % 2 == 0 ? "left" : "right";
                    var durationSeconds = Math.Clamp(
                        (int)Math.Round(ribbonItems.Length * 9.2 + 82 + ribbonIndex * 8),
                        138,
                        265);
                    var tilt = ribbonIndex switch
                    {
                        0 => "-0.62deg",
                        1 => "0.42deg",
                        2 => "-0.30deg",
                        _ => "0.48deg"
                    };
                    var ribbonStyle = $"--qmah-ribbon-duration:{durationSeconds}s;--qmah-ribbon-tilt:{tilt};";

                    <div class="qmah-auth-ribbon qmah-auth-ribbon--@direction qmah-auth-ribbon--@((ribbonIndex % 4) + 1)" style="@ribbonStyle">
                        <div class="qmah-auth-ribbon-track">
                            @for (var repeat = 0; repeat < 2; repeat++)
                            {
                                <div class="qmah-auth-ribbon-set">
                                    @for (var itemIndex = 0; itemIndex < ribbonItems.Length; itemIndex++)
                                    {
                                        var imagePath = ribbonItems[itemIndex];
                                        var pattern = (itemIndex + ribbonIndex * 11) % 36;
                                        var sizeClass = pattern switch
                                        {
                                            0 or 23 => "hero",
                                            5 or 13 or 28 or 33 => "large",
                                            3 or 10 or 18 or 31 => "small",
                                            _ => "medium"
                                        };
                                        var tiltClass = pattern switch
                                        {
                                            8 => "tilt-left",
                                            17 => "tilt-right",
                                            29 => "tilt-left-soft",
                                            34 => "tilt-right-soft",
                                            _ => "straight"
                                        };
                                        var raiseClass = pattern switch
                                        {
                                            6 => "raise-high",
                                            15 => "lower",
                                            25 => "raise",
                                            32 => "lower-soft",
                                            _ => "level"
                                        };
                                        var spacingClass = pattern switch
                                        {
                                            4 or 20 => "space-wide",
                                            11 or 30 => "space-tight",
                                            _ => "space-normal"
                                        };

                                        <figure class="qmah-auth-artifact qmah-auth-artifact--@sizeClass qmah-auth-artifact--@tiltClass qmah-auth-artifact--@raiseClass qmah-auth-artifact--@spacingClass">
                                            <img src="@imagePath"
                                                 alt=""
                                                 decoding="async"
                                                 loading="@(repeat == 0 && ribbonIndex == 0 && itemIndex == 0 ? "eager" : "lazy")"
                                                 fetchpriority="@(repeat == 0 && ribbonIndex == 0 && itemIndex == 0 ? "high" : "low")" />
                                        </figure>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <aside class="qmah-auth-access" aria-labelledby="auth-title">
        <div class="qmah-auth-access-shell">
            <header class="qmah-auth-access-top">
                <div class="qmah-auth-brand-lockup">
                    <img class="qmah-auth-logo qmah-auth-logo--light" src="~/images/brand/qmah-logo.svg" alt="清明鑑定屋 QMAH" />
                    <img class="qmah-auth-logo qmah-auth-logo--dark" src="~/images/brand/qmah-logo-dark.svg" alt="" aria-hidden="true" />
                </div>
            </header>

            <div class="qmah-auth-access-main">
                <header class="qmah-auth-heading">
                    <p class="qmah-auth-kicker">管理後台</p>
                    <h1 id="auth-title">登入</h1>
                    <p class="qmah-auth-description">管理文物典藏、社群內容與互動學習。</p>
                </header>

                <form asp-area="User" asp-controller="Account" asp-action="Login" method="post" class="qmah-auth-form" data-qmah-auth-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger qmah-auth-validation" role="alert" aria-live="assertive"></div>

                    <div class="qmah-auth-form-fields">
                        <div class="qmah-auth-field">
                            <label asp-for="Email" class="form-label">電子郵件</label>
                            <div class="qmah-auth-input-shell">
                                <svg class="qmah-auth-input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3.5" y="5" width="17" height="14" rx="2" />
                                    <path d="m4.5 6.5 7.5 6 7.5-6" />
                                </svg>
                                <input asp-for="Email" class="form-control" autocomplete="username" inputmode="email" aria-describedby="email-error" />
                            </div>
                            <span id="email-error" asp-validation-for="Email" class="text-danger" aria-live="polite"></span>
                        </div>

                        <div class="qmah-auth-field">
                            <label asp-for="Password" class="form-label">密碼</label>
                            <div class="qmah-password-control qmah-auth-input-shell">
                                <svg class="qmah-auth-input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="10" rx="2" />
                                    <path d="M8 10V7.5a4 4 0 0 1 8 0V10M12 14v2" />
                                </svg>
                                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" aria-describedby="password-error" />
                                <button type="button" class="qmah-password-toggle" data-qmah-password-toggle aria-controls="Password" aria-pressed="false" aria-label="顯示密碼">
                                    <span class="qmah-password-icon qmah-password-icon--show" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6s9.5 6 9.5 6s-3.5 6-9.5 6s-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.6" /></svg>
                                    </span>
                                    <span class="qmah-password-icon qmah-password-icon--hide" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="m3 3 18 18" /><path d="M10.6 6.1A9.8 9.8 0 0 1 12 6c6 0 9.5 6 9.5 6a16 16 0 0 1-2.4 3.2M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3-.5M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                                    </span>
                                </button>
                            </div>
                            <span id="password-error" asp-validation-for="Password" class="text-danger" aria-live="polite"></span>
                        </div>
                    </div>

                    <div class="qmah-auth-form-meta">
                        <label class="form-check qmah-auth-remember">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <span class="form-check-label">在此裝置保持登入</span>
                        </label>
                        <span class="qmah-auth-secure-note">最長 14 天</span>
                    </div>

                    <button type="submit" class="btn btn-primary qmah-auth-submit" data-qmah-auth-submit>
                        <span data-qmah-submit-label>登入後台</span>
                        <svg class="qmah-auth-submit-arrow" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                        <span class="qmah-auth-submit-spinner" aria-hidden="true"></span>
                    </button>
                </form>
            </div>

            <footer class="qmah-auth-access-footer" aria-hidden="true">
                <span>清明鑑定屋</span>
                <strong>典藏營運中心</strong>
            </footer>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector("[data-qmah-auth-form]");
            const password = document.querySelector("#Password");
            const toggle = document.querySelector("[data-qmah-password-toggle]");
            const submit = document.querySelector("[data-qmah-auth-submit]");
            const submitLabel = submit?.querySelector("[data-qmah-submit-label]");
            const scene = document.querySelector(".qmah-auth-scene");

            if (scene && "IntersectionObserver" in window) {
                const sceneObserver = new IntersectionObserver(([entry]) => {
                    scene.classList.toggle("qmah-auth-scene--offscreen", !entry.isIntersecting);
                }, { threshold: 0.01 });
                sceneObserver.observe(scene);
            }

            toggle?.addEventListener("click", () => {
                if (!password) return;

                const visible = password.type === "text";
                password.type = visible ? "password" : "text";
                toggle.classList.toggle("is-visible", !visible);
                toggle.setAttribute("aria-pressed", String(!visible));
                toggle.setAttribute("aria-label", visible ? "顯示密碼" : "隱藏密碼");
            });

            form?.addEventListener("submit", (event) => {
                if (form.classList.contains("qmah-is-submitting")) {
                    event.preventDefault();
                    return;
                }

                form.classList.add("qmah-is-submitting");
                form.setAttribute("aria-busy", "true");
                if (submit) submit.disabled = true;
                if (submitLabel) submitLabel.textContent = "登入中";
            });
        })();
    </script>
}
