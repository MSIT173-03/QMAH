@model QMAH.Web.Areas.User.ViewModels.GrantAchievementViewModel

@{
    ViewData["Title"] = "授予成就";
}

<h1>授予成就</h1>

<p>
    會員：@Model.Email
</p>

<form asp-action="GrantAchievement" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="UserId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="AchievementId"
               class="form-label">
            選擇成就
        </label>

        <select asp-for="AchievementId"
                asp-items="Model.AvailableAchievements"
                class="form-select">
            <option value="">請選擇成就</option>
        </select>
        <span asp-validation-for="AchievementId"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        授予成就
    </button>

    <a asp-action="Details"
       asp-route-id="@Model.UserId"
       class="btn btn-secondary">
        返回會員資料
    </a>
</form>