@using System.Linq
@using System.Globalization
@model QMAH.Web.Areas.User.ViewModels.MemberDetailsViewModel

@{
    ViewData["Title"] = "會員詳細資料";
    ViewData["AdminDescription"] = "分區查看會員帳號、個人資料、地址、成就與點數紀錄。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回會員列表
    </a>
}

<nav class="qmah-detail-nav" aria-label="會員資料區段">
    <a href="#account-data">帳號資料</a>
    <a href="#profile-data">個人資料</a>
    <a href="#addresses">收件地址</a>
    <a href="#achievements">成就</a>
    <a href="#point-transactions">點數紀錄</a>
</nav>

<div class="row row-cards mb-3">
    <!-- 帳號資料 -->
    <div class="col-12 col-xl-6" id="account-data">
        <div class="card qmah-detail-section h-100">
            <div class="card-header">
                <strong>帳號資料</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Email</div>
                        <div>@Model.User.Email</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">Email 驗證</div>
                        <div>
                            @if (Model.User.EmailConfirmed)
                            {
                                <span class="badge bg-success">已驗證</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">未驗證</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">角色</div>
                        <div>
                            @if (Model.Roles.Count == 0)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                @string.Join("、", Model.Roles.Select(QMAH.Web.Infrastructure.AdminDisplayLabels.Role))
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">帳號狀態</div>
                        <div>
                            @if (Model.User.Status == "ACTIVE")
                            {
                                <span class="badge bg-success">@AdminDisplayLabels.Status(Model.User.Status)</span>
                            }
                            else if (Model.User.Status == "BANNED")
                            {
                                <span class="badge bg-danger">@AdminDisplayLabels.Status(Model.User.Status)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @AdminDisplayLabels.Status(Model.User.Status)
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">目前點數</div>
                        <div class="fw-semibold">@Model.CurrentBalance</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">註冊時間</div>
                        <div>@Model.User.CreatedAt</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small">最後更新</div>
                        <div>@Model.User.UpdatedAt</div>
                    </div>
                </div>

                <div class="qmah-actions mt-4">
                    <a asp-action="EditRoles"
                       asp-route-id="@Model.User.Id"
                       class="btn btn-outline-warning">
                        角色設定
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.User.Id"
                       class="btn btn-primary">
                        編輯個人資料
                    </a>

                    @if (Model.Roles.Contains("User"))
                    {
                        <a asp-action="ResetPassword"
                           asp-route-id="@Model.User.Id"
                           class="btn btn-outline-primary">
                            <i class="ti ti-key me-1"></i>重設登入密碼
                        </a>
                    }
                    else if (Model.Roles.Contains("Admin") && User.Identity?.Name == Model.User.Email)
                    {
                        <a asp-action="ChangePassword"
                           class="btn btn-outline-primary">
                            <i class="ti ti-lock me-1"></i>修改我的密碼
                        </a>
                    }

                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.User.Id" />

                        @if (Model.User.Status == "ACTIVE")
                        {
                            <button type="submit"
                                    class="btn btn-outline-danger"
                                    onclick="return confirm('確定要停權這個會員嗎？');">
                                停權
                            </button>
                        }
                        else if (Model.User.Status == "BANNED")
                        {
                            <button type="submit"
                                    class="btn btn-outline-success"
                                    onclick="return confirm('確定要解除停權嗎？');">
                                解除停權
                            </button>
                        }
                        else if (Model.User.Status == "DISABLED")
                        {
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled>
                                帳號已停用
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 個人資料 -->
    <div class="col-12 col-xl-6" id="profile-data">
        <div class="card qmah-detail-section h-100">
            <div class="card-header">
                <strong>個人資料</strong>
            </div>

            <div class="card-body">
                @if (Model.Profile != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">暱稱</div>
                            <div>@Model.Profile.Nickname</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">公開範圍</div>
                            <div>
                                @if (Model.Profile.Visibility == "PUBLIC")
                                {
                                    <span class="badge bg-success">公開</span>
                                }
                                else if (Model.Profile.Visibility == "FRIENDS")
                                {
                                    <span class="badge bg-warning text-dark">好友</span>
                                }
                                else if (Model.Profile.Visibility == "PRIVATE")
                                {
                                    <span class="badge bg-secondary">私人</span>
                                }
                                else
                                {
                                    <span>@AdminDisplayLabels.Visibility(Model.Profile.Visibility)</span>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small">自我介紹</div>
                            <div>
                                @(string.IsNullOrWhiteSpace(Model.Profile.Bio)
                                    ? "-"
                                    : Model.Profile.Bio)
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small mb-2">會員頭像</div>

                            @if (!string.IsNullOrWhiteSpace(Model.Profile.AvatarPath))
                            {
                                <img src="@Model.Profile.AvatarPath"
                                     alt="會員頭像"
                                 class="qmah-member-avatar--detail" />
                            }
                            else
                            {
                                <div class="text-muted">尚未設定頭像</div>
                            }
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Profile 建立時間</div>
                            <div>@Model.Profile.CreatedAt</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Profile 最後更新</div>
                            <div>@Model.Profile.UpdatedAt</div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">此會員尚未建立個人資料。</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- 收件地址 -->
<div class="card qmah-detail-section mb-3" id="addresses">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>收件地址</strong>

        <a asp-action="CreateAddress"
           asp-route-userId="@Model.User.Id"
           class="btn btn-sm btn-outline-primary">
            新增地址
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model.Addresses.Count == 0)
        {
            <div class="empty qmah-empty-state">
                <div class="empty-icon">
                    <i class="ti ti-map-pin-off"></i>
                </div>
                <p class="empty-title">目前沒有地址資料</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table mb-0">
                    <thead>
                        <tr>
                            <th>標籤</th>
                            <th>收件人</th>
                            <th>電話</th>
                            <th>地址</th>
                            <th>預設</th>
                            <th>操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var address in Model.Addresses)
                        {
                            var addressText = string.Join(" ", new[] { address.PostalCode, address.City, address.District, address.AddressLine }.Where(value => !string.IsNullOrWhiteSpace(value)));
                            <tr>
                                <td>@address.AddressLabel</td>
                                <td>@address.RecipientName</td>
                                <td>@address.RecipientPhone</td>
                                <td>
                                    <div>@addressText</div>
                                    <a class="btn btn-sm btn-outline-secondary mt-1"
                                       data-qmah-map-link
                                       data-qmah-map-location="@addressText"
                                       data-qmah-map-latitude="@address.Latitude?.ToString(CultureInfo.InvariantCulture)"
                                       data-qmah-map-longitude="@address.Longitude?.ToString(CultureInfo.InvariantCulture)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       hidden>
                                        <i class="ti ti-map-pin me-1" aria-hidden="true"></i>查看地圖
                                    </a>
                                </td>
                                <td>
                                    @if (address.IsDefault)
                                    {
                                        <span class="badge bg-success">預設</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <div class="qmah-table-actions">
                                        <a asp-action="EditAddress"
                                           asp-route-id="@address.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            編輯
                                        </a>

                                        <form asp-action="DeleteAddress"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@address.Id" />

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@Model.User.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('確定要刪除這筆地址嗎？');">
                                                刪除
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 已取得成就 -->
<div class="card qmah-detail-section mb-3" id="achievements">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>已取得成就</strong>

        <a asp-action="GrantAchievement"
           asp-route-userId="@Model.User.Id"
           class="btn btn-sm btn-primary">
            授予成就
        </a>
    </div>

    <div class="card-body border-bottom">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="text-secondary small">目前配戴稱號</div>
                <strong>@(Model.EquippedTitle?.Title ?? "未配戴")</strong>
                @if (Model.EquippedTitle is not null)
                {
                    <div class="text-secondary small">來自成就：@Model.EquippedTitle.AchievementName</div>
                }
            </div>
            <form asp-action="SetEquippedTitle" method="post" class="d-flex flex-wrap align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.User.Id" />
                <label class="visually-hidden" for="equipped-title-select">選擇配戴稱號</label>
                <select id="equipped-title-select" name="userAchievementId" class="form-select" aria-label="選擇配戴稱號">
                    <option value="">不配戴稱號</option>
                    @foreach (var achievement in Model.Achievements.Where(item => !string.IsNullOrWhiteSpace(item.Achievement.Title)))
                    {
                        <option value="@achievement.Id" selected="@(Model.EquippedTitle?.UserAchievementId == achievement.Id ? "selected" : null)">@achievement.Achievement.Title · @achievement.Achievement.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary"><i class="ti ti-id-badge me-1"></i>更新配戴</button>
            </form>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Achievements.Count == 0)
        {
            <div class="empty qmah-empty-state">
                <div class="empty-icon">
                    <i class="ti ti-award-off"></i>
                </div>
                <p class="empty-title">目前尚未取得任何成就</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table mb-0">
                    <thead>
                        <tr>
                            <th>成就名稱</th>
                            <th>標題</th>
                            <th>取得時間</th>
                            <th>展示狀態</th>
                            <th>展示時間</th>
                            <th>操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Achievements)
                        {
                            <tr>
                                <td>@item.Achievement.Name</td>
                                <td>@item.Achievement.Title</td>
                                <td>@item.AchievedAt</td>
                                <td>
                                    @if (item.IsDisplayed)
                                    {
                                        <span class="badge bg-success">展示中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">未展示</span>
                                    }
                                </td>
                                <td>
                                    @if (item.DisplayedAt.HasValue)
                                    {
                                        @item.DisplayedAt.Value
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <div class="qmah-table-actions">
                                        <form asp-action="RemoveAchievement"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@Model.User.Id" />

                                            <input type="hidden"
                                                   name="rowVersion"
                                                   value="@Convert.ToBase64String(item.RowVersion)" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('確定要移除此會員的這個成就嗎？');">
                                                移除
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 點數異動紀錄 -->
<div class="card qmah-detail-section" id="point-transactions">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>點數異動紀錄</strong>

        <a asp-action="AdjustPoints"
           asp-route-id="@Model.User.Id"
           class="btn btn-sm btn-warning">
            調整點數
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model.PointTransactions.Count == 0)
        {
            <div class="empty qmah-empty-state">
                <div class="empty-icon">
                    <i class="ti ti-coins-off"></i>
                </div>
                <p class="empty-title">目前沒有點數異動紀錄</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table mb-0">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>異動</th>
                            <th>原因</th>
                            <th>類型</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.PointTransactions)
                        {
                            <tr>
                                <td>@item.CreatedAt</td>
                                <td>
                                    @if (item.Amount > 0)
                                    {
                                        <span class="text-success fw-semibold">
                                            +@item.Amount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">
                                            @item.Amount
                                        </span>
                                    }
                                </td>
                                <td>@AdminDisplayLabels.PointReason(item.Reason)</td>
                                <td>@AdminDisplayLabels.PointReferenceType(item.ReferenceType)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
