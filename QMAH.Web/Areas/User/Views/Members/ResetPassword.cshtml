@model QMAH.Web.Areas.User.ViewModels.ResetMemberPasswordViewModel
@{
    ViewData["Title"] = "重設會員密碼";
    ViewData["AdminDescription"] = "由管理員替一般會員設定新的登入密碼。";
}

@section PageActions {
    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回會員資料</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
        <div class="card qmah-form-card">
            <div class="card-header"><div><h2 class="card-title">重設會員密碼</h2><div class="text-secondary small">帳號：@Model.Email</div></div></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="UserId" type="hidden" />
                    <input asp-for="Email" type="hidden" />
                    <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
                    <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                    <div class="d-flex justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">取消</a><button type="submit" class="btn btn-primary"><i class="ti ti-key me-1"></i>確認重設</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
