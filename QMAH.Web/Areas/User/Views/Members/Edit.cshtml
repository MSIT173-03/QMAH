@model QMAH.Web.Areas.User.ViewModels.MemberEditViewModel

@{
    ViewData["Title"] = "編輯會員";
    ViewData["AdminDescription"] = "更新會員的公開資料與個人檔案設定。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回會員管理</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="card qmah-form-card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">會員資料</h2>
                    <div class="text-secondary">Email 僅供查看，其他欄位會套用到會員個人資料。</div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="RowVersion" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <section class="qmah-form-section">
                        <h3 class="qmah-form-section-title">基本資料</h3>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" asp-for="Email">Email</label>
                                <input asp-for="Email" class="form-control" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Nickname" class="form-label">暱稱</label>
                                <input asp-for="Nickname" class="form-control" />
                                <span asp-validation-for="Nickname" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Bio" class="form-label">自我介紹</label>
                                <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Bio" class="text-danger"></span>
                            </div>
                        </div>
                    </section>

                    <section class="qmah-form-section">
                        <h3 class="qmah-form-section-title">頭像與公開範圍</h3>
                        <div class="row g-3">
                            @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
                            {
                                <div class="col-12">
                                    <label class="form-label">目前頭像</label>
                                    <div><img src="@Model.AvatarPath" alt="目前頭像" class="qmah-member-avatar" /></div>
                                </div>
                            }
                            <div class="col-12 col-md-7">
                                <label asp-for="AvatarFile" class="form-label">更換頭像</label>
                                <input asp-for="AvatarFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="AvatarFile" class="text-danger"></span>
                                <div class="form-text">支援 JPG、JPEG、PNG、WEBP，最大 5 MB。</div>
                            </div>
                            <div class="col-12 col-md-5">
                                <label asp-for="Visibility" class="form-label">公開範圍</label>
                                <select asp-for="Visibility" class="form-select">
                                    <option value="PUBLIC">公開</option>
                                    <option value="FRIENDS">好友</option>
                                    <option value="PRIVATE">私人</option>
                                </select>
                                <span asp-validation-for="Visibility" class="text-danger"></span>
                            </div>
                        </div>
                    </section>

                    <div class="qmah-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存變更</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
