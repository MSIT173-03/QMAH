@model QMAH.Web.Areas.User.ViewModels.MemberRoleEditViewModel

@{
    ViewData["Title"] = "角色設定";
    ViewData["AdminDescription"] = "調整會員在後台與平台功能中的存取角色。";
}

@section PageActions {
    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回會員資料
    </a>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
        <div class="card qmah-form-card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">角色設定</h2>
                    <div class="text-secondary small">帳號：@Model.Email</div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="EditRoles" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <section class="qmah-form-section">
                        <h3 class="qmah-form-section-title">可用角色</h3>
                        <p class="text-secondary small mb-3">一個會員目前只保留一個主要角色；變更後會立即套用。</p>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="SelectedRole"
                                       value="@role"
                                       id="role-@role"
                                       checked="@(Model.SelectedRole == role)" />
                                <label class="form-check-label" for="role-@role">
                                    @QMAH.Web.Infrastructure.AdminDisplayLabels.Role(role)
                                </label>
                            </div>
                        }
                        <span asp-validation-for="SelectedRole" class="text-danger"></span>
                    </section>

                    <div class="qmah-form-actions">
                        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>儲存角色
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
