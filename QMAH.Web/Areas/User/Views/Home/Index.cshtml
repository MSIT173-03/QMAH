@using QMAH.Web.Infrastructure.AdminNavigation
@inject AdminNavigationService AdminNavigation
@model QMAH.Web.Areas.User.ViewModels.HomeDashboardViewModel

@{
    ViewData["Title"] = "會員總覽";
    ViewData["AdminDescription"] = "集中掌握會員帳號、角色、個人資料、成就與點數狀態。";

    var workspaceItems = AdminNavigation.GetAreaItems("User");

    string WorkspaceDescription(string controller) => controller switch
    {
        "Members" => "狀態、角色與會員帳號管理",
        "Profile" => "查看與維護會員個人資料",
        "Achievements" => "建立與維護成就條件",
        "PointBackpack" => "查看與調整會員點數餘額",
        "PointTransactions" => "追蹤會員點數異動紀錄",
        _ => "進入此管理功能"
    };
}

@section PageActions {
    <a asp-area="User" asp-controller="Members" asp-action="Index" class="btn btn-primary">
        <i class="ti ti-user-cog me-1"></i>會員帳號
    </a>
}

<div class="qmah-area-overview">
    <section class="qmah-area-metrics qmah-area-metrics--4" aria-label="會員資料摘要">
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-users"></i></span><div><span class="qmah-area-metric__label">會員總數</span><strong class="qmah-area-metric__value">@Model.TotalMembers</strong><span class="qmah-area-metric__note">全部 Identity 帳號</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-user-plus"></i></span><div><span class="qmah-area-metric__label">近 30 天新增</span><strong class="qmah-area-metric__value">@Model.NewMembers</strong><span class="qmah-area-metric__note">最近建立的帳號</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-user-off"></i></span><div><span class="qmah-area-metric__label">停權帳號</span><strong class="qmah-area-metric__value">@Model.BannedMembers</strong><span class="qmah-area-metric__note">需要後台處理</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-award"></i></span><div><span class="qmah-area-metric__label">成就定義</span><strong class="qmah-area-metric__value">@Model.Achievements.Count</strong><span class="qmah-area-metric__note">目前成就設定摘要</span></div></article>
    </section>

    <div class="qmah-area-overview-grid">
        <section class="card qmah-area-card qmah-area-workbench">
            <div class="card-header"><div><h2 class="card-title mb-1">會員工作區</h2><div class="card-subtitle">依用途進入會員相關管理功能。</div></div></div>
            <div class="card-body">
                <div class="qmah-area-tile-grid">
                    @foreach (var item in workspaceItems)
                    {
                        <a class="qmah-area-action"
                           asp-area="User"
                           asp-controller="@item.Controller"
                           asp-action="Index">
                            <span class="qmah-area-action__icon">
                                <partial name="Admin/_Icon" model="@item.Controller" />
                            </span>
                            <span>
                                <strong>@item.Label</strong>
                                <small>@WorkspaceDescription(item.Controller)</small>
                            </span>
                            <i class="ti ti-chevron-right qmah-area-action__arrow" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header">
                <div><h2 class="card-title mb-1">最近會員</h2><div class="card-subtitle">依建立時間顯示最近會員帳號。</div></div>
                <div class="card-actions"><a asp-area="User" asp-controller="Members" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a></div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table">
                    <thead><tr><th>帳號</th><th>Email</th><th>狀態</th><th>建立時間</th><th class="w-1"></th></tr></thead>
                    <tbody>
                    @if (Model.RecentMembers.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-secondary py-4">目前沒有會員資料。</td></tr>
                    }
                    else
                    {
                        @foreach (var member in Model.RecentMembers)
                        {
                            <tr>
                                <td class="fw-semibold">@(member.UserName ?? "-")</td>
                                <td>@(member.Email ?? "-")</td>
                                <td><span class="badge @(member.Status == "ACTIVE" ? "bg-green-lt" : member.Status == "BANNED" ? "bg-red-lt" : "bg-secondary-lt")">@AdminDisplayLabels.Status(member.Status)</span></td>
                                <td class="text-secondary text-nowrap">@member.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                <td><a asp-area="User" asp-controller="Members" asp-action="Details" asp-route-id="@member.Id" class="btn btn-sm btn-outline-secondary">詳細</a></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="qmah-area-detail-grid qmah-area-detail-grid--2">
        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">最近會員活動</h2><div class="card-subtitle">最近會員個人資料與社群活動摘要。</div></div></div>
            <div class="list-group list-group-flush qmah-area-list">
            @if (Model.ProfileActivities.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有會員活動資料</p></div>
            }
            else
            {
                @foreach (var item in Model.ProfileActivities)
                {
                    <a class="list-group-item list-group-item-action" asp-area="User" asp-controller="Members" asp-action="Details" asp-route-id="@item.UserId">
                        <div class="d-flex justify-content-between gap-3"><strong>@item.Email</strong><span class="badge bg-secondary-lt">@item.RecentActivity</span></div>
                        <div class="text-secondary small mt-1">@(string.IsNullOrWhiteSpace(item.Nickname) ? "未設定暱稱" : item.Nickname) · 貼文 @item.PostCount／留言 @item.CommentCount</div>
                    </a>
                }
            }
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header">
                <div><h2 class="card-title mb-1">最近點數異動</h2><div class="card-subtitle">最近會員點數增加與扣除紀錄。</div></div>
                <div class="card-actions"><a asp-area="User" asp-controller="PointTransactions" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a></div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table qmah-crud-table">
                    <thead><tr><th>時間</th><th>異動</th><th>原因</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.RecentPointTransactions)
                    {
                        <tr>
                            <td class="text-secondary text-nowrap">@item.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            <td class="@(item.Amount >= 0 ? "text-success" : "text-danger")">@(item.Amount >= 0 ? "+" : "")@item.Amount</td>
                            <td>@item.Reason</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
