@model QMAH.Web.Areas.User.ViewModels.HomeDashboardViewModel

@{
    ViewData["Title"] = "會員管理總覽";
    ViewData["AdminDescription"] = "集中管理會員帳號、角色、個人資料、成就與點數。";
}

@section PageActions {
    <a asp-area="User" asp-controller="Members" asp-action="Index" class="btn btn-primary"><i class="ti ti-users me-1"></i>會員帳號</a>
    <a asp-area="User" asp-controller="Achievements" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-award me-1"></i>成就設定</a>
    <a asp-area="User" asp-controller="PointTransactions" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-coin me-1"></i>點數流水</a>
}

<div class="row row-cards qmah-dashboard-metrics">
    <div class="col-12 col-sm-6 col-xl-3"><div class="card qmah-metric-card"><div class="card-body"><span class="qmah-metric-label">會員總數</span><strong class="qmah-metric-value">@Model.TotalMembers</strong><span class="qmah-metric-note">全部 Identity 帳號</span></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="card qmah-metric-card"><div class="card-body"><span class="qmah-metric-label">近 30 天新增</span><strong class="qmah-metric-value">@Model.NewMembers</strong><span class="qmah-metric-note">最近建立的帳號</span></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="card qmah-metric-card"><div class="card-body"><span class="qmah-metric-label">停權帳號</span><strong class="qmah-metric-value">@Model.BannedMembers</strong><span class="qmah-metric-note">需要後台處理</span></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="card qmah-metric-card"><div class="card-body"><span class="qmah-metric-label">成就定義</span><strong class="qmah-metric-value">@Model.Achievements.Count</strong><span class="qmah-metric-note">快速摘要前 5 筆</span></div></div></div>
</div>

<div class="row row-cards">
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center gap-3">
                <div><h2 class="card-title mb-1">最近會員</h2><div class="text-secondary">依建立時間顯示最近帳號。</div></div>
                <a asp-area="User" asp-controller="Members" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table">
                    <thead><tr><th>帳號</th><th>Email</th><th>狀態</th><th>建立時間</th><th class="w-1"></th></tr></thead>
                    <tbody>
                    @if (Model.RecentMembers.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-secondary py-4">目前沒有會員資料。</td></tr>
                    }
                    else
                    {
                        @foreach (var member in Model.RecentMembers)
                        {
                            <tr>
                                <td class="fw-semibold">@(member.UserName ?? "-")</td>
                                <td>@(member.Email ?? "-")</td>
                                <td><span class="badge @(member.Status == "ACTIVE" ? "bg-green-lt" : member.Status == "BANNED" ? "bg-red-lt" : "bg-secondary-lt")">@AdminDisplayLabels.Status(member.Status)</span></td>
                                <td class="text-secondary text-nowrap">@member.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td><a asp-area="User" asp-controller="Members" asp-action="Details" asp-route-id="@member.Id" class="btn btn-sm btn-outline-secondary">詳細</a></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">會員作業</h2></div>
            <div class="card-body">
                <div class="qmah-quick-grid">
                    <a class="qmah-quick-link" asp-area="User" asp-controller="Members" asp-action="Index"><span class="avatar bg-blue-lt"><i class="ti ti-user-cog"></i></span><span><strong>會員帳號</strong><small>狀態、角色、地址與成就</small></span></a>
                    <a class="qmah-quick-link" asp-area="User" asp-controller="Achievements" asp-action="Index"><span class="avatar bg-yellow-lt"><i class="ti ti-award"></i></span><span><strong>成就設定</strong><small>建立與維護成就條件</small></span></a>
                    <a class="qmah-quick-link" asp-area="User" asp-controller="PointTransactions" asp-action="Index"><span class="avatar bg-green-lt"><i class="ti ti-coin"></i></span><span><strong>點數流水</strong><small>查看與調整會員點數</small></span></a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards mt-3">
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">最近會員活動</h2></div>
            <div class="list-group list-group-flush">
            @if (Model.ProfileActivities.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有檔案活動資料。</p></div>
            }
            else
            {
                @foreach (var item in Model.ProfileActivities)
                {
                    <a class="list-group-item list-group-item-action" asp-area="User" asp-controller="Members" asp-action="Details" asp-route-id="@item.UserId">
                        <div class="d-flex justify-content-between gap-3"><strong>@item.Email</strong><span class="badge bg-secondary-lt">@item.RecentActivity</span></div>
                        <div class="text-secondary small mt-1">@(string.IsNullOrWhiteSpace(item.Nickname) ? "未設定暱稱" : item.Nickname) · 貼文 @item.PostCount／留言 @item.CommentCount</div>
                    </a>
                }
            }
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><h2 class="card-title">最近點數異動</h2><a asp-area="User" asp-controller="PointTransactions" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table qmah-crud-table">
                    <thead><tr><th>時間</th><th>異動</th><th>原因</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.RecentPointTransactions)
                    {
                        <tr><td class="text-secondary text-nowrap">@item.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td><td class="@(item.Amount >= 0 ? "text-success" : "text-danger")">@(item.Amount >= 0 ? "+" : "")@item.Amount</td><td>@item.Reason</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
