@model IEnumerable<QMAH.Web.Areas.User.ViewModels.PointBackpackListItemViewModel>

@{
    ViewData["Title"] = "點數背包";
    ViewData["AdminDescription"] = "查看各會員目前持有的點數餘額，並進入既有點數調整功能。";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    int pageSize = ViewBag.PageSize;

    int start = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int end = Math.Min(currentPage * pageSize, totalCount);
}

@section PageActions {
    <div class="qmah-actions d-flex flex-wrap gap-2">
        <a asp-area="User" asp-controller="PointBackpack" asp-action="Index" class="btn btn-secondary">
            <i class="ti ti-wallet me-1"></i>點數背包
        </a>
        <a asp-area="User" asp-controller="PointTransactions" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-receipt me-1"></i>點數流水
        </a>
    </div>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title">查詢會員背包</h2>
            <div class="card-subtitle">依會員暱稱或 Email 搜尋點數餘額。</div>
        </div>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="qmah-filter-form">
            <div class="row g-2">
                <div class="col-md-9">
                    <input type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control"
                           placeholder="搜尋暱稱或 Email" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="ti ti-search me-1"></i>搜尋
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="card-header qmah-crud-toolbar">
        <div>
            <h2 class="card-title">會員背包</h2>
            <div class="card-subtitle">共 @totalCount 位會員</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <colgroup>
                <col style="width: 44%;" />
                <col style="width: 18%;" />
                <col style="width: 23%;" />
                <col style="width: 15%;" />
            </colgroup>
            <thead>
                <tr>
                    <th>會員</th>
                    <th>目前點數</th>
                    <th>最後更新</th>
                    <th class="text-center pe-4">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty qmah-empty-state">
                                <div class="empty-icon"><i class="ti ti-wallet-off"></i></div>
                                <p class="empty-title">目前沒有符合條件的會員</p>
                                <p class="empty-subtitle text-secondary">請調整搜尋條件後再試一次。</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@(item.Nickname ?? item.Email)</div>
                                @if (!string.IsNullOrWhiteSpace(item.Nickname))
                                {
                                    <div class="text-secondary small">@item.Email</div>
                                }
                            </td>
                            <td><span class="badge bg-blue-lt">@item.Balance</span></td>
                            <td class="text-secondary text-nowrap">
                                @(item.UpdatedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "尚無紀錄")
                            </td>
                            <td class="text-center pe-4">
                                <div class="qmah-table-actions justify-content-center">
                                    <a asp-area="User"
                                       asp-controller="Members"
                                       asp-action="AdjustPoints"
                                       asp-route-id="@item.UserId"
                                       class="btn btn-sm btn-primary px-3">
                                        調整點數
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="qmah-pagination-bar d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
    <div class="text-muted">顯示第 @start～@end 位，共 @totalCount 位會員</div>

    <nav aria-label="點數背包分頁">
        <div class="btn-list">
            @if (currentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-keyword="@ViewBag.Keyword"
                   class="btn btn-secondary">上一頁</a>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-keyword="@ViewBag.Keyword"
                   class="btn btn-sm @(i == currentPage ? "btn-primary" : "btn-outline-secondary")">@i</a>
            }

            @if (currentPage < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-keyword="@ViewBag.Keyword"
                   class="btn btn-secondary">下一頁</a>
            }
        </div>
    </nav>
</div>
