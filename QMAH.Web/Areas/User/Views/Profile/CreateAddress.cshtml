@model QMAH.Web.Areas.User.ViewModels.UserAddressCreateViewModel

@{
    ViewData["Title"] = "新增我的收件地址";
    ViewData["AdminDescription"] = "新增商城結帳時可使用的收件地址。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回個人資料
    </a>
}

<div class="row row-cards justify-content-center">
    <div class="col-12 col-xl-9">
        <form asp-action="CreateAddress" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="card qmah-form-card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">收件地址</h2>
                        <div class="card-subtitle">填寫收件人與完整配送地址。</div>
                    </div>
                </div>

                <div class="card-body">

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="AddressLabel" class="form-label">地址標籤</label>
                            <input asp-for="AddressLabel"
                                   class="form-control"
                                   placeholder="例如：住家、公司" />
                            <span asp-validation-for="AddressLabel" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="RecipientName" class="form-label">收件人</label>
                            <input asp-for="RecipientName" class="form-control" />
                            <span asp-validation-for="RecipientName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="RecipientPhone" class="form-label">電話</label>
                            <input asp-for="RecipientPhone" class="form-control" />
                            <span asp-validation-for="RecipientPhone" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-3">
                            <label asp-for="PostalCode" class="form-label">郵遞區號</label>
                            <input asp-for="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="City" class="form-label">縣市</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-5">
                            <label asp-for="District" class="form-label">區域</label>
                            <input asp-for="District" class="form-control" />
                            <span asp-validation-for="District" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label">詳細地址</label>
                            <input asp-for="AddressLine" class="form-control" />
                            <span asp-validation-for="AddressLine" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-check">
                                <input asp-for="IsDefault" class="form-check-input" />
                                <span class="form-check-label">設為預設地址</span>
                            </label>
                        </div>
                    </div>

                </div>

<div class="card-footer qmah-card-footer">
                    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>儲存地址
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
