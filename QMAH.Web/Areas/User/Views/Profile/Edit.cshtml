@model QMAH.Web.Areas.User.ViewModels.MemberEditViewModel

@{
    ViewData["Title"] = "編輯我的個人資料";
    ViewData["AdminDescription"] = "更新登入後顯示的暱稱、自我介紹、頭像與公開範圍。";
}

<div class="row row-cards justify-content-center">
    <div class="col-12 col-xl-9">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input asp-for="RowVersion" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title"><i class="ti ti-user-edit me-2"></i>個人資料</h2>
                        <div class="text-secondary">這些內容會套用到目前登入的管理帳號。</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-12 col-md-4">
                            <div class="text-center">
                                @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
                                {
                                    <img src="@Model.AvatarPath" alt="目前頭像" class="avatar avatar-xl mb-3" />
                                }
                                else
                                {
                                    <div class="avatar avatar-xl bg-blue-lt text-blue mb-3"><i class="ti ti-user" aria-hidden="true"></i></div>
                                }
                                <div class="text-secondary small">可上傳 JPG、JPEG、PNG 或 WEBP，最大 5 MB。</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-8">
                            <div class="mb-3">
                                <label class="form-label" for="Email">登入帳號</label>
                                <div class="input-icon">
                                    <span class="input-icon-addon"><i class="ti ti-at"></i></span>
                                    <input id="Email" value="@Model.Email" class="form-control" readonly />
                                </div>
                                <div class="form-hint">登入帳號請至密碼管理功能處理。</div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Nickname" class="form-label">暱稱</label>
                                <div class="input-icon">
                                    <span class="input-icon-addon"><i class="ti ti-id-badge"></i></span>
                                    <input asp-for="Nickname" class="form-control" autocomplete="nickname" />
                                </div>
                                <span asp-validation-for="Nickname" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Bio" class="form-label">自我介紹</label>
                                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="簡單介紹自己"></textarea>
                                <span asp-validation-for="Bio" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="AvatarFile" class="form-label">更換頭像</label>
                                <input asp-for="AvatarFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="AvatarFile" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="Visibility" class="form-label">個人資料公開範圍</label>
                                <select asp-for="Visibility" class="form-select">
                                    <option value="PUBLIC">公開</option>
                                    <option value="FRIENDS">僅好友</option>
                                    <option value="PRIVATE">不公開</option>
                                </select>
                                <span asp-validation-for="Visibility" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回個人資料</a>
                    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存變更</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
