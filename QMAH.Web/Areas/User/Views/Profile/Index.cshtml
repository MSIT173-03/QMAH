@using System.Globalization
@model QMAH.Web.Areas.User.ViewModels.ProfileIndexViewModel

@{
    ViewData["Title"] = "我的個人資料";
    ViewData["AdminDescription"] = "查看與維護個人資料、會員資訊、收件地址與近期點數紀錄。";

    var visibilityLabel = AdminDisplayLabels.Visibility(Model.Profile.Visibility);
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Edit" class="btn btn-primary">
            <i class="ti ti-user-edit me-1"></i>編輯個人資料
        </a>
        <a asp-action="CreateAddress" class="btn btn-outline-secondary">
            <i class="ti ti-map-pin-plus me-1"></i>新增地址
        </a>
    </div>
}

@if (TempData["AddressError"] != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@TempData["AddressError"]
    </div>
}

<div class="row row-cards mb-3">
    <div class="col-12 col-lg-4 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-4">
                @if (!string.IsNullOrWhiteSpace(Model.Profile.AvatarPath))
                {
                    <img src="@Model.Profile.AvatarPath"
                         alt="會員頭像"
                         class="avatar avatar-xl rounded-circle mb-3" />
                }
                else
                {
                    <span class="avatar avatar-xl rounded-circle bg-blue-lt text-blue mb-3">
                        <i class="ti ti-user fs-1"></i>
                    </span>
                }

                <h2 class="h3 mb-1">@Model.Profile.Nickname</h2>
                <div class="text-secondary text-break">@Model.User.Email</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8 col-xl-9">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title">個人資料</h2>
                    <div class="card-subtitle">目前帳號對外顯示的基本資料。</div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small mb-1">Email</div>
                        <div class="fw-semibold text-break">@Model.User.Email</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small mb-1">暱稱</div>
                        <div class="fw-semibold">@Model.Profile.Nickname</div>
                    </div>
                    <div class="col-12">
                        <div class="text-secondary small mb-1">自我介紹</div>
                        @if (string.IsNullOrWhiteSpace(Model.Profile.Bio))
                        {
                            <div class="text-secondary">尚未填寫</div>
                        }
                        else
                        {
                            <div class="lh-lg">@Model.Profile.Bio</div>
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small mb-1">公開範圍</div>
                        <span class="badge bg-secondary-lt">@visibilityLabel</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards row-cols-1 row-cols-md-3 mb-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="text-secondary mb-1">目前點數</div>
                    <div class="h2 mb-0">@Model.PointBalance</div>
                </div>
                <span class="avatar bg-blue-lt text-blue">
                    <i class="ti ti-coins"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="text-secondary mb-1">已取得成就</div>
                    <div class="h2 mb-0">@Model.AchievementCount</div>
                </div>
                <span class="avatar bg-green-lt text-green">
                    <i class="ti ti-trophy"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="text-secondary mb-1">收件地址</div>
                    <div class="h2 mb-0">@Model.Addresses.Count</div>
                </div>
                <span class="avatar bg-purple-lt text-purple">
                    <i class="ti ti-map-pin"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<div class="card qmah-list-card mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title">我的收件地址</h2>
            <div class="card-subtitle">管理商城訂單可使用的收件資訊。</div>
        </div>
        <div class="card-actions">
            <a asp-action="CreateAddress" class="btn btn-sm btn-outline-secondary">
                <i class="ti ti-plus me-1"></i>新增地址
            </a>
        </div>
    </div>

    @if (Model.Addresses.Count == 0)
    {
        <div class="empty py-5">
            <div class="empty-icon"><i class="ti ti-map-pin-off"></i></div>
            <p class="empty-title">目前沒有收件地址</p>
            <p class="empty-subtitle text-secondary">新增地址後可於商城結帳時使用。</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead>
                    <tr>
                        <th>標籤</th>
                        <th>收件人</th>
                        <th>電話</th>
                        <th>地址</th>
                        <th>預設</th>
                        <th class="w-1 text-center pe-3 pe-md-4">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var address in Model.Addresses)
                    {
                        var addressText = string.Join(" ", new[] { address.PostalCode, address.City, address.District, address.AddressLine }.Where(value => !string.IsNullOrWhiteSpace(value)));
                        <tr>
                            <td class="fw-semibold">@address.AddressLabel</td>
                            <td>@address.RecipientName</td>
                            <td class="text-nowrap">@address.RecipientPhone</td>
                            <td>
                                <div>@addressText</div>
                                <a class="btn btn-sm btn-outline-secondary mt-1"
                                   data-qmah-map-link
                                   data-qmah-map-location="@addressText"
                                   data-qmah-map-latitude="@address.Latitude?.ToString(CultureInfo.InvariantCulture)"
                                   data-qmah-map-longitude="@address.Longitude?.ToString(CultureInfo.InvariantCulture)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   hidden>
                                    <i class="ti ti-map-pin me-1" aria-hidden="true"></i>查看地圖
                                </a>
                            </td>
                            <td>
                                @if (address.IsDefault)
                                {
                                    <span class="badge bg-green-lt">預設</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="text-center pe-3 pe-md-4">
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <a asp-action="EditAddress"
                                       asp-route-id="@address.Id"
                                       class="btn btn-sm btn-outline-secondary px-3">
                                        編輯
                                    </a>

                                    <form asp-action="DeleteAddress" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@address.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger px-3"
                                                onclick="return confirm('確定要刪除這筆地址嗎？');">
                                            刪除
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card qmah-list-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">最近點數異動</h2>
            <div class="card-subtitle">顯示近期點數增加與扣除紀錄。</div>
        </div>
    </div>

    @if (Model.RecentPointTransactions.Count == 0)
    {
        <div class="empty py-5">
            <div class="empty-icon"><i class="ti ti-receipt-off"></i></div>
            <p class="empty-title">目前沒有點數異動紀錄</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead>
                    <tr>
                        <th>時間</th>
                        <th>異動</th>
                        <th>原因</th>
                        <th>類型</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentPointTransactions)
                    {
                        <tr>
                            <td class="text-secondary text-nowrap">
                                @item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            </td>
                            <td>
                                @if (item.Amount > 0)
                                {
                                    <span class="text-success fw-bold">+@item.Amount</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">@item.Amount</span>
                                }
                            </td>
                            <td>@AdminDisplayLabels.PointReason(item.Reason)</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.ReferenceType))
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">@AdminDisplayLabels.PointReferenceType(item.ReferenceType)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
