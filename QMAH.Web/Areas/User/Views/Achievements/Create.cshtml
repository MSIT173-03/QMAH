@model QMAH.Web.Areas.User.ViewModels.AchievementCreateViewModel

@{
    ViewData["Title"] = "新增成就";
    ViewData["AdminDescription"] = "建立會員可取得的成就，設定觸發條件與顯示狀態。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>返回成就管理</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card qmah-form-card">
            <div class="card-header"><h2 class="card-title">成就資料</h2></div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Code" class="form-label">代碼</label><input asp-for="Code" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Name" class="form-label">成就名稱</label><input asp-for="Name" class="form-control" /></div>
                        <div class="col-12"><label asp-for="Title" class="form-label">標題</label><input asp-for="Title" class="form-control" /></div>
                        <div class="col-12"><label asp-for="Description" class="form-label">說明</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
                        <div class="col-md-6">
                            <label asp-for="ConditionType" class="form-label">取得條件</label>
                            <select asp-for="ConditionType" class="form-select">
                                <option value="POST_COUNT">發布貼文數</option>
                                <option value="COMMENT_COUNT">留言數</option>
                                <option value="EVENT_JOIN_COUNT">活動參與數</option>
                                <option value="EVENT_HOST_COUNT">建立活動數</option>
                                <option value="GAME_PLAY_COUNT">遊戲參與數</option>
                                <option value="GAME_COMPLETE_COUNT">多人遊戲完成場數</option>
                                <option value="GAME_ROUND_WIN_COUNT">多人遊戲勝出回合數</option>
                                <option value="ARTIFACT_UNLOCK_COUNT">圖鑑解鎖數</option>
                                <option value="CATEGORY_COMPLETE_COUNT">完成分類數</option>
                                <option value="ERA_COMPLETE_COUNT">完成年代範圍數</option>
                                <option value="CATALOG_COMPLETION_PERCENT">圖鑑完成率</option>
                                <option value="MINIGAME_DETAIL_LOCATOR_COUNT">細節追蹤完成次數</option>
                                <option value="MINIGAME_ARTIFACT_PUZZLE_COUNT">館藏拼圖完成次數</option>
                                <option value="MINIGAME_MEMORY_MATCH_COUNT">館藏翻牌完成次數</option>
                                <option value="MINIGAME_STRIP_RESTORE_COUNT">長卷復位完成次數</option>
                                <option value="MINIGAME_GRADE_S_COUNT">Mini Game S 等級次數</option>
                            </select>
                        </div>
                        <div class="col-md-6"><label asp-for="ThresholdValue" class="form-label">門檻</label><input asp-for="ThresholdValue" type="number" min="1" class="form-control" /></div>
                        <div class="col-12"><label asp-for="IconFile" class="form-label">成就圖示</label><input asp-for="IconFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" /></div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">狀態</label>
                            <select asp-for="Status" class="form-select"><option value="ACTIVE">啟用</option><option value="INACTIVE">停用</option></select>
                        </div>
                    </div>

                    <div class="qmah-form-actions mt-4">
                        <a asp-action="Index" class="btn btn-secondary">取消</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-plus me-1"></i>建立成就</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
