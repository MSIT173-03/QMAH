@model IEnumerable<QMAH.Web.Areas.User.ViewModels.AchievementListItemViewModel>

@{
    ViewData["Title"] = "成就管理";
    ViewData["AdminDescription"] = "維護會員成就的條件、圖示與啟用狀態。";
}

@section PageActions { <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增成就</a> }

<div class="card qmah-list-card"><div class="table-responsive"><table class="table table-vcenter table-hover card-table qmah-crud-table">
    <thead>
        <tr>
            <th>成就名稱</th>
            <th>代碼</th>
            <th>取得條件</th>
            <th>門檻</th>
            <th>狀態</th>
            <th>取得人數</th>
            <th>操作</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Achievement.Name</td>
                <td>@item.Achievement.Code</td>
                <td><span class="badge bg-blue-lt">@AdminDisplayLabels.ConditionType(item.Achievement.ConditionType)</span><div class="text-secondary small">達 @item.Achievement.ThresholdValue</div></td>
                <td>@item.Achievement.ThresholdValue</td>

                <td>
                    @if (item.Achievement.Status == "ACTIVE")
                    {
                        <span class="badge bg-green-lt">啟用</span>
                    }
                    else if (item.Achievement.Status == "INACTIVE")
                    {
                        <span class="badge bg-secondary-lt">停用</span>
                    }
                </td>

                <td>@item.EarnedCount</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Achievement.Id"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="ti ti-edit me-1"></i>編輯
                    </a>
                    <form asp-action="ChangeStatus"
                          asp-route-id="@item.Achievement.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        @if (item.Achievement.Status == "ACTIVE")
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-outline-warning"
                                    onclick="return confirm('確定要停用這個成就嗎？')">
                                停用
                            </button>
                        }
                        else if (item.Achievement.Status == "INACTIVE")
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-outline-success"
                                    onclick="return confirm('確定要啟用這個成就嗎？')">
                                啟用
                            </button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table></div></div>
