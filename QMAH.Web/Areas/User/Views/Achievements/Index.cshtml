@model IEnumerable<QMAH.Web.Areas.User.ViewModels.AchievementListItemViewModel>

@{
    ViewData["Title"] = "成就管理";
    ViewData["AdminDescription"] = "維護會員成就的條件、圖示與啟用狀態。";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增成就</a>
}

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr><th>成就名稱</th><th>代碼</th><th>取得條件</th><th>門檻</th><th>狀態</th><th>取得人數</th><th class="qmah-action-cell qmah-actions--2">操作</th></tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty qmah-empty-state">
                            <div class="empty-icon"><i class="ti ti-trophy-off"></i></div>
                            <p class="empty-title">目前沒有成就資料</p>
                            <p class="empty-subtitle text-secondary">建立成就後即可在此維護啟用狀態。</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                    <td class="fw-semibold">@item.Achievement.Name</td>
                    <td><code>@item.Achievement.Code</code></td>
                    <td><span class="badge bg-blue-lt">@AdminDisplayLabels.ConditionType(item.Achievement.ConditionType)</span></td>
                    <td>@item.Achievement.ThresholdValue</td>
                    <td><span class="badge @(item.Achievement.Status == "ACTIVE" ? "bg-green-lt" : "bg-secondary-lt")">@(item.Achievement.Status == "ACTIVE" ? "啟用" : "停用")</span></td>
                    <td>@item.EarnedCount</td>
                    <td class="qmah-action-cell qmah-actions--2">
                        <div class="qmah-table-actions">
                            <a asp-action="Edit" asp-route-id="@item.Achievement.Id" class="btn btn-sm btn-primary">編輯</a>
                            <form asp-action="ChangeStatus" asp-route-id="@item.Achievement.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(item.Achievement.Status == "ACTIVE" ? "btn-danger" : "btn-success")"
                                        onclick="return confirm('@(item.Achievement.Status == "ACTIVE" ? "確定要停用這個成就嗎？" : "確定要啟用這個成就嗎？")')">
                                    @(item.Achievement.Status == "ACTIVE" ? "停用" : "啟用")
                                </button>
                            </form>
                        </div>
                    </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
