@model QMAH.Web.Areas.User.ViewModels.AchievementEditViewModel

@{
    ViewData["Title"] = "編輯成就";
}

<h1>編輯成就</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Code" class="form-label">代碼</label>
        <input asp-for="Code" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">成就名稱</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">標題</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">說明</label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="IconPath" class="form-label">圖示路徑</label>
        <input asp-for="IconPath" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ConditionType" class="form-label">條件類型</label>
        <input asp-for="ConditionType" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ThresholdValue" class="form-label">門檻</label>
        <input asp-for="ThresholdValue"
               class="form-control"
               type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">狀態</label>

        <select asp-for="Status" class="form-select">
            <option value="ACTIVE">啟用</option>
            <option value="INACTIVE">停用</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        儲存
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        返回
    </a>
</form>