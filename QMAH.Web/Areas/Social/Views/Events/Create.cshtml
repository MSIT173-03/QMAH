@model QMAH.Web.Models.Entities.Event

@{
    ViewData["Title"] = "提出社群活動";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">提出社群活動</h2>
        <div class="text-secondary mt-1">送出後會先進入待審核狀態</div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-12 col-lg-8">
                <form asp-action="Create" method="post" class="card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="EventType" class="form-label">活動類型</label>
                            <input asp-for="EventType" class="form-control" />
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">活動標題</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label">活動內容</label>
                            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Location" class="form-label">活動地點</label>
                                <input asp-for="Location" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Capacity" class="form-label">活動名額</label>
                                <input asp-for="Capacity" class="form-control" min="1" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartAt" class="form-label">開始時間</label>
                                <input asp-for="StartAt" type="datetime-local" class="form-control" />
                                <span asp-validation-for="StartAt" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndAt" class="form-label">結束時間</label>
                                <input asp-for="EndAt" type="datetime-local" class="form-control" />
                                <span asp-validation-for="EndAt" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-0">
                            <label asp-for="RegistrationEndAt" class="form-label">報名截止時間</label>
                            <input asp-for="RegistrationEndAt" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-link">取消</a>
                        <button type="submit" class="btn btn-primary">送出審核</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
