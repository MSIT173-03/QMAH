@model QMAH.Web.Areas.Social.Models.ContentKeywordAdminPageViewModel

@{
    ViewData["Title"] = "內容審核設定";
    ViewData["AdminDescription"] = "管理違規關鍵字表（BLOCK 直接擋發文、FLAG 放行後自動送檢舉），以及洗版防治的 SimHash 比對設定。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">洗版防治（SimHash）設定</h2></div>
    <div class="card-body">
        <form method="post" asp-action="UpdateModerationSettings" asp-route-filterIsActive="@Model.IsActive" asp-route-filterKeyword="@Model.Keyword">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label asp-for="ModerationSettings.SimHashWindowDays" class="form-label">比對天數（1～90）</label>
                    <input asp-for="ModerationSettings.SimHashWindowDays" type="number" min="1" max="90" class="form-control" />
                    <span asp-validation-for="ModerationSettings.SimHashWindowDays" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="ModerationSettings.SimHashHammingThreshold" class="form-label">相似度門檻（0～64 bit）</label>
                    <input asp-for="ModerationSettings.SimHashHammingThreshold" type="number" min="0" max="64" class="form-control" />
                    <span asp-validation-for="ModerationSettings.SimHashHammingThreshold" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    @if (Model.ModerationSettings.UpdatedAt.HasValue)
                    {
                        <div class="text-secondary small mb-2">上次更新：@Model.ModerationSettings.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                    }
                    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存設定</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">新增關鍵字</h2></div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-route-isActive="@Model.IsActive" asp-route-keyword="@Model.Keyword">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label asp-for="NewKeyword.Keyword" class="form-label">關鍵字</label>
                    <input asp-for="NewKeyword.Keyword" class="form-control" placeholder="要偵測的字詞" />
                    <span asp-validation-for="NewKeyword.Keyword" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="NewKeyword.Action" class="form-label">動作</label>
                    <select asp-for="NewKeyword.Action" class="form-select">
                        <option value="FLAG">FLAG（放行後自動送檢舉）</option>
                        <option value="BLOCK">BLOCK（直接擋發文）</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="NewKeyword.Category" class="form-label">分類（選填）</label>
                    <input asp-for="NewKeyword.Category" class="form-control" placeholder="例如：廣告招攬" />
                </div>
                <div class="col-12 col-md-1">
                    <button type="submit" class="btn btn-primary w-100"><i class="ti ti-plus"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-filter-panel mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label" for="keyword">關鍵字搜尋</label>
                    <input class="form-control" id="keyword" name="keyword" value="@Model.Keyword" placeholder="搜尋關鍵字內容" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="isActive">狀態</label>
                    <select class="form-select" id="isActive" name="isActive">
                        <option value="">全部</option>
                        <option value="true" selected="@(Model.IsActive == true ? "selected" : null)">已啟用</option>
                        <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">已停用</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>套用</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th>關鍵字</th>
                    <th>動作</th>
                    <th>分類</th>
                    <th>狀態</th>
                    <th>建立時間</th>
                    <th class="qmah-action-cell qmah-actions--2">操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Keywords.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">找不到符合條件的關鍵字。</td></tr>
            }
            else
            {
                @foreach (var item in Model.Keywords)
                {
                    <tr>
                        <td class="fw-semibold">@item.Keyword</td>
                        <td><span class="badge @(item.Action == "BLOCK" ? "bg-red-lt" : "bg-yellow-lt")">@item.Action</span></td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(item.Category) ? "未分類" : item.Category)</td>
                        <td><span class="badge @(item.IsActive ? "bg-green-lt" : "bg-secondary-lt")">@(item.IsActive ? "已啟用" : "已停用")</span></td>
                        <td class="text-secondary text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="qmah-action-cell qmah-actions--2">
                            <div class="qmah-table-actions">
                                <form asp-action="ToggleActive" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                    <input type="hidden" name="filterIsActive" value="@Model.IsActive" />
                                    <input type="hidden" name="filterKeyword" value="@Model.Keyword" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">@(item.IsActive ? "停用" : "啟用")</button>
                                </form>
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="filterIsActive" value="@Model.IsActive" />
                                    <input type="hidden" name="filterKeyword" value="@Model.Keyword" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('確定要刪除關鍵字「@item.Keyword」嗎？刪除後無法復原。')">刪除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer qmah-card-footer">
        <span class="text-secondary">共 @Model.TotalCount 筆（最多顯示前 200 筆）</span>
    </div>
</div>
