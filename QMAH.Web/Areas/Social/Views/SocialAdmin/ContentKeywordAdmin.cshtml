@model QMAH.Web.Areas.Social.Models.ContentKeywordAdminPageViewModel

@{
    ViewData["Title"] = "內容審核設定";
    ViewData["AdminDescription"] = "管理違規關鍵字表（BLOCK 直接擋發文、FLAG 放行後自動送檢舉），以及洗版防治的 SimHash 比對設定。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">審查流程總覽</h2></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="fw-semibold mb-1">① 關鍵字（下方表格）</div>
                <div class="text-secondary small">直接阻擋：發文或留言當下擋下並提示作者。送交審核：先公開，同時自動送一筆檢舉。</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="fw-semibold mb-1">② 洗版規則（固定）</div>
                <div class="text-secondary small">同一個字連續出現 10 次以上，或 2～4 字的片段連續重複 5 次以上（例如 6767676767），發文與留言當下直接擋下。相似度重複發布則依下方 SimHash 設定送自動檢舉。</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="fw-semibold mb-1">③ AI 複審</div>
                <div class="text-secondary small">只複審疑似內容（例如大量驚嘆號、含網址）。命中送「系統偵測：AI 複審」檢舉；信心很高時會先隱藏，到檢舉管理核准＝維持隱藏、駁回＝還原。</div>
                <div class="text-secondary small mt-2">目前狀態與操作請見下方「AI 審查狀態」。</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="card-title mb-0">AI 審查狀態</h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="SocialReportAdmin" asp-action="Index" asp-route-source="AI" class="btn btn-sm btn-outline-secondary">查看 AI 判定違規的檢舉</a>
            <a href="#ai-review-log" class="btn btn-sm btn-outline-primary">查看審查紀錄</a>
        </div>
    </div>
    <div class="card-body">
        @{ var aiEnabled = (bool)ViewData["AiReviewEnabled"]!; }
        <div class="alert alert-@ViewData["AiStatusLevel"] py-2 px-3 mb-3" role="status">@ViewData["AiStatusText"]</div>
        <div class="row g-3 align-items-stretch">
            <div class="col-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-secondary small">待複審</div>
                    <div class="fs-2 fw-bold">@ViewData["AiPending"]</div>
                    <div class="text-secondary small">尚未經過 AI 判斷的內容</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-secondary small">近 24 小時審查</div>
                    <div class="fs-2 fw-bold">@ViewData["AiReviewed24h"]</div>
                    <div class="text-secondary small">含通過與違規</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-secondary small">近 24 小時判定違規</div>
                    <div class="fs-2 fw-bold">@ViewData["AiFlagged24h"]</div>
                    <div class="text-secondary small">已送出檢舉</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-secondary small">AI 檢舉待處理</div>
                    <div class="fs-2 fw-bold">@ViewData["AiReportsPending"]</div>
                    <div class="text-secondary small">共 @ViewData["AiReports"] 筆 AI 檢舉</div>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3 pt-3 border-top">
            <form method="post" asp-action="@(aiEnabled ? "DisableAiReview" : "EnableAiReview")" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(aiEnabled ? "btn-outline-danger" : "btn-primary")">@(aiEnabled ? "暫停 AI 審查" : "啟用 AI 審查")</button>
            </form>
            <span class="text-secondary small">目前：<strong>@(aiEnabled ? "開啟" : "暫停")</strong>。暫停時不會送出新內容審查，關鍵字與洗版規則照常運作；每次開關都會記錄在下方「AI 審核開關紀錄」。</span>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">AI 審核開關紀錄</h2></div>
    <div class="card-body">
        @{ var toggleLog = (IReadOnlyList<QMAH.Web.Areas.Social.Models.AiReviewToggleLogItem>)ViewData["AiToggleLog"]!; }
        @if (toggleLog.Count == 0)
        {
            <div class="text-secondary small">尚無開啟或暫停紀錄。</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr><th>時間</th><th>操作人</th><th>動作</th><th>結果</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in toggleLog)
                        {
                            <tr>
                                <td class="text-nowrap">@item.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(item.ActorName ?? "（未知）")</td>
                                <td>@(item.Enabled ? "啟用 AI 審查" : "暫停 AI 審查")</td>
                                <td>@(item.Succeeded ? "完成" : "未完成")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="text-secondary small mt-2">開關紀錄來自管理稽核紀錄（admin.AuditLogs），完整操作可到稽核紀錄頁查詢。</div>
    </div>
</div>

<div id="ai-review-log" class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">AI 審查紀錄</h2></div>
    <div class="card-body">
        <div class="small mb-2">近 24 小時審查 <strong>@ViewData["AiReviewed24h"]</strong> 筆，判定違規 <strong>@ViewData["AiFlagged24h"]</strong> 筆。</div>
        @{ var reviewLog = (IReadOnlyList<QMAH.Infrastructure.Models.Entities.AiReviewLog>)ViewData["AiReviewLog"]!; }
        @if (reviewLog.Count == 0)
        {
            <div class="text-secondary small">尚無審查紀錄。審查排程啟用後，每次判斷（含通過的）都會列在這裡。</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr><th>時間</th><th>對象</th><th>供應商</th><th>結果</th><th>分類</th><th>分數</th><th>處置</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in reviewLog)
                        {
                            <tr>
                                <td class="text-nowrap">@item.ReviewedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(item.TargetType switch { "POST" => "貼文", "COMMENT" => "留言", "MEDIA" => "圖片", _ => item.TargetType })</td>
                                <td>@item.Provider</td>
                                <td>@(item.Flagged ? "違規" : "通過")</td>
                                <td>@(item.Category ?? "—")</td>
                                <td>@(item.Score?.ToString("0.00") ?? "—")</td>
                                <td>@(item.AutoHidden ? "自動隱藏，已送檢舉" : item.Flagged ? "已送檢舉" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="text-secondary small mt-2">僅列出最近 20 筆；完整紀錄保存在資料庫 social.AiReviewLogs。</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">洗版防治（SimHash）設定</h2></div>
    <div class="card-body">
        <form method="post" asp-action="UpdateModerationSettings" asp-route-filterIsActive="@Model.IsActive" asp-route-filterKeyword="@Model.Keyword">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label asp-for="ModerationSettings.SimHashWindowDays" class="form-label">比對天數（1～90）</label>
                    <input asp-for="ModerationSettings.SimHashWindowDays" type="number" min="1" max="90" class="form-control" />
                    <span asp-validation-for="ModerationSettings.SimHashWindowDays" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="ModerationSettings.SimHashHammingThreshold" class="form-label">相似度門檻（0～64 bit）</label>
                    <input asp-for="ModerationSettings.SimHashHammingThreshold" type="number" min="0" max="64" class="form-control" />
                    <span asp-validation-for="ModerationSettings.SimHashHammingThreshold" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    @if (Model.ModerationSettings.UpdatedAt.HasValue)
                    {
                        <div class="text-secondary small mb-2">上次更新：@Model.ModerationSettings.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                    }
                    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存設定</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h2 class="card-title mb-0">新增關鍵字</h2></div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-route-isActive="@Model.IsActive" asp-route-keyword="@Model.Keyword">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label asp-for="NewKeyword.Keyword" class="form-label">關鍵字</label>
                    <input asp-for="NewKeyword.Keyword" class="form-control" placeholder="要偵測的字詞" />
                    <span asp-validation-for="NewKeyword.Keyword" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="NewKeyword.Action" class="form-label">動作</label>
                    <select asp-for="NewKeyword.Action" class="form-select">
                        <option value="FLAG">FLAG（放行後自動送檢舉）</option>
                        <option value="BLOCK">BLOCK（直接擋發文）</option>
                    </select>
                    <span asp-validation-for="NewKeyword.Action" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="NewKeyword.Category" class="form-label">分類（選填）</label>
                    <input asp-for="NewKeyword.Category" class="form-control" placeholder="例如：廣告招攬" />
                </div>
                <div class="col-12 col-md-1">
                    <button type="submit" class="btn btn-primary w-100" aria-label="新增關鍵字"><i class="ti ti-plus" aria-hidden="true"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title mb-1">關鍵字篩選</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 text-secondary">
                <span>依內容與啟用狀態查找審核規則。</span>
                <span class="badge bg-blue-lt">符合 @Model.TotalCount 筆</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label" for="keyword">關鍵字搜尋</label>
                    <input class="form-control" id="keyword" name="keyword" value="@Model.Keyword" placeholder="搜尋關鍵字內容" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="isActive">狀態</label>
                    <select class="form-select" id="isActive" name="isActive">
                        <option value="">全部</option>
                        <option value="true" selected="@(Model.IsActive == true ? "selected" : null)">已啟用</option>
                        <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">已停用</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>套用</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th>關鍵字</th>
                    <th>動作</th>
                    <th>分類</th>
                    <th>狀態</th>
                    <th>建立時間</th>
                    <th class="qmah-action-cell qmah-actions--2">操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Keywords.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">找不到符合條件的關鍵字。</td></tr>
            }
            else
            {
                @foreach (var item in Model.Keywords)
                {
                    <tr>
                        <td class="fw-semibold">@item.Keyword</td>
                        <td><span class="badge @(item.Action == "BLOCK" ? "bg-red-lt" : "bg-yellow-lt")">@(item.Action == "BLOCK" ? "直接阻擋" : "送交審核")</span></td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(item.Category) ? "未分類" : item.Category)</td>
                        <td><span class="badge @(item.IsActive ? "bg-green-lt" : "bg-secondary-lt")">@(item.IsActive ? "已啟用" : "已停用")</span></td>
                        <td class="text-secondary text-nowrap">@QMAH.Infrastructure.Services.Social.EventScheduleRules.ToTaipei(item.CreatedAt).ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="qmah-action-cell qmah-actions--2">
                            <div class="qmah-table-actions">
                                <form asp-action="ToggleActive" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                    <input type="hidden" name="filterIsActive" value="@Model.IsActive" />
                                    <input type="hidden" name="filterKeyword" value="@Model.Keyword" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">@(item.IsActive ? "停用" : "啟用")</button>
                                </form>
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="filterIsActive" value="@Model.IsActive" />
                                    <input type="hidden" name="filterKeyword" value="@Model.Keyword" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('確定要刪除這筆關鍵字嗎？刪除後無法復原。')">刪除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer qmah-card-footer">
        <span class="text-secondary">共 @Model.TotalCount 筆（最多顯示前 200 筆）</span>
    </div>
</div>
