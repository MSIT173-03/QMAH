@model QMAH.Web.Areas.Social.Models.EventEditViewModel

@{
    var isCreate = ViewData["IsCreate"] is true;
    var eventId = ViewData["EventId"];
    ViewData["Title"] = isCreate ? "新增活動" : "編輯活動";
    ViewData["AdminDescription"] = isCreate
        ? "建立活動後會先進入待審核狀態。"
        : "修改活動內容後會重新回到待審核與草稿狀態。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回活動管理</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card">
            <div class="card-header"><h2 class="card-title">@(isCreate ? "活動資料" : "編輯活動資料")</h2></div>
            <div class="card-body">
                <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@(isCreate ? null : eventId)" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="OFFICIAL">官方活動</option>
                                <option value="PLAYER">玩家活動</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Capacity" class="form-label"></label>
                            <input asp-for="Capacity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="StartAt" class="form-label"></label>
                            <input asp-for="StartAt" class="form-control" type="datetime-local" />
                            <span asp-validation-for="StartAt" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="EndAt" class="form-label"></label>
                            <input asp-for="EndAt" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EndAt" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="RegistrationEndAt" class="form-label"></label>
                            <input asp-for="RegistrationEndAt" class="form-control" type="datetime-local" />
                            <span asp-validation-for="RegistrationEndAt" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ReviewNote" class="form-label"></label>
                            <textarea asp-for="ReviewNote" class="form-control" rows="3" placeholder="可記錄審核或後台處理備註"></textarea>
                            <span asp-validation-for="ReviewNote" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>@(isCreate ? "建立活動" : "儲存並重新送審")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
