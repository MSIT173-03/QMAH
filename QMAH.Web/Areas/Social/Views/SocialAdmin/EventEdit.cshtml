@model QMAH.Web.Areas.Social.Models.EventEditViewModel

@{
    var isCreate = ViewData["IsCreate"] is true;
    var eventId = ViewData["EventId"];
    ViewData["Title"] = isCreate ? "新增活動" : "編輯活動";
    ViewData["AdminDescription"] = isCreate
        ? "建立活動後會先進入待審核狀態。"
        : "修改活動內容後會重新回到待審核與草稿狀態。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回活動管理</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card qmah-form-card">
            <div class="card-header"><h2 class="card-title">@(isCreate ? "活動資料" : "編輯活動資料")</h2></div>
            <div class="card-body">
                <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@(isCreate ? null : eventId)" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="OFFICIAL">官方活動</option>
                                <option value="PLAYER">玩家活動</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="可手動輸入地址或場館名稱" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="Latitude" class="form-label"></label>
                            <input asp-for="Latitude" class="form-control" type="number" step="0.000001" placeholder="例如 25.0330" />
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="Longitude" class="form-label"></label>
                            <input asp-for="Longitude" class="form-control" type="number" step="0.000001" placeholder="例如 121.5654" />
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div class="form-hint">地址可以只用文字輸入；若有座標，地圖會直接定位到這個位置。</div>
                                <a class="btn btn-sm btn-outline-secondary"
                                   data-qmah-map-link
                                   data-qmah-map-location-input="#Location"
                                   data-qmah-map-latitude-input="#Latitude"
                                   data-qmah-map-longitude-input="#Longitude"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   hidden>
                                    <i class="ti ti-map-pin me-1" aria-hidden="true"></i>在地圖查看位置
                                </a>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Capacity" class="form-label"></label>
                            <input asp-for="Capacity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="StartAt" class="form-label"></label>
                            <input asp-for="StartAt" class="form-control" type="datetime-local" />
                            <span asp-validation-for="StartAt" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="EndAt" class="form-label"></label>
                            <input asp-for="EndAt" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EndAt" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="RegistrationEndAt" class="form-label"></label>
                            <input asp-for="RegistrationEndAt" class="form-control" type="datetime-local" />
                            <span asp-validation-for="RegistrationEndAt" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ReviewNote" class="form-label"></label>
                            <textarea asp-for="ReviewNote" class="form-control" rows="3" placeholder="可記錄審核或後台處理備註"></textarea>
                            <span asp-validation-for="ReviewNote" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="border rounded p-3">
                                <h3 class="h4 mb-1">社群活動貼文</h3>
                                <p class="text-secondary mb-3">建立活動時會同步建立一篇活動貼文；活動核准發布後，貼文才會對一般使用者公開。</p>
                                <div class="mb-3">
                                    <label asp-for="PostContentMode" class="form-label"></label>
                                    <select asp-for="PostContentMode" class="form-select" data-post-content-mode>
                                        <option value="TEMPLATE">套用活動資訊模板</option>
                                        <option value="CUSTOM">自訂活動貼文內容</option>
                                    </select>
                                    <div class="form-hint">模板會自動帶入活動說明、時間、地點與人數上限；自訂模式仍會保留活動欄位供報名使用。</div>
                                    <span asp-validation-for="PostContentMode" class="text-danger"></span>
                                </div>
                                <div data-post-custom-fields>
                                    <div class="mb-3">
                                        <label asp-for="PostTitle" class="form-label"></label>
                                        <input asp-for="PostTitle" class="form-control" placeholder="留白時沿用活動標題" />
                                        <span asp-validation-for="PostTitle" class="text-danger"></span>
                                    </div>
                                    <div>
                                        <label asp-for="PostContent" class="form-label"></label>
                                        <textarea asp-for="PostContent" class="form-control" rows="6" placeholder="請輸入要顯示在社群活動貼文中的內容"></textarea>
                                        <span asp-validation-for="PostContent" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>@(isCreate ? "建立活動" : "儲存並重新送審")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const mode = document.querySelector('[data-post-content-mode]');
            const fields = document.querySelector('[data-post-custom-fields]');
            if (!mode || !fields) return;
            const refresh = () => {
                fields.hidden = mode.value !== 'CUSTOM';
            };
            mode.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}
