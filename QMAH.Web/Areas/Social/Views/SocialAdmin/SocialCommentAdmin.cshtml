@model QMAH.Web.Areas.Social.Models.CommentAdminPageViewModel

@{
    ViewData["Title"] = "留言管理";
    ViewData["AdminDescription"] = "依貼文、狀態、關鍵字與日期查找留言，並可隱藏、還原或下架違規留言。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var resultStart = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var resultEnd = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

@section PageActions {
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title mb-1">留言篩選</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 text-secondary">
                <span>依貼文 ID、狀態、內文關鍵字與建立日期查找留言。</span>
                <span class="badge bg-blue-lt">符合 @Model.TotalCount 筆</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end qmah-post-filter-row">
                <div class="col-12 col-lg-4 qmah-filter-field qmah-filter-field--keyword">
                    <label asp-for="Keyword" class="form-label">關鍵字</label>
                    <input asp-for="Keyword" class="form-control" placeholder="搜尋留言內容" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="PostId" class="form-label">貼文 ID</label>
                    <input asp-for="PostId" class="form-control" placeholder="篩選單一貼文" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="Status" class="form-label">狀態</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">全部狀態</option>
                        <option value="PUBLISHED">已發布</option>
                        <option value="HIDDEN">已隱藏</option>
                        <option value="DELETED">已刪除</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="PageSize" class="form-label">每頁筆數</label>
                    <select asp-for="PageSize" class="form-select">
                        @foreach (var size in new[] { 10, 20, 50, 100 })
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="From" class="form-label">建立日起</label>
                    <input asp-for="From" type="date" class="form-control" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="To" class="form-label">建立日迄</label>
                    <input asp-for="To" type="date" class="form-control" />
                </div>
                <div class="col-12 d-flex gap-2 qmah-post-filter-actions">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>套用篩選</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-refresh me-1"></i>清除條件</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th>所屬貼文</th>
                    <th>留言內容</th>
                    <th>作者</th>
                    <th>狀態</th>
                    <th>建立時間</th>
                    <th class="qmah-action-cell qmah-actions--2">操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Comments.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">找不到符合條件的留言。</td></tr>
            }
            else
            {
                @foreach (var item in Model.Comments)
                {
                    var statusClass = item.Status switch
                    {
                        "PUBLISHED" => "bg-green-lt",
                        "HIDDEN" => "bg-yellow-lt",
                        "DELETED" => "bg-red-lt",
                        _ => "bg-secondary-lt"
                    };
                    var nextStatus = item.Status == "PUBLISHED" ? "HIDDEN" : "PUBLISHED";
                    var nextStatusLabel = item.Status == "PUBLISHED" ? "隱藏" : "恢復";
                    var nextStatusClass = item.Status == "PUBLISHED" ? "btn-outline-warning" : "btn-outline-success";
                    <tr>
                        <td>
                            <a asp-area="Social" asp-controller="SocialPostAdmin" asp-action="Edit" asp-route-id="@item.PostId" class="fw-semibold">@item.PostTitle</a>
                            @if (item.ParentCommentId.HasValue)
                            {
                                <div class="small text-secondary mt-1">回覆留言</div>
                            }
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-link p-0 text-start"
                                    data-bs-toggle="modal"
                                    data-bs-target="#qmah-content-detail"
                                    data-qmah-content-detail
                                    data-qmah-content-detail-title="@item.PostTitle 的留言"
                                    data-qmah-content-detail-subtitle="@($"作者：{item.AuthorName} ・ {item.CreatedAt:yyyy-MM-dd HH:mm}")"
                                    data-qmah-content-detail-body="@item.Content">
                                @(item.Content.Length > 60 ? item.Content[..60] + "…" : item.Content)
                            </button>
                        </td>
                        <td class="text-secondary">@item.AuthorName</td>
                        <td><span class="badge @statusClass">@AdminDisplayLabels.Status(item.Status)</span></td>
                        <td class="text-secondary text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="qmah-action-cell qmah-actions--2">
                            <div class="qmah-table-actions">
                                <form asp-action="SetCommentStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@nextStatus" /><button type="submit" class="btn btn-sm @nextStatusClass">@nextStatusLabel</button></form>
                                @if (item.Status != "DELETED")
                                {
                                    <form asp-action="SetCommentStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="DELETED" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('確定要刪除這則留言嗎？')">刪除</button></form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="card-footer qmah-card-footer qmah-card-footer--split">
        <span class="text-secondary">顯示第 @resultStart–@resultEnd 筆，共 @Model.TotalCount 筆</span>
        <nav aria-label="留言分頁">
            <ul class="pagination m-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                    @if (Model.Page <= 1)
                    {
                        <span class="page-link">上一頁</span>
                    }
                    else
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-postId="@Model.PostId"
                           asp-route-status="@Model.Status"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">上一頁</a>
                    }
                </li>
                <li class="page-item disabled"><span class="page-link">第 @Model.Page / @Model.TotalPages 頁</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                    @if (Model.Page >= Model.TotalPages)
                    {
                        <span class="page-link">下一頁</span>
                    }
                    else
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-postId="@Model.PostId"
                           asp-route-status="@Model.Status"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">下一頁</a>
                    }
                </li>
            </ul>
        </nav>
    </div>
</div>

<partial name="Admin/_ContentDetailModal" />
