@model QMAH.Web.Areas.Social.Models.SocialPostAdminPageViewModel

@{
    ViewData["Title"] = "貼文內容處理";
    ViewData["AdminDescription"] = "依貼文類型、專案分類、狀態、關鍵字與日期處理社群內容。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var resultStart = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var resultEnd = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增貼文</a>
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title mb-1">貼文篩選</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 text-secondary">
                <span>公告與一般內容共用同一套貼文管理，活動貼文則由活動管理維護。</span>
                <span class="badge bg-blue-lt">符合 @Model.TotalCount 筆</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end qmah-post-filter-row">
                <div class="col-12 col-lg-4 qmah-filter-field qmah-filter-field--keyword">
                    <label asp-for="Keyword" class="form-label">關鍵字</label>
                    <input asp-for="Keyword" class="form-control" placeholder="搜尋標題或內文" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="PostType" class="form-label">貼文類型</label>
                    <select asp-for="PostType" class="form-select">
                        <option value="">全部類型</option>
                        @foreach (var postType in Model.PostTypes)
                        {
                            <option value="@postType">@AdminDisplayLabels.PostType(postType)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="BoardCode" class="form-label">貼文分類</label>
                    <select asp-for="BoardCode" class="form-select">
                        <option value="">全部分類</option>
                        @foreach (var boardCode in Model.BoardCodes)
                        {
                            <option value="@boardCode">@AdminDisplayLabels.Board(boardCode)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="Status" class="form-label">狀態</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">全部狀態</option>
                        <option value="PUBLISHED">已發布</option>
                        <option value="HIDDEN">已隱藏</option>
                        <option value="DELETED">已下架</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="PageSize" class="form-label">每頁筆數</label>
                    <select asp-for="PageSize" class="form-select">
                        @foreach (var size in new[] { 10, 20, 50, 100 })
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="From" class="form-label">建立日起</label>
                    <input asp-for="From" type="date" class="form-control" />
                </div>
                <div class="col-12 col-sm-6 col-lg-2 qmah-filter-field">
                    <label asp-for="To" class="form-label">建立日迄</label>
                    <input asp-for="To" type="date" class="form-control" />
                </div>
                <div class="col-12 d-flex gap-2 qmah-post-filter-actions">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>套用篩選</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-refresh me-1"></i>清除條件</a>
                </div>
            </div>
        </form>
    </div>

</div>

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th>類型</th>
                    <th>分類</th>
                    <th>標題</th>
                    <th>作者</th>
                    <th>地點</th>
                    <th>留言</th>
                    <th>狀態</th>
                    <th>建立時間</th>
                    <th class="qmah-action-cell qmah-actions--3">操作</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Posts.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-secondary py-5">找不到符合條件的貼文。</td></tr>
            }
            else
            {
                @foreach (var item in Model.Posts)
                {
                    var statusClass = item.Status switch
                    {
                        "PUBLISHED" => "bg-green-lt",
                        "HIDDEN" => "bg-yellow-lt",
                        "DELETED" => "bg-red-lt",
                        _ => "bg-secondary-lt"
                    };
                    var isEventPost = item.EventId.HasValue;
                    var nextStatus = item.Status == "PUBLISHED" ? "HIDDEN" : "PUBLISHED";
                    var nextStatusLabel = item.Status == "PUBLISHED" ? "隱藏" : "恢復";
                    var nextStatusClass = item.Status == "PUBLISHED" ? "btn-outline-warning" : "btn-outline-success";
                    <tr>
                        <td>
                            <span class="badge @(item.PostType == "ANNOUNCEMENT" ? "bg-purple-lt" : isEventPost ? "bg-orange-lt" : "bg-blue-lt")">
                                @AdminDisplayLabels.PostType(item.PostType)
                            </span>
                            <div class="small text-secondary mt-1">@AdminDisplayLabels.PublisherType(item.PublisherType)</div>
                        </td>
                        <td><span class="badge bg-secondary-lt">@AdminDisplayLabels.Board(item.BoardCode)</span></td>
                        <td class="fw-semibold">
                            @item.Title
                            @if (isEventPost)
                            {
                                <div class="small text-secondary mt-1">由活動資料同步</div>
                            }
                        </td>
                        <td class="text-secondary">@item.AuthorName</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(item.LocationName))
                            {
                                <span class="text-secondary">未設定地點</span>
                            }
                            else
                            {
                                <div class="qmah-location-cell__name">@item.LocationName</div>
                            }
                            <a class="btn btn-sm btn-outline-secondary mt-1"
                               data-qmah-map-link
                               data-qmah-map-location="@item.LocationName"
                               data-qmah-map-latitude="@item.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               data-qmah-map-longitude="@item.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               target="_blank"
                               rel="noopener noreferrer"
                               hidden>
                                <i class="ti ti-map-pin me-1" aria-hidden="true"></i>查看地圖
                            </a>
                        </td>
                        <td>@item.CommentCount</td>
                        <td><span class="badge @statusClass">@AdminDisplayLabels.Status(item.Status)</span></td>
                        <td class="text-secondary text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="qmah-action-cell qmah-actions--3">
                            <div class="qmah-table-actions">
                                @if (isEventPost)
                                {
                                    <a asp-area="Social" asp-controller="SocialEventAdmin" asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-secondary">編輯活動</a>
                                    <span class="text-secondary small">狀態隨活動</span>
                                }
                                else
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
                                    <form asp-action="SetPostStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@nextStatus" /><button type="submit" class="btn btn-sm @nextStatusClass">@nextStatusLabel</button></form>
                                    @if (item.Status != "DELETED")
                                    {
                                        <form asp-action="SetPostStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="DELETED" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('確定要將這篇貼文下架嗎？')">下架</button></form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="card-footer qmah-card-footer qmah-card-footer--split">
        <span class="text-secondary">顯示第 @resultStart–@resultEnd 筆，共 @Model.TotalCount 筆</span>
        <nav aria-label="貼文分頁">
            <ul class="pagination m-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                    @if (Model.Page <= 1)
                    {
                        <span class="page-link">上一頁</span>
                    }
                    else
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-boardCode="@Model.BoardCode"
                           asp-route-postType="@Model.PostType"
                           asp-route-status="@Model.Status"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">上一頁</a>
                    }
                </li>
                <li class="page-item disabled"><span class="page-link">第 @Model.Page / @Model.TotalPages 頁</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                    @if (Model.Page >= Model.TotalPages)
                    {
                        <span class="page-link">下一頁</span>
                    }
                    else
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-boardCode="@Model.BoardCode"
                           asp-route-postType="@Model.PostType"
                           asp-route-status="@Model.Status"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">下一頁</a>
                    }
                </li>
            </ul>
        </nav>
    </div>
</div>
