@model IEnumerable<QMAH.Web.Areas.Social.Models.AdminPostListViewModel>

@{
    ViewData["Title"] = "社群貼文管理";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">社群貼文管理</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
                <i class="ti ti-check me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
                <i class="ti ti-alert-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>看板</th>
                            <th>標題</th>
                            <th>狀態</th>
                            <th>建立時間</th>
                            <th class="w-1">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-lt">@item.BoardCode</span></td>
                                <td>@item.Title</td>
                                <td>@item.Status</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <form asp-action="TogglePostStatus" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <!-- 當狀態為 HIDDEN 時切換回 PUBLISHED，否則切換為 HIDDEN -->
                                        <input type="hidden" name="status" value="@(item.Status == "HIDDEN" ? "PUBLISHED" : "HIDDEN")" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            @(item.Status == "HIDDEN" ? "顯示" : "隱藏")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
