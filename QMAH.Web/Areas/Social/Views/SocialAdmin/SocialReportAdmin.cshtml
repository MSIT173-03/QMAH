@model QMAH.Web.Areas.Social.Models.ReportAdminPageViewModel

@{
    ViewData["Title"] = "檢舉管理";
    ViewData["AdminDescription"] = "管理檢舉紀錄、查看被檢舉內容，並進行核准下架、駁回或重新開啟審核。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var resultStart = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var resultEnd = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增檢舉紀錄</a>
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header"><div><h2 class="card-title mb-1">檢舉篩選</h2><div class="d-flex flex-wrap align-items-center gap-2 text-secondary"><span>依處理狀態、目標類型、檢舉來源與理由文字查找紀錄。</span><span class="badge bg-blue-lt">符合 @Model.TotalCount 筆</span></div></div></div>
    <div class="card-body"><form method="get" asp-action="Index"><div class="row g-3 align-items-end qmah-post-filter-row">
        <div class="col-12 col-md-3"><label class="form-label" for="status">處理狀態</label><select class="form-select" id="status" name="status"><option value="">全部狀態</option><option value="PENDING" selected="@(Model.Status == "PENDING" ? "selected" : null)">待審核</option><option value="RESOLVED" selected="@(Model.Status == "RESOLVED" ? "selected" : null)">已處理</option><option value="REJECTED" selected="@(Model.Status == "REJECTED" ? "selected" : null)">已駁回</option></select></div>
        <div class="col-12 col-md-3"><label class="form-label" for="targetType">目標類型</label><select class="form-select" id="targetType" name="targetType"><option value="">全部類型</option><option value="POST" selected="@(Model.TargetType == "POST" ? "selected" : null)">貼文</option><option value="COMMENT" selected="@(Model.TargetType == "COMMENT" ? "selected" : null)">留言</option></select></div>
        <div class="col-12 col-md-3"><label class="form-label" for="isAutoGenerated">檢舉來源</label><select class="form-select" id="isAutoGenerated" name="isAutoGenerated"><option value="">全部來源</option><option value="true" selected="@(Model.IsAutoGenerated == true ? "selected" : null)">僅系統自動</option><option value="false" selected="@(Model.IsAutoGenerated == false ? "selected" : null)">僅真人檢舉</option></select></div>
        <div class="col-12 col-md-3"><label class="form-label" for="keyword">關鍵字</label><input class="form-control" id="keyword" name="keyword" value="@Model.Keyword" placeholder="檢舉理由或處理結果" /></div>
        <div class="col-12 col-sm-6 col-md-2"><label class="form-label" for="pageSize">每頁筆數</label><select class="form-select" id="pageSize" name="pageSize">@foreach (var size in new[] { 10, 20, 50, 100 }) { <option value="@size" selected="@(Model.PageSize == size)">@size</option> }</select></div>
        <div class="col-12 col-sm-6 col-md-2"><div class="qmah-actions"><button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>套用</button><a asp-action="Index" class="btn btn-outline-secondary">清除</a></div></div>
    </div></form></div>
</div>

<!-- 批次審核用的空殼表單：勾選框與工具列按鈕都不巢狀在這個 form 內，改用 form="qmah-report-bulk-form" 屬性關聯送出。 -->
<form asp-action="BulkReview" method="post" id="qmah-report-bulk-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="filterStatus" value="@Model.Status" />
    <input type="hidden" name="filterTargetType" value="@Model.TargetType" />
    <input type="hidden" name="filterIsAutoGenerated" value="@Model.IsAutoGenerated" />
    <input type="hidden" name="filterKeyword" value="@Model.Keyword" />
    <input type="hidden" name="filterPage" value="@Model.Page" />
    <input type="hidden" name="filterPageSize" value="@Model.PageSize" />
</form>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3" data-qmah-bulk-toolbar>
    <span class="text-secondary small" data-qmah-bulk-count>尚未勾選任何檢舉</span>
    <button type="submit" form="qmah-report-bulk-form" name="action" value="REJECT" class="btn btn-sm btn-outline-warning" data-qmah-bulk-submit disabled onclick="return confirm('確定要批次駁回勾選的檢舉嗎？')">
        <i class="ti ti-x me-1"></i>批次駁回
    </button>
    <button type="submit" form="qmah-report-bulk-form" name="action" value="HIDE" class="btn btn-sm btn-outline-success" data-qmah-bulk-submit disabled onclick="return confirm('確定要批次核准並隱藏勾選的檢舉內容嗎？')">
        <i class="ti ti-eye-off me-1"></i>批次隱藏
    </button>
    <button type="submit" form="qmah-report-bulk-form" name="action" value="DELETE" class="btn btn-sm btn-outline-danger" data-qmah-bulk-submit disabled onclick="return confirm('確定要批次刪除勾選的檢舉紀錄嗎？刪除後無法復原。')">
        <i class="ti ti-trash me-1"></i>批次刪除
    </button>
</div>

<div class="card qmah-list-card"><div class="table-responsive"><table class="table table-vcenter table-hover card-table qmah-crud-table">
    <thead><tr>
        <th style="width: 2.5rem;"><input type="checkbox" class="form-check-input" aria-label="全選本頁檢舉" data-qmah-select-all /></th>
        <th>目標</th><th>檢舉人／理由</th><th>狀態</th><th>建立時間</th><th class="qmah-action-cell qmah-actions--4">操作</th>
    </tr></thead>
    <tbody>
    @if (Model.Reports.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">目前沒有符合條件的檢舉紀錄。</td></tr> }
    else
    {
        @foreach (var item in Model.Reports)
        {
            var statusClass = item.Status switch { "RESOLVED" => "bg-green-lt", "REJECTED" => "bg-secondary-lt", _ => "bg-yellow-lt" };
            <tr>
                <td>
                    <input type="checkbox" class="form-check-input" name="ids" value="@item.Id" form="qmah-report-bulk-form" aria-label="勾選這筆檢舉" data-qmah-row-select />
                </td>
                <td>
                    <span class="badge bg-blue-lt">@AdminDisplayLabels.TargetType(item.TargetType)</span>
                    @if (item.IsAutoGenerated)
                    {
                        <span class="badge bg-purple-lt ms-1">系統自動</span>
                    }
                    <div class="fw-semibold mt-1">@item.TargetTitle</div>
                    <button type="button"
                            class="btn btn-sm btn-link p-0 mt-1"
                            data-bs-toggle="modal"
                            data-bs-target="#qmah-content-detail"
                            data-qmah-content-detail
                            data-qmah-content-detail-title="@(AdminDisplayLabels.TargetType(item.TargetType) + "：" + item.TargetTitle)"
                            data-qmah-content-detail-subtitle="@($"檢舉人：{item.ReporterName} ・ 理由：{AdminDisplayLabels.ReportReason(item.Reason)} ・ {item.CreatedAt:yyyy-MM-dd HH:mm}")"
                            data-qmah-content-detail-body="@item.TargetContent"
                            data-qmah-content-detail-extra="@(string.IsNullOrWhiteSpace(item.Detail) ? null : $"檢舉說明：{item.Detail}")">
                        查看內容
                    </button>
                </td>
                <td><div class="text-secondary small">@item.ReporterName</div><div class="fw-semibold">@AdminDisplayLabels.ReportReason(item.Reason)</div>@if (!string.IsNullOrWhiteSpace(item.Detail)) { <div class="text-secondary small">@item.Detail</div> } @if (!string.IsNullOrWhiteSpace(item.Resolution)) { <div class="text-secondary small">處理：@item.Resolution</div> }</td>
                <td><span class="badge @statusClass">@AdminDisplayLabels.Status(item.Status)</span></td>
                <td class="text-secondary text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="qmah-action-cell qmah-actions--4">
                    <div class="qmah-table-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm">編輯</a>
                        <form asp-action="ReviewReport" method="post">@Html.AntiForgeryToken()<input type="hidden" name="reportId" value="@item.Id" /><input type="hidden" name="status" value="@(item.Status == "PENDING" ? "RESOLVED" : "PENDING")" />@if (item.Status == "PENDING") { <button type="submit" class="btn btn-sm">核准</button> } else { <button type="submit" class="btn btn-sm btn-outline-warning">重審</button> }</form>
                        <form asp-action="ReviewReport" method="post">@Html.AntiForgeryToken()<input type="hidden" name="reportId" value="@item.Id" /><input type="hidden" name="status" value="REJECTED" />@if (item.Status == "PENDING") { <button type="submit" class="btn btn-sm btn-outline-warning">駁回</button> } else { <button type="button" class="btn btn-sm btn-outline-warning" disabled>駁回</button> }</form>
                        <form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('確定要刪除這筆檢舉紀錄嗎？')">刪除</button></form>
                    </div>
                </td>
            </tr>
        }
    }
    </tbody>
</table></div>
    <div class="card-footer qmah-card-footer qmah-card-footer--split">
        <span class="text-secondary">顯示第 @resultStart–@resultEnd 筆，共 @Model.TotalCount 筆</span>
        <nav aria-label="檢舉紀錄分頁">
            <ul class="pagination m-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                    @if (Model.Page <= 1)
                    {
                        <span class="page-link">上一頁</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.Status" asp-route-targetType="@Model.TargetType" asp-route-isAutoGenerated="@Model.IsAutoGenerated" asp-route-keyword="@Model.Keyword">上一頁</a>
                    }
                </li>
                <li class="page-item disabled"><span class="page-link">第 @Model.Page / @Model.TotalPages 頁</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                    @if (Model.Page >= Model.TotalPages)
                    {
                        <span class="page-link">下一頁</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.Status" asp-route-targetType="@Model.TargetType" asp-route-isAutoGenerated="@Model.IsAutoGenerated" asp-route-keyword="@Model.Keyword">下一頁</a>
                    }
                </li>
            </ul>
        </nav>
    </div>
</div>

<partial name="Admin/_ContentDetailModal" />

@section Scripts {
    <script>
        (() => {
            "use strict";

            const toolbar = document.querySelector("[data-qmah-bulk-toolbar]");
            const selectAll = document.querySelector("[data-qmah-select-all]");
            const rowCheckboxes = () => Array.from(document.querySelectorAll("[data-qmah-row-select]"));
            const countLabel = document.querySelector("[data-qmah-bulk-count]");
            const submitButtons = () => Array.from(document.querySelectorAll("[data-qmah-bulk-submit]"));
            if (!toolbar || !selectAll) return;

            function syncToolbar() {
                const checked = rowCheckboxes().filter((box) => box.checked);
                const all = rowCheckboxes();

                submitButtons().forEach((button) => { button.disabled = checked.length === 0; });
                countLabel.textContent = checked.length === 0
                    ? "尚未勾選任何檢舉"
                    : `已勾選 ${checked.length} 筆`;

                selectAll.checked = all.length > 0 && checked.length === all.length;
                selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
            }

            selectAll.addEventListener("change", () => {
                rowCheckboxes().forEach((box) => { box.checked = selectAll.checked; });
                syncToolbar();
            });

            document.addEventListener("change", (event) => {
                if (event.target.matches("[data-qmah-row-select]")) {
                    syncToolbar();
                }
            });

            syncToolbar();
        })();
    </script>
}
