@model IEnumerable<QMAH.Web.Areas.Social.Models.AnnouncementListViewModel>
@{
    ViewData["Title"] = "官方公告管理";
    ViewData["AdminDescription"] = "管理系統發布的重要公告、活動預告與更新維護通知。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-action="CreateAnnouncement" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增公告</a>
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card qmah-list-card">
    <div class="card-header"><div><h2 class="card-title">公告清單</h2><div class="text-secondary">發布狀態直接從操作欄切換，避免另外占用一個只放開關的欄位。</div></div></div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead><tr><th>分類</th><th>標題／摘要</th><th>發布者</th><th>發布時間</th><th>狀態</th><th class="qmah-action-cell qmah-actions--2">操作</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">目前尚無公告資料</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var published = item.Status == "PUBLISHED";
                    <tr>
                        <td><span class="badge bg-blue-lt">@item.Category</span></td>
                        <td><div class="fw-semibold">@item.Title</div><div class="text-secondary small text-truncate" style="max-width: 28rem;">@(string.IsNullOrEmpty(item.Summary) ? "無摘要" : item.Summary)</div></td>
                        <td>@item.CreatedByUserName</td>
                        <td class="text-secondary text-nowrap">@(item.PublishAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td><span class="badge @(published ? "bg-green-lt" : "bg-secondary-lt")">@(published ? "已發布" : "草稿")</span></td>
                        <td class="qmah-action-cell qmah-actions--2">
                            <div class="qmah-table-actions">
                                <a asp-action="EditAnnouncement" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
                                <button type="button"
                                        class="btn btn-sm @(published ? "btn-warning" : "btn-success")"
                                        onclick="toggleStatus('@item.Id', @(!published ? "true" : "false"))">
                                    @(published ? "轉草稿" : "發布")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function toggleStatus(id, isPublished) {
        fetch('@Url.Action("ToggleAnnouncementStatus", "SocialAdmin", new { area = "Social" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}&isPublished=${isPublished}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) location.reload();
            else alert(data.message || '操作失敗');
        })
        .catch(() => alert('操作失敗，請稍後再試。'));
    }
</script>
}
