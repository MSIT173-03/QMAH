@model QMAH.Web.Areas.Social.Models.PostCreateViewModel

@{
    var isCreate = ViewData["IsCreate"] is true;
    ViewData["Title"] = isCreate ? "新增社群貼文" : "編輯社群貼文";
    ViewData["AdminDescription"] = isCreate
        ? "先選擇板塊，再由管理者建立貼文。"
        : "修正板塊、標題、內容或關聯文物，保留原作者與建立時間。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var postId = ViewData["PostId"];
    var boardCodes = ViewData["BoardCodes"] as IReadOnlyList<string> ?? ["GENERAL"];
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回貼文處理
    </a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">@(isCreate ? "新增貼文" : "貼文內容")</h2>
            </div>
            <div class="card-body">
                <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@(isCreate ? null : postId)" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="BoardCode" class="form-label"></label>
                        <select asp-for="BoardCode" class="form-select">
                            @foreach (var boardCode in boardCodes)
                            {
                                <option value="@boardCode">@boardCode</option>
                            }
                        </select>
                        <span asp-validation-for="BoardCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ArtifactId" class="form-label"></label>
                        <input asp-for="ArtifactId" class="form-control" />
                        <span asp-validation-for="ArtifactId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>@(isCreate ? "新增貼文" : "儲存修改")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
