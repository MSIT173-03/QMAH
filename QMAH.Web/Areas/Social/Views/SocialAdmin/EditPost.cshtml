@model QMAH.Web.Areas.Social.Models.PostCreateViewModel

@{
    ViewData["Title"] = "編輯社群貼文";
    ViewData["AdminDescription"] = "修正板塊、標題、內容或關聯文物，保留原作者與建立時間。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var postId = ViewData["PostId"];
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回貼文處理
    </a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">貼文內容</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@postId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="BoardCode" class="form-label"></label>
                        <input asp-for="BoardCode" class="form-control" />
                        <span asp-validation-for="BoardCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ArtifactId" class="form-label"></label>
                        <input asp-for="ArtifactId" class="form-control" />
                        <span asp-validation-for="ArtifactId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>儲存修改
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
