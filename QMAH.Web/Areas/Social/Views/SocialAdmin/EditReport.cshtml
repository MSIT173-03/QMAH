@model QMAH.Web.Areas.Social.Models.ReportEditViewModel

@{
    var isCreate = ViewData["IsCreate"] is true;
    var reportId = ViewData["ReportId"];
    ViewData["Title"] = isCreate ? "新增檢舉紀錄" : "編輯檢舉紀錄";
    ViewData["AdminDescription"] = "維護檢舉目標、理由與處理結果；核准貼文或留言後會同步隱藏內容。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回檢舉管理</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="card qmah-form-card">
            <div class="card-header"><h2 class="card-title">@(isCreate ? "檢舉資料" : "編輯檢舉資料")</h2></div>
            <div class="card-body">
                <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@(isCreate ? null : reportId)" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="TargetType" class="form-label"></label>
                            <select asp-for="TargetType" class="form-select">
                                <option value="POST">貼文</option>
                                <option value="COMMENT">留言</option>
                            </select>
                            <span asp-validation-for="TargetType" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="TargetId" class="form-label"></label>
                            <input asp-for="TargetId" class="form-control font-monospace" />
                            <span asp-validation-for="TargetId" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Reason" class="form-label"></label>
                            <input asp-for="Reason" class="form-control" placeholder="例如：SPAM、HARASSMENT、ILLEGAL_CONTENT" />
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Detail" class="form-label"></label>
                            <textarea asp-for="Detail" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Detail" class="text-danger"></span>
                        </div>
                        @if (!isCreate)
                        {
                            <div class="col-12 col-md-4">
                                <label asp-for="Status" class="form-label"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="PENDING">待審核</option>
                                    <option value="RESOLVED">已處理</option>
                                    <option value="REJECTED">已駁回</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-8">
                                <label asp-for="Resolution" class="form-label"></label>
                                <input asp-for="Resolution" class="form-control" placeholder="記錄審核結果或處理方式" />
                                <span asp-validation-for="Resolution" class="text-danger"></span>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>@(isCreate ? "建立紀錄" : "儲存修改")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
