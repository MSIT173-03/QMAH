@using System.Globalization
@model QMAH.Web.Areas.Social.Models.EventAdminPageViewModel

@{
    ViewData["Title"] = "活動管理";
    ViewData["AdminDescription"] = "在後台建立、編輯、刪除活動，並分開處理審核與發布狀態。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增活動</a>
    <a asp-area="Social" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回社群總覽</a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title mb-1">活動篩選</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 text-secondary">
                <span>審核狀態與發布狀態分開管理，避免未審核活動直接上架。</span>
                <span class="badge bg-blue-lt">符合 @Model.TotalCount 筆</span>
            </div>
        </div>
    </div>
    <div class="card-body"><form method="get" asp-action="Index"><div class="row g-3 align-items-end qmah-post-filter-row">
        <div class="col-12 col-md-5"><label class="form-label" for="reviewStatus">審核狀態</label><select class="form-select" id="reviewStatus" name="reviewStatus"><option value="">全部審核狀態</option><option value="PENDING" selected="@(Model.ReviewStatus == "PENDING" ? "selected" : null)">待審核</option><option value="APPROVED" selected="@(Model.ReviewStatus == "APPROVED" ? "selected" : null)">已核准</option><option value="REJECTED" selected="@(Model.ReviewStatus == "REJECTED" ? "selected" : null)">已駁回</option></select></div>
        <div class="col-12 col-md-5"><label class="form-label" for="publishStatus">發布狀態</label><select class="form-select" id="publishStatus" name="publishStatus"><option value="">全部發布狀態</option><option value="DRAFT" selected="@(Model.PublishStatus == "DRAFT" ? "selected" : null)">草稿</option><option value="PUBLISHED" selected="@(Model.PublishStatus == "PUBLISHED" ? "selected" : null)">已發布</option><option value="CANCELLED" selected="@(Model.PublishStatus == "CANCELLED" ? "selected" : null)">已刪除／取消</option></select></div>
        <div class="col-12 col-md-2"><label class="form-label" for="pageSize">每頁筆數</label><select class="form-select" id="pageSize" name="pageSize">@foreach (var size in new[] { 10, 20, 50, 100 }) { <option value="@size" selected="@(Model.PageSize == size)">@size</option> }</select></div>
        <div class="col-12 col-md-2"><div class="qmah-actions"><button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>套用</button><a asp-action="Index" class="btn btn-outline-secondary">清除</a></div></div>
    </div></form></div>
</div>

<div class="card qmah-list-card"><div class="table-responsive"><table class="table table-vcenter table-hover card-table qmah-crud-table">
    <thead><tr><th>類型</th><th>活動</th><th>地點</th><th>時間</th><th>審核</th><th>發布</th><th>建立時間</th><th class="qmah-action-cell qmah-actions--4">操作</th></tr></thead>
    <tbody>
    @if (Model.Events.Count == 0) { <tr><td colspan="8" class="text-center text-secondary py-5">目前沒有符合條件的活動。</td></tr> }
    else
    {
        @foreach (var item in Model.Events)
        {
            var reviewClass = item.Status switch { "APPROVED" => "bg-green-lt", "REJECTED" => "bg-red-lt", _ => "bg-yellow-lt" };
            var publishClass = item.PublishStatus switch { "PUBLISHED" => "bg-green-lt", "CANCELLED" => "bg-red-lt", _ => "bg-secondary-lt" };
            var eventTypeLabel = item.EventType switch
            {
                "OFFICIAL" => "官方活動",
                "PLAYER" => "玩家活動",
                _ => item.EventType
            };
            <tr>
                <td><span class="badge bg-secondary-lt">@eventTypeLabel</span></td>
                <td><div class="fw-semibold">@item.Title</div><div class="text-secondary small">@item.Description</div></td>
                <td>
                    @if (string.IsNullOrWhiteSpace(item.Location))
                    {
                        <span class="text-secondary">未設定地點</span>
                    }
                    else
                    {
                        <div class="qmah-location-cell__name">@item.Location</div>
                    }
                    <a class="btn btn-sm btn-outline-secondary mt-1"
                       data-qmah-map-link
                       data-qmah-map-location="@item.Location"
                       data-qmah-map-latitude="@item.Latitude?.ToString(CultureInfo.InvariantCulture)"
                       data-qmah-map-longitude="@item.Longitude?.ToString(CultureInfo.InvariantCulture)"
                       target="_blank"
                       rel="noopener noreferrer"
                       hidden>
                        <i class="ti ti-map-pin me-1" aria-hidden="true"></i>查看地圖
                    </a>
                </td>
                <td class="text-secondary text-nowrap">@item.StartAt.ToString("yyyy-MM-dd HH:mm")<br /><span class="small">至 @item.EndAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                <td><span class="badge @reviewClass">@AdminDisplayLabels.ReviewStatus(item.Status)</span></td>
                <td><span class="badge @publishClass">@AdminDisplayLabels.PublishStatus(item.PublishStatus)</span></td>
                <td class="text-secondary text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="qmah-action-cell qmah-actions--4">
                    <div class="qmah-table-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
                        @if (item.Status != "APPROVED")
                        {
                            <form asp-action="ReviewEvent" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="APPROVED" /><button type="submit" class="btn btn-sm btn-outline-success">核准</button></form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" disabled>核准</button>
                        }
                        @if (item.Status != "REJECTED")
                        {
                            <form asp-action="ReviewEvent" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="REJECTED" /><button type="submit" class="btn btn-sm btn-outline-warning">駁回</button></form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning" disabled>駁回</button>
                        }
                        @if (item.PublishStatus == "CANCELLED")
                        {
                            <form asp-action="SetPublishStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="DRAFT" /><button type="submit" class="btn btn-sm btn-outline-success">恢復</button></form>
                        }
                        else
                        {
                            <form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('確定要標記刪除這場活動嗎？')">刪除</button></form>
                        }
                    </div>
                </td>
            </tr>
        }
    }
    </tbody>
</table></div><div class="card-footer qmah-card-footer qmah-card-footer--split"><span class="text-secondary">第 @Model.Page / @Model.TotalPages 頁，共 @Model.TotalCount 筆</span><ul class="pagination m-0"><li class="page-item @(Model.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-reviewStatus="@Model.ReviewStatus" asp-route-publishStatus="@Model.PublishStatus">上一頁</a></li><li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li><li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-reviewStatus="@Model.ReviewStatus" asp-route-publishStatus="@Model.PublishStatus">下一頁</a></li></ul></div></div>
