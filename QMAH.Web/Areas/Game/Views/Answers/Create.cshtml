@model AnswerCreateViewModel
@{
    ViewData["Title"] = "建立作答資料";
    ViewData["AdminDescription"] = "建立一筆作答資料供後台測試與維護。";
}
@section Styles { <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" /> }

<form asp-action="Create" method="post" class="card qmah-form-card">
    <div class="card-header"><h2 class="card-title">作答資料</h2></div>
    <div class="card-body"><partial name="_AnswerForm" model="Model" /></div>
<div class="card-footer qmah-card-footer"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">建立作答</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
