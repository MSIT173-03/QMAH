@model AnswerDetailsViewModel
@{
    ViewData["Title"] = "作答詳細資料";
    ViewData["AdminDescription"] = "檢視玩家作答內容與這筆作答收到的投票。";
    var canDelete = Model.VoteCount == 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="ti ti-edit me-1"></i>編輯作答</a>
    @if (canDelete)
    {
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="ti ti-trash me-1"></i>刪除作答</a>
    }
    else
    {
        <button type="button" class="btn btn-danger" disabled title="已有投票的作答不能刪除"><i class="ti ti-trash me-1"></i>刪除作答</button>
    }
    <a class="btn btn-secondary" asp-area="Game" asp-controller="Rounds" asp-action="Details" asp-route-id="@Model.RoundId"><i class="ti ti-history me-1"></i>查看回合</a>
    <a class="btn btn-secondary" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>返回清單</a>
}

<div class="row row-cards mb-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">作答內容</h2></div>
            <div class="card-body"><div class="game-admin-content">@Model.Text</div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">作答資訊</h2></div>
            <div class="card-body">
                <dl class="game-admin-definition">
                    <div><dt>房間／回合</dt><dd>@Model.RoomCode／第 @Model.RoundNumber 回合</dd></div>
                    <div><dt>文物</dt><dd>@Model.ArtifactName</dd></div>
                    <div><dt>玩家</dt><dd>@Model.PlayerName</dd></div>
                    <div><dt>類型</dt><dd>@GameCodeLists.Label(GameCodeLists.AnswerTypes, Model.AnswerType)</dd></div>
                    <div><dt>票數</dt><dd>@Model.VoteCount</dd></div>
                    <div><dt>送出時間</dt><dd>@Model.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></div>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="card-header"><div><h2 class="card-title mb-1">投票明細</h2><div class="card-subtitle">@Model.Votes.Count 筆</div></div></div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table game-admin-table">
            <thead><tr><th>投票玩家</th><th>票數</th><th>時間</th><th class="qmah-action-cell qmah-actions--1">操作</th></tr></thead>
            <tbody>
            @if (Model.Votes.Count == 0)
            {
                <tr><td colspan="4"><div class="empty py-5"><p class="empty-title">尚無投票</p></div></td></tr>
            }
            @foreach (var vote in Model.Votes)
            {
                <tr>
                    <td data-label="投票玩家">@vote.VoterName</td>
                    <td data-label="票數" class="text-nowrap">@vote.Count</td>
                    <td data-label="時間" class="text-secondary text-nowrap">@vote.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</td>
                    <td data-label="操作" class="qmah-action-cell qmah-actions--1 game-admin-cell-actions">
                        <div class="qmah-table-actions">
                            <a class="btn btn-sm btn-info" asp-area="Game" asp-controller="Votes" asp-action="Details" asp-route-id="@vote.Id">查看</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
