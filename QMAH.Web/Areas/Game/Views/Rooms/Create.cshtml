@model RoomCreateViewModel
@{
    ViewData["Title"] = "建立房間";
    ViewData["AdminDescription"] = "設定玩家上限、回合時間與題目篩選條件。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

<form asp-action="Create" method="post" class="card">
    <div class="card-header"><h2 class="card-title">房間設定</h2></div>
    <div class="card-body"><partial name="_RoomForm" model="Model" /></div>
    <div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">建立房間</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
