@model RoomDeleteViewModel
@{
    ViewData["Title"] = $"刪除房間 {Model.RoomCode}";
    ViewData["AdminDescription"] = "刪除是不可逆的管理動作，只允許沒有玩家與回合的等待中房間。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

<div class="card border-danger">
    <div class="card-header"><h2 class="card-title text-danger">確認刪除房間</h2></div>
    <div class="card-body">
        <p>你即將刪除房間 <code>@Model.RoomCode</code>。這個動作無法復原。</p>
        <dl class="game-admin-definition mb-0"><div><dt>玩家數</dt><dd>@Model.PlayerCount</dd></div><div><dt>回合數</dt><dd>@Model.RoundCount</dd></div></dl>
        @if (!Model.CanDelete)
        {
            <div class="alert alert-warning mt-4 mb-0" role="alert">只有沒有玩家與回合的等待中房間可以刪除。</div>
        }
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a>
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input name="rowVersion" value="@Model.RowVersion" type="hidden" /><button class="btn btn-danger" type="submit">確認刪除</button></form>
        }
    </div>
</div>
