@model RoomEditViewModel
@{
    ViewData["Title"] = $"編輯房間 {Model.RoomCode}";
    ViewData["AdminDescription"] = "只有等待中的房間可以調整設定；執行中的生命週期欄位不會出現在表單。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card qmah-form-card">
    <input asp-for="Id" type="hidden" /><input asp-for="Status" type="hidden" /><input asp-for="RowVersion" type="hidden" />
    <div class="card-header"><h2 class="card-title">房間設定</h2></div>
    <div class="card-body"><partial name="_RoomForm" model="Model" /></div>
<div class="card-footer qmah-card-footer"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a><button class="btn btn-primary" type="submit">儲存變更</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
