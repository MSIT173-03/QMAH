@model RoundEditViewModel
@{
    ViewData["Title"] = $"編輯第 {Model.RoundNumber} 回合";
    ViewData["AdminDescription"] = "維護回合資料欄位；不會執行階段推進或結算邏輯。";
}
@section Styles { <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" /> }

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    <input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
    <div class="card-header"><div><h2 class="card-title mb-1">回合資料</h2><div class="card-subtitle">@Model.RoomCode · @Model.ArtifactName · 作答 @Model.AnswerCount 筆 · 投票 @Model.VoteCount 筆</div></div></div>
    <div class="card-body"><partial name="_RoundForm" model="Model" /></div>
    <div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a><button class="btn btn-primary" type="submit">儲存變更</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
