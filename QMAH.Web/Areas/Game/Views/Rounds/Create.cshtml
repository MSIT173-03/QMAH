@model RoundCreateViewModel
@{
    ViewData["Title"] = "建立回合資料";
    ViewData["AdminDescription"] = "建立一筆回合資料供後台測試與維護，不會自動啟動遊戲流程。";
}
@section Styles { <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" /> }

<form asp-action="Create" method="post" class="card">
    <div class="card-header"><h2 class="card-title">回合資料</h2></div>
    <div class="card-body"><partial name="_RoundForm" model="Model" /></div>
    <div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">建立回合</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
