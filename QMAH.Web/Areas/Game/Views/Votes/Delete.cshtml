@model VoteDeleteViewModel
@{
    ViewData["Title"] = "刪除投票資料";
    ViewData["AdminDescription"] = "確認刪除一筆投票歷史資料。";
}
@section Styles { <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" /> }

<div class="card">
    <div class="card-header"><h2 class="card-title">確認刪除投票</h2></div>
    <div class="card-body">
        <p>確定要刪除 <strong>@Model.RoomCode · 第 @Model.RoundNumber 回合</strong> 的投票嗎？</p>
        <dl class="game-admin-definition mb-0"><div><dt>投票玩家</dt><dd>@Model.VoterName</dd></div><div><dt>作答玩家</dt><dd>@Model.AnswerPlayerName</dd></div><div><dt>票數</dt><dd>@Model.Count</dd></div></dl>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input name="rowVersion" value="@Model.RowVersion" type="hidden" /><button class="btn btn-danger" type="submit">確認刪除</button></form>
    </div>
</div>
