@model VoteIndexViewModel
@{
    ViewData["Title"] = "投票紀錄";
    ViewData["AdminDescription"] = "追蹤各回合的投票來源、被投作答與票數。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Create">建立投票資料</a>
}

<form method="get" class="card mb-3 game-admin-filter">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label" for="search">關鍵字</label>
                <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="房間或玩家" autocomplete="off" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="roundId">回合</label>
                <select class="form-select" id="roundId" name="roundId" asp-items="ViewBag.Rounds"><option value="">全部回合</option></select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="Sort" class="form-label">排序</label>
                <select asp-for="Sort" class="form-select">
                    <option value="submitted">最新送出</option>
                    <option value="room">房間</option>
                    <option value="voter">投票玩家</option>
                    <option value="count">票數</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="PageSize" class="form-label">每頁</label>
                <select asp-for="PageSize" class="form-select">
                    @foreach (var size in GameCodeLists.PageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-auto game-admin-filter-actions">
                <div class="btn-list">
                    <button class="btn btn-primary" type="submit"><i class="ti ti-search me-1"></i>搜尋</button>
                    <a class="btn btn-outline-secondary" asp-action="Index"><i class="ti ti-refresh me-1"></i>清除</a>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <div><h2 class="card-title mb-1">投票清單</h2><div class="card-subtitle">共 @Model.Results.TotalCount 筆</div></div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table game-admin-table">
            <thead><tr><th>房間／回合</th><th>投票玩家</th><th>作答玩家</th><th>票數</th><th>送出時間</th><th class="w-1"></th></tr></thead>
            <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="6"><div class="empty py-5"><p class="empty-title">找不到符合條件的投票</p></div></td></tr>
            }
            @foreach (var item in Model.Results.Items)
            {
                <tr>
                    <td data-label="房間／回合"><a class="fw-bold" asp-area="Game" asp-controller="Rounds" asp-action="Details" asp-route-id="@item.RoundId"><code>@item.RoomCode</code></a><div class="text-secondary small">第 @item.RoundNumber 回合</div></td>
                    <td data-label="投票玩家">@item.VoterName</td>
                    <td data-label="作答玩家">@item.AnswerPlayerName</td>
                    <td data-label="票數" class="text-nowrap">@item.Count</td>
                    <td data-label="送出時間" class="text-secondary text-nowrap">@item.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                    <td data-label="" class="game-admin-cell-actions"><div class="btn-list flex-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">查看</a><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">編輯</a></div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-3">
        <span class="text-secondary">第 @Model.Results.Page / @Model.Results.TotalPages 頁</span>
        <div class="btn-list">
            @if (Model.Results.HasPreviousPage)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Results.Page - 1)" asp-route-search="@Model.Search" asp-route-roundId="@Model.RoundId" asp-route-sort="@Model.Sort" asp-route-pageSize="@Model.PageSize">上一頁</a>
            }
            @if (Model.Results.HasNextPage)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Results.Page + 1)" asp-route-search="@Model.Search" asp-route-roundId="@Model.RoundId" asp-route-sort="@Model.Sort" asp-route-pageSize="@Model.PageSize">下一頁</a>
            }
        </div>
    </div>
</div>
