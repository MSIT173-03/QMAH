@using QMAH.Web.Infrastructure.AdminNavigation
@inject AdminNavigationService AdminNavigation
@model GameDashboardViewModel
@{
    ViewData["Title"] = "遊戲總覽";
    ViewData["AdminDescription"] = "集中掌握題庫供應、房間狀態、玩家活動與遊戲紀錄。";

    var workspaceItems = AdminNavigation.GetAreaItems("Game");

    string WorkspaceDescription(string controller) => controller switch
    {
        "QuestionEntries" => "管理題型、難度與啟用狀態",
        "Rooms" => "查看房間生命週期與玩家數",
        "Players" => "查看連線與加入房間狀態",
        "Rounds" => "集中查看回合、作答與投票紀錄",
        "Answers" => "查看玩家作答紀錄",
        "Votes" => "查看玩家投票紀錄",
        _ => "進入此管理功能"
    };
    var maxDifficultyCount = Model.DifficultyDistribution.Count == 0
        ? 1
        : Model.DifficultyDistribution.Max(x => x.Count);
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

@section PageActions {
    <a class="btn btn-primary" asp-area="Game" asp-controller="QuestionEntries" asp-action="Index">
        <i class="ti ti-list-check me-1"></i>題庫管理
    </a>
}

<div class="qmah-area-overview">
    <section class="qmah-area-metrics qmah-area-metrics--5" aria-label="遊戲資料摘要">
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-list-check"></i></span><div><span class="qmah-area-metric__label">啟用題目</span><strong class="qmah-area-metric__value">@Model.EnabledQuestionCount</strong><span class="qmah-area-metric__note">題庫共 @Model.TotalQuestionCount 題</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-door"></i></span><div><span class="qmah-area-metric__label">進行中房間</span><strong class="qmah-area-metric__value">@Model.PlayingRoomCount</strong><span class="qmah-area-metric__note">等待中 @Model.WaitingRoomCount 間</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-users"></i></span><div><span class="qmah-area-metric__label">在線玩家</span><strong class="qmah-area-metric__value">@Model.OnlinePlayerCount</strong><span class="qmah-area-metric__note">房內即時連線狀態</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-circle-check"></i></span><div><span class="qmah-area-metric__label">已完成房間</span><strong class="qmah-area-metric__value">@Model.CompletedRoomCount</strong><span class="qmah-area-metric__note">已結束的遊戲場次</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-history"></i></span><div><span class="qmah-area-metric__label">遊戲紀錄</span><strong class="qmah-area-metric__value">@Model.RoundCount</strong><span class="qmah-area-metric__note">作答 @Model.AnswerCount · 投票 @Model.VoteCount</span></div></article>
    </section>

    <div class="qmah-area-overview-grid">
        <section class="card qmah-area-card qmah-area-workbench">
            <div class="card-header"><div><h2 class="card-title mb-1">遊戲工作區</h2><div class="card-subtitle">依管理功能與歷史紀錄進入各項作業。</div></div></div>
            <div class="card-body">
                <div class="qmah-area-tile-grid">
                    @foreach (var item in workspaceItems)
                    {
                        <a class="qmah-area-action"
                           asp-area="Game"
                           asp-controller="@item.Controller"
                           asp-action="Index">
                            <span class="qmah-area-action__icon">
                                <partial name="Admin/_Icon" model="@item.Controller" />
                            </span>
                            <span>
                                <strong>@item.Label</strong>
                                <small>@WorkspaceDescription(item.Controller)</small>
                            </span>
                            <i class="ti ti-chevron-right qmah-area-action__arrow" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header">
                <div><h2 class="card-title mb-1">最近房間</h2><div class="card-subtitle">依建立時間顯示最近的房間活動。</div></div>
                <div class="card-actions"><a asp-area="Game" asp-controller="Rooms" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a></div>
            </div>
            @if (Model.RecentRooms.Count == 0)
            {
                <div class="empty py-5"><div class="empty-icon"><i class="ti ti-inbox"></i></div><p class="empty-title">目前沒有房間資料</p><p class="empty-subtitle text-secondary">建立第一個房間後會顯示在這裡。</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover card-table game-admin-table">
                        <thead><tr><th>房間</th><th>狀態</th><th>玩家</th><th>回合</th><th>建立時間</th><th class="w-1"></th></tr></thead>
                        <tbody>
                        @foreach (var room in Model.RecentRooms)
                        {
                            <tr>
                                <td data-label="房間"><a class="fw-bold" asp-area="Game" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id">@room.RoomCode</a><div class="text-secondary small">@GameCodeLists.Label(GameCodeLists.Visibilities, room.Visibility)</div></td>
                                <td data-label="狀態"><span class="badge @GameCodeLists.StatusBadgeClass(room.Status)">@GameCodeLists.Label(GameCodeLists.RoomStatuses, room.Status)</span></td>
                                <td data-label="玩家">@room.PlayerCount</td>
                                <td data-label="回合">@room.RoundCount</td>
                                <td data-label="建立時間" class="text-secondary text-nowrap">@room.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                <td data-label="" class="game-admin-cell-actions"><a class="btn btn-sm btn-outline-secondary" asp-area="Game" asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id">查看</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="qmah-area-detail-grid qmah-area-detail-grid--3">
        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">題庫難度</h2><div class="card-subtitle">目前題庫設定的難度分布。</div></div></div>
            @if (Model.DifficultyDistribution.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">尚無題庫設定</p></div>
            }
            else
            {
                <div class="card-body">
                    @foreach (var item in Model.DifficultyDistribution)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between gap-3 small mb-1"><span>難度 @item.Difficulty</span><span class="text-secondary">@item.EnabledCount / @item.Count 題啟用</span></div>
                            <div class="game-admin-progress" aria-label="難度 @item.Difficulty 題數"><span style="width: @(Math.Round(item.Count / (double)maxDifficultyCount * 100))%"></span></div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">最近回合</h2><div class="card-subtitle">依開始時間顯示最近的回合。</div></div></div>
            <div class="list-group list-group-flush qmah-area-list">
            @if (Model.RecentRounds.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">尚無回合紀錄</p></div>
            }
            else
            {
                @foreach (var round in Model.RecentRounds)
                {
                    <a class="list-group-item list-group-item-action" asp-area="Game" asp-controller="Rounds" asp-action="Details" asp-route-id="@round.Id">
                        <div class="d-flex justify-content-between gap-3"><strong>@round.RoomCode · 第 @round.RoundNumber 回合</strong><span class="badge @GameCodeLists.StatusBadgeClass(round.Status)">@GameCodeLists.Label(GameCodeLists.RoundStatuses, round.Status)</span></div>
                        <div class="text-secondary small mt-1">@round.ArtifactName · @round.StartedAt.ToLocalTime().ToString("MM/dd HH:mm")</div>
                    </a>
                }
            }
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">最近玩家活動</h2><div class="card-subtitle">依加入時間顯示最近的玩家活動。</div></div></div>
            <div class="list-group list-group-flush qmah-area-list">
            @if (Model.RecentPlayers.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">尚無玩家紀錄</p></div>
            }
            else
            {
                @foreach (var player in Model.RecentPlayers)
                {
                    <a class="list-group-item list-group-item-action" asp-area="Game" asp-controller="Players" asp-action="Details" asp-route-id="@player.Id">
                        <div class="d-flex justify-content-between gap-3"><strong>@player.DisplayName</strong><span class="badge @GameCodeLists.StatusBadgeClass(player.ConnectionStatus)">@GameCodeLists.Label(GameCodeLists.ConnectionStatuses, player.ConnectionStatus)</span></div>
                        <div class="text-secondary small mt-1">房間 @player.RoomCode · @player.JoinedAt.ToLocalTime().ToString("MM/dd HH:mm")</div>
                    </a>
                }
            }
            </div>
        </section>
    </div>
</div>
