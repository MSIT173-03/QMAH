@model QMAH.Web.Areas.Game.ViewModels.GameEconomyPageViewModel

@{
    ViewData["Title"] = "經濟設定";
    ViewData["AdminDescription"] = "調整多人主遊戲與 Mini Game 的獎勵參數；前端只讀取 API，不需要寫死數值。";
}

@section PageActions {
    <a asp-area="Game" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回遊戲管理</a>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
            <form asp-area="Game" asp-controller="GameEconomy" asp-action="Save" method="post" class="card qmah-form-card">
            @Html.AntiForgeryToken()
            <input asp-for="Economy.Id" type="hidden" />
            <input asp-for="Economy.RowVersion" type="hidden" />
            <div class="card-header"><div><h2 class="card-title">主遊戲與共用經濟</h2><div class="card-subtitle">主遊戲點數依投票比例與勝場比例計算；Mini Game 進度達門檻後才轉成一般鑰匙。</div></div></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <section class="qmah-form-section">
                    <h3 class="qmah-form-section-title">主遊戲鑑定點數</h3>
                    <div class="row g-3">
                        <div class="col-12 col-sm-4"><label asp-for="Economy.MinimumPointReward" class="form-label">最低獎勵</label><input asp-for="Economy.MinimumPointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-4"><label asp-for="Economy.MaximumPointReward" class="form-label">最高獎勵</label><input asp-for="Economy.MaximumPointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-4"><label asp-for="Economy.BasePointReward" class="form-label">基礎獎勵</label><input asp-for="Economy.BasePointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-6"><label asp-for="Economy.MaximumVoteBonus" class="form-label">投票加成上限</label><input asp-for="Economy.MaximumVoteBonus" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-6"><label asp-for="Economy.MaximumWinBonus" class="form-label">勝場加成上限</label><input asp-for="Economy.MaximumWinBonus" class="form-control" min="0" /></div>
                    </div>
                </section>
                <section class="qmah-form-section">
                    <h3 class="qmah-form-section-title">主遊戲鑰匙與 Mini Game 上限</h3>
                    <div class="row g-3">
                        <div class="col-12 col-sm-6"><label asp-for="Economy.CompletedNormalKey" class="form-label">完成給予一般鑰匙</label><input asp-for="Economy.CompletedNormalKey" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-6"><label asp-for="Economy.ExcellentExtraNormalKey" class="form-label">優秀表現額外一般鑰匙</label><input asp-for="Economy.ExcellentExtraNormalKey" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-6"><label asp-for="Economy.ExcellentThreshold" class="form-label">優秀表現門檻</label><input asp-for="Economy.ExcellentThreshold" class="form-control" min="0" max="100" /></div>
                        <div class="col-12 col-sm-6"><label asp-for="Economy.DailyMiniGameRewardLimit" class="form-label">每日 Mini Game 有獎勵次數</label><input asp-for="Economy.DailyMiniGameRewardLimit" class="form-control" min="0" /></div>
                        <div class="col-12 col-sm-6"><label asp-for="Economy.KeyProgressToNormalKey" class="form-label">進度轉一般鑰匙門檻</label><input asp-for="Economy.KeyProgressToNormalKey" class="form-control" min="1" /></div>
                    </div>
                </section>
            </div>
            <div class="card-footer qmah-card-footer"><button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存經濟設定</button></div>
        </form>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card qmah-dashboard-note h-100"><div class="card-body"><span class="qmah-status qmah-status--info">平衡提示</span><h2 class="card-title mt-3">點數與進度分開累積</h2><p class="text-secondary mb-0">Mini Game 的 PointReward 直接增加鑑定點數；KeyProgressReward 先累積在進度條，達到門檻後轉成一般鑰匙並保留餘數。</p></div></div>
    </div>
</div>

<div class="card qmah-list-card mt-3">
    <div class="card-header"><div><h2 class="card-title">Mini Game 模式</h2><div class="card-subtitle">模式本身不包含遊戲畫面；這裡只維護前端開始 Attempt 所需的契約設定。</div></div></div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead><tr><th>模式</th><th>評分門檻</th><th>獎勵</th><th>狀態</th><th class="w-1 text-center">操作</th></tr></thead>
            <tbody>
            @if (Model.Modes.Count == 0)
            {
                <tr><td colspan="5"><div class="empty py-5"><div class="empty-icon"><i class="ti ti-device-gamepad-2"></i></div><p class="empty-title">尚未建立 Mini Game 模式</p></div></td></tr>
            }
            else
            {
                @foreach (var mode in Model.Modes)
                {
                    <tr>
                        <td><strong>@mode.Name</strong><div class="small text-secondary"><code>@mode.Code</code></div><div class="small text-secondary">@mode.Description</div></td>
                        <td>B @mode.GradeBThreshold · A @mode.GradeAThreshold · S @mode.GradeSThreshold</td>
                        <td><span class="small">B @mode.BPointReward 點／@mode.BKeyProgressReward 進度</span><br /><span class="small">A @mode.APointReward 點／@mode.AKeyProgressReward 進度</span><br /><span class="small">S @mode.SPointReward 點／@mode.SKeyProgressReward 進度</span></td>
                        <td><span class="badge @(mode.IsActive ? "bg-green-lt" : "bg-secondary-lt")">@(mode.IsActive ? "啟用" : "停用")</span></td>
                        <td class="text-center"><div class="d-flex flex-wrap justify-content-center gap-2"><a asp-area="Game" asp-controller="GameEconomy" asp-action="EditMode" asp-route-id="@mode.Id" class="btn btn-sm btn-outline-secondary"><i class="ti ti-edit me-1"></i>編輯</a><form asp-area="Game" asp-controller="GameEconomy" asp-action="ToggleMode" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@mode.Id" /><button class="btn btn-sm @(mode.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(mode.IsActive ? "停用" : "啟用")</button></form></div></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
