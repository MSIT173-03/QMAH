@model QMAH.Web.Areas.Game.ViewModels.GameModeEditViewModel

@{
    ViewData["Title"] = "編輯 Mini Game 模式";
    ViewData["AdminDescription"] = "調整 Mini Game 評分門檻、獎勵與素材設定；完成結果仍由伺服器重新計算。";
}

@section PageActions {
    <a asp-area="Game" asp-controller="GameEconomy" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回經濟設定</a>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
        <form asp-area="Game" asp-controller="GameEconomy" asp-action="EditMode" asp-route-id="@Model.Id" method="post" class="card qmah-form-card">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="RowVersion" type="hidden" />
            <div class="card-header"><div><h2 class="card-title">模式設定</h2><div class="card-subtitle">Config JSON 只保存玩法素材參數，不可用來指定客戶端獎勵。</div></div></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <section class="qmah-form-section">
                    <h3 class="qmah-form-section-title">基本資料</h3>
                    <div class="row g-3">
                        <div class="col-12 col-md-6"><label asp-for="Code" class="form-label">模式代碼</label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
                        <div class="col-12 col-md-6"><label asp-for="Name" class="form-label">顯示名稱</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
                        <div class="col-12"><label asp-for="Description" class="form-label">說明</label><textarea asp-for="Description" class="form-control" rows="2"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
                        <div class="col-12"><label asp-for="ConfigJson" class="form-label">素材設定 JSON</label><textarea asp-for="ConfigJson" class="form-control font-monospace" rows="5" placeholder='例如：{"poolSize":1,"difficulty":"NORMAL"}'></textarea><div class="form-hint">只接受 JSON 物件；前端應把它視為模式設定，不要把點數或鑰匙獎勵寫在前端。</div><span asp-validation-for="ConfigJson" class="text-danger"></span></div>
                    </div>
                </section>
                <section class="qmah-form-section">
                    <h3 class="qmah-form-section-title">評分門檻</h3>
                    <div class="row g-3">
                        <div class="col-12 col-md-4"><label asp-for="GradeBThreshold" class="form-label">B 級起點</label><input asp-for="GradeBThreshold" class="form-control" min="0" max="100" /></div>
                        <div class="col-12 col-md-4"><label asp-for="GradeAThreshold" class="form-label">A 級起點</label><input asp-for="GradeAThreshold" class="form-control" min="0" max="100" /></div>
                        <div class="col-12 col-md-4"><label asp-for="GradeSThreshold" class="form-label">S 級起點</label><input asp-for="GradeSThreshold" class="form-control" min="0" max="100" /></div>
                    </div>
                </section>
                <section class="qmah-form-section">
                    <h3 class="qmah-form-section-title">各級獎勵</h3>
                    <div class="row g-3">
                        <div class="col-12 col-md-3"><label asp-for="FailPointReward" class="form-label">FAIL 點數</label><input asp-for="FailPointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="FailKeyProgressReward" class="form-label">FAIL 進度</label><input asp-for="FailKeyProgressReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="BPointReward" class="form-label">B 點數</label><input asp-for="BPointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="BKeyProgressReward" class="form-label">B 進度</label><input asp-for="BKeyProgressReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="APointReward" class="form-label">A 點數</label><input asp-for="APointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="AKeyProgressReward" class="form-label">A 進度</label><input asp-for="AKeyProgressReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="SPointReward" class="form-label">S 點數</label><input asp-for="SPointReward" class="form-control" min="0" /></div>
                        <div class="col-12 col-md-3"><label asp-for="SKeyProgressReward" class="form-label">S 進度</label><input asp-for="SKeyProgressReward" class="form-control" min="0" /></div>
                    </div>
                </section>
                <label class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><span class="form-check-label">提供新的 Attempt 使用</span></label>
            </div>
            <div class="card-footer qmah-card-footer"><a asp-area="Game" asp-controller="GameEconomy" asp-action="Index" class="btn btn-outline-secondary">取消</a><button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存模式</button></div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
