@model QuestionEntryEditViewModel
@{
    ViewData["Title"] = $"編輯題庫：{Model.ArtifactName}";
    ViewData["AdminDescription"] = "只修改 Game 題庫設定，不變更圖鑑文物主檔。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    <input asp-for="Id" type="hidden" /><input asp-for="ArtifactId" type="hidden" />
    <div class="card-header"><div><h2 class="card-title mb-1">@Model.ArtifactName</h2><div class="card-subtitle"><code>@Model.ArtifactRef</code></div></div></div>
    <div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Difficulty" class="form-label"></label><input asp-for="Difficulty" class="form-control" min="1" max="5" /><span asp-validation-for="Difficulty" class="text-danger"></span></div><div class="col-md-6"><label asp-for="QuestionTemplateCode" class="form-label"></label><select asp-for="QuestionTemplateCode" asp-items="GameCodeLists.ToSelectList(GameCodeLists.QuestionTemplates, Model.QuestionTemplateCode)" class="form-select"></select><span asp-validation-for="QuestionTemplateCode" class="text-danger"></span></div><div class="col-12"><label class="form-check"><input asp-for="IsEnabled" class="form-check-input" /><span class="form-check-label">啟用這件文物的題庫設定</span></label></div></div></div>
    <div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a><button class="btn btn-primary" type="submit">儲存變更</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
