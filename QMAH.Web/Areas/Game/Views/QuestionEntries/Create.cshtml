@model QuestionEntryCreateViewModel
@{
    ViewData["Title"] = "新增題庫設定";
    ViewData["AdminDescription"] = "只列出尚未建立題庫設定且仍啟用的文物。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

<form asp-action="Create" method="post" class="card">
    <div class="card-header"><h2 class="card-title">題庫設定</h2></div>
    <div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-12"><label asp-for="ArtifactId" class="form-label"></label><select asp-for="ArtifactId" asp-items="ViewBag.Artifacts" class="form-select"><option value="">請選擇文物</option></select><span asp-validation-for="ArtifactId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Difficulty" class="form-label"></label><input asp-for="Difficulty" class="form-control" min="1" max="5" /><span asp-validation-for="Difficulty" class="text-danger"></span></div><div class="col-md-6"><label asp-for="QuestionTemplateCode" class="form-label"></label><select asp-for="QuestionTemplateCode" asp-items="GameCodeLists.ToSelectList(GameCodeLists.QuestionTemplates, Model.QuestionTemplateCode)" class="form-select"></select><span asp-validation-for="QuestionTemplateCode" class="text-danger"></span></div><div class="col-12"><label class="form-check"><input asp-for="IsEnabled" class="form-check-input" /><span class="form-check-label">建立後立即啟用</span></label></div></div></div>
    <div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">建立設定</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
