@model PlayerDetailsViewModel
@{
    ViewData["Title"] = $"玩家：{Model.DisplayName}";
    ViewData["AdminDescription"] = "檢視玩家的房間身份、連線時間與留下的遊戲紀錄。";
    var canDelete = Model.AnswerCount == 0 && Model.VoteCount == 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
        <i class="ti ti-edit me-1"></i>編輯玩家
    </a>
    @if (canDelete)
    {
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">
            <i class="ti ti-trash me-1"></i>刪除玩家
        </a>
    }
    else
    {
        <button type="button" class="btn btn-danger" disabled title="已有作答或投票紀錄的玩家不能刪除">
            <i class="ti ti-trash me-1"></i>刪除玩家
        </button>
    }
    <a class="btn btn-secondary" asp-action="Index">
        <i class="ti ti-arrow-left me-1"></i>返回清單
    </a>
}

<div class="row row-cards">
    <div class="col-lg-6">
        <div class="card qmah-detail-section h-100">
            <div class="card-header"><div><h2 class="card-title mb-1">遊戲身份</h2><div class="card-subtitle">房間 <code>@Model.RoomCode</code></div></div></div>
            <div class="card-body">
                <dl class="game-admin-definition">
                    <div><dt>顯示名稱</dt><dd>@Model.DisplayName</dd></div>
                    <div><dt>帳號</dt><dd>@(Model.UserName ?? "未設定")</dd></div>
                    <div><dt>Email</dt><dd>@(Model.Email ?? "未設定")</dd></div>
                    <div><dt>角色</dt><dd>@GameCodeLists.Label(GameCodeLists.PlayerRoles, Model.Role)</dd></div>
                    <div><dt>座位</dt><dd>@(Model.SeatNo?.ToString() ?? "未安排")</dd></div>
                    <div><dt>準備狀態</dt><dd>@if (Model.IsReady) { <span class="badge bg-green-lt text-green">已準備</span> } else { <span class="text-secondary">未準備</span> }</dd></div>
                    <div><dt>連線狀態</dt><dd><span class="badge @GameCodeLists.StatusBadgeClass(Model.ConnectionStatus)">@GameCodeLists.Label(GameCodeLists.ConnectionStatuses, Model.ConnectionStatus)</span></dd></div>
                    <div><dt>作答／投票</dt><dd><a asp-area="Game" asp-controller="Answers" asp-action="Index" asp-route-search="@Model.DisplayName">@Model.AnswerCount</a> ／ <a asp-area="Game" asp-controller="Votes" asp-action="Index" asp-route-search="@Model.DisplayName">@Model.VoteCount</a></dd></div>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card qmah-detail-section h-100">
            <div class="card-header"><h2 class="card-title">連線紀錄</h2></div>
            <div class="card-body">
                <dl class="game-admin-definition">
                    <div><dt>加入</dt><dd>@Model.JoinedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></div>
                    <div><dt>最後活動</dt><dd>@Model.LastSeenAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></div>
                    <div><dt>離線</dt><dd>@(Model.DisconnectedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>重連期限</dt><dd>@(Model.ReconnectDeadlineAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>離開</dt><dd>@(Model.LeftAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</dd></div>
                </dl>
                <div class="alert alert-info mt-4 mb-0">玩家識別金鑰不會在後台畫面顯示；技術識別資訊只保留在資料庫。</div>
            </div>
        </div>
    </div>
</div>

<div class="card qmah-detail-section border-danger mt-3">
    <div class="card-header"><h2 class="card-title text-danger">危險操作</h2></div>
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="text-secondary">一般刪除受到歷史資料保護；只有確定這是可捨棄資料時才使用強制刪除。</div>
        <form asp-area="" asp-controller="AdminEmergency" asp-action="ForceDelete" method="post"
              onsubmit="return confirm('這會連同相依歷史資料一起刪除且無法復原，確定繼續嗎？');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="type" value="player" />
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">強制刪除玩家</button>
        </form>
    </div>
</div>
