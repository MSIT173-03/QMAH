@model PlayerDetailsViewModel
@{
    ViewData["Title"] = $"玩家：{Model.DisplayName}";
    ViewData["AdminDescription"] = "檢視玩家的房間身份、連線時間與留下的遊戲紀錄。";
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" />
}

@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">編輯玩家</a>
    @if (Model.AnswerCount == 0 && Model.VoteCount == 0)
    {
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">刪除玩家</a>
    }
    <a class="btn btn-outline-secondary" asp-action="Index">返回清單</a>
}

<div class="row row-cards">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><div><h2 class="card-title mb-1">遊戲身份</h2><div class="card-subtitle">房間 <code>@Model.RoomCode</code></div></div></div><div class="card-body"><dl class="game-admin-definition"><div><dt>顯示名稱</dt><dd>@Model.DisplayName</dd></div><div><dt>帳號</dt><dd>@(Model.UserName ?? "未設定")</dd></div><div><dt>Email</dt><dd>@(Model.Email ?? "未設定")</dd></div><div><dt>角色</dt><dd>@GameCodeLists.Label(GameCodeLists.PlayerRoles, Model.Role)</dd></div><div><dt>座位</dt><dd>@(Model.SeatNo?.ToString() ?? "未安排")</dd></div><div><dt>準備狀態</dt><dd>@if (Model.IsReady) { <span class="badge bg-green-lt text-green">已準備</span> } else { <span class="text-secondary">未準備</span> }</dd></div><div><dt>連線狀態</dt><dd><span class="badge @GameCodeLists.StatusBadgeClass(Model.ConnectionStatus)">@GameCodeLists.Label(GameCodeLists.ConnectionStatuses, Model.ConnectionStatus)</span></dd></div><div><dt>作答／投票</dt><dd><a asp-area="Game" asp-controller="Answers" asp-action="Index" asp-route-search="@Model.DisplayName">@Model.AnswerCount</a> ／ <a asp-area="Game" asp-controller="Votes" asp-action="Index" asp-route-search="@Model.DisplayName">@Model.VoteCount</a></dd></div></dl></div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">連線紀錄</h2></div><div class="card-body"><dl class="game-admin-definition"><div><dt>加入</dt><dd>@Model.JoinedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></div><div><dt>最後活動</dt><dd>@Model.LastSeenAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></div><div><dt>離線</dt><dd>@(Model.DisconnectedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</dd></div><div><dt>重連期限</dt><dd>@(Model.ReconnectDeadlineAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</dd></div><div><dt>離開</dt><dd>@(Model.LeftAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss") ?? "—")</dd></div></dl><div class="alert alert-info mt-4 mb-0">玩家識別金鑰不會在後台畫面顯示；技術識別資訊只保留在資料庫。</div></div></div></div>
</div>
