@model PlayerIndexViewModel
@{
    ViewData["Title"] = "玩家管理";
    ViewData["AdminDescription"] = "查看房間內的玩家身份、準備狀態與連線生命週期。";
}
@section Styles { <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" /> }
@section PageActions { <a class="btn btn-primary" asp-action="Create"><i class="ti ti-plus me-1"></i>建立玩家資料</a> }

<form method="get" class="card mb-3 game-admin-filter"><div class="card-body"><div class="row g-3 align-items-end">
    <div class="col-12 col-lg-4"><label class="form-label" for="search">關鍵字</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="玩家、帳號、Email 或房間代碼" autocomplete="off" /></div>
    <div class="col-6 col-lg-2"><label class="form-label" for="connectionStatus">連線狀態</label><select class="form-select" id="connectionStatus" name="connectionStatus" asp-items="GameCodeLists.ToSelectList(GameCodeLists.ConnectionStatuses, Model.ConnectionStatus, true)"></select></div>
    <div class="col-6 col-lg-2"><label class="form-label" for="sort">排序</label><select class="form-select" id="sort" name="sort"><option value="joined" selected="@(Model.Sort == "joined")">最近加入</option><option value="name" selected="@(Model.Sort == "name")">玩家名稱</option><option value="room" selected="@(Model.Sort == "room")">房間</option><option value="status" selected="@(Model.Sort == "status")">連線狀態</option><option value="seat" selected="@(Model.Sort == "seat")">座位</option></select></div>
    <div class="col-6 col-lg-1 qmah-page-size-field"><label class="form-label" for="pageSize">每頁</label><select class="form-select" id="pageSize" name="pageSize">@foreach (var size in GameCodeLists.PageSizes) { <option value="@size" selected="@(Model.PageSize == size)">@size</option> }</select></div>
    <div class="col-12 col-lg-auto game-admin-filter-actions"><div class="btn-list"><button class="btn btn-primary" type="submit"><i class="ti ti-search me-1"></i>搜尋</button><a class="btn btn-outline-secondary" asp-action="Index"><i class="ti ti-refresh me-1"></i>清除</a></div></div>
</div></div></form>

<div class="card qmah-list-card">
    <div class="card-header"><div><h2 class="card-title mb-1">玩家清單</h2><div class="card-subtitle">共 @Model.Results.TotalCount 筆</div></div></div>
    @if (Model.Results.Items.Count == 0)
    {
        <div class="empty py-5"><p class="empty-title">找不到符合條件的玩家</p><p class="empty-subtitle text-secondary">請調整關鍵字或連線狀態。</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table table-vcenter table-hover card-table game-admin-table">
            <thead><tr><th>玩家</th><th>房間</th><th>角色</th><th>座位</th><th>連線</th><th>加入時間</th><th class="qmah-action-cell qmah-actions--3">操作</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Results.Items)
            {
                <tr>
                    <td data-label="玩家"><a class="fw-bold" asp-action="Details" asp-route-id="@item.Id">@item.DisplayName</a><div class="text-secondary small">@(item.UserName ?? "未設定帳號")@(string.IsNullOrWhiteSpace(item.Email) ? null : $" · {item.Email}")</div></td>
                    <td data-label="房間"><a asp-area="Game" asp-controller="Rooms" asp-action="Details" asp-route-id="@item.RoomId"><code>@item.RoomCode</code></a></td>
                    <td data-label="角色">@GameCodeLists.Label(GameCodeLists.PlayerRoles, item.Role)</td>
                    <td data-label="座位">@(item.SeatNo?.ToString() ?? "未安排")</td>
                    <td data-label="連線"><span class="badge @GameCodeLists.StatusBadgeClass(item.ConnectionStatus)">@GameCodeLists.Label(GameCodeLists.ConnectionStatuses, item.ConnectionStatus)</span></td>
                    <td data-label="加入時間" class="text-secondary text-nowrap">@item.JoinedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                    <td data-label="操作" class="qmah-action-cell qmah-actions--3 game-admin-cell-actions"><div class="qmah-table-actions"><a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@item.Id">查看</a><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">編輯</a><a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">刪除</a></div></td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2"><span class="text-secondary">第 @Model.Results.Page / @Model.Results.TotalPages 頁，共 @Model.Results.TotalCount 筆</span><ul class="pagination m-0">@if (Model.Results.HasPreviousPage) { <li class="page-item"><a class="page-link" asp-route-page="@(Model.Results.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-connectionStatus="@Model.ConnectionStatus" asp-route-sort="@Model.Sort">上一頁</a></li> } @if (Model.Results.HasNextPage) { <li class="page-item"><a class="page-link" asp-route-page="@(Model.Results.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-connectionStatus="@Model.ConnectionStatus" asp-route-sort="@Model.Sort">下一頁</a></li> }</ul></div>
    }
</div>
