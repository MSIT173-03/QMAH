@model PlayerCreateViewModel
@{
    ViewData["Title"] = "建立玩家資料";
    ViewData["AdminDescription"] = "建立一筆房間玩家資料供後台測試與維護，不會執行遊戲流程。";
}
@section Styles { <link rel="stylesheet" href="~/css/areas/game.css" asp-append-version="true" /> }

<form asp-action="Create" method="post" class="card qmah-form-card">
    <div class="card-header"><h2 class="card-title">玩家資料</h2></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="RoomId" class="form-label"></label><select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select"><option value="">請選擇房間</option></select><span asp-validation-for="RoomId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="UserId" class="form-label"></label><select asp-for="UserId" asp-items="ViewBag.Users" class="form-select"><option value="">請選擇會員</option></select><span asp-validation-for="UserId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="PlayerKey" class="form-label"></label><input asp-for="PlayerKey" class="form-control" autocomplete="off" /><span asp-validation-for="PlayerKey" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Role" class="form-label"></label><select asp-for="Role" asp-items="GameCodeLists.ToSelectList(GameCodeLists.PlayerRoles, Model.Role)" class="form-select"></select><span asp-validation-for="Role" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="SeatNo" class="form-label"></label><input asp-for="SeatNo" class="form-control" min="1" max="10" /><span asp-validation-for="SeatNo" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="ConnectionStatus" class="form-label"></label><select asp-for="ConnectionStatus" asp-items="GameCodeLists.ToSelectList(GameCodeLists.ConnectionStatuses, Model.ConnectionStatus)" class="form-select"></select><span asp-validation-for="ConnectionStatus" class="text-danger"></span></div>
            <div class="col-12"><label class="form-check"><input asp-for="IsReady" class="form-check-input" /><span class="form-check-label">玩家已準備</span></label></div>
        </div>
    </div>
<div class="card-footer qmah-card-footer"><a class="btn btn-outline-secondary" asp-action="Index">取消</a><button class="btn btn-primary" type="submit">建立玩家</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
