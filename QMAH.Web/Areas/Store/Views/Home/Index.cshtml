@using QMAH.Web.Infrastructure.AdminNavigation
@inject AdminNavigationService AdminNavigation
@model QMAH.Web.Areas.Store.ViewModels.StoreDashboardViewModel

@{
    ViewData["Title"] = "商城總覽";
    ViewData["AdminDescription"] = "集中掌握商品、庫存、訂單、優惠券與會員優惠券背包。";

    var workspaceItems = AdminNavigation.GetAreaItems("Store");

    string WorkspaceDescription(string controller) => controller switch
    {
        "Product" => "上架狀態、價格與庫存",
        "Order" => "付款狀態與取消紀錄",
        "Coupon" => "維護優惠券定義與狀態",
        "CouponBackpack" => "查看與發放會員優惠券",
        "CouponTransactions" => "追蹤優惠券發放與使用紀錄",
        _ => "進入此管理功能"
    };
}

@section PageActions {
    <a asp-area="Store" asp-controller="Product" asp-action="Index" class="btn btn-primary">
        <i class="ti ti-package me-1"></i>商品管理
    </a>
}

<div class="qmah-area-overview">
    <section class="qmah-area-metrics qmah-area-metrics--4" aria-label="商城資料摘要">
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-package"></i></span><div><span class="qmah-area-metric__label">商品總數</span><strong class="qmah-area-metric__value">@Model.ProductCount</strong><span class="qmah-area-metric__note">上架 @Model.ActiveProductCount 件</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-box"></i></span><div><span class="qmah-area-metric__label">低庫存商品</span><strong class="qmah-area-metric__value">@Model.LowStockProductCount</strong><span class="qmah-area-metric__note">啟用商品庫存 ≤ 5</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-receipt"></i></span><div><span class="qmah-area-metric__label">訂單總數</span><strong class="qmah-area-metric__value">@Model.OrderCount</strong><span class="qmah-area-metric__note">待處理 @Model.PendingOrderCount 筆</span></div></article>
        <article class="qmah-area-metric"><span class="qmah-area-metric__icon"><i class="ti ti-ticket"></i></span><div><span class="qmah-area-metric__label">優惠券規則</span><strong class="qmah-area-metric__value">@Model.CouponCount</strong><span class="qmah-area-metric__note">目前優惠券設定</span></div></article>
    </section>

    <div class="qmah-area-overview-grid">
        <section class="card qmah-area-card qmah-area-workbench">
            <div class="card-header"><div><h2 class="card-title mb-1">商城工作區</h2><div class="card-subtitle">依用途進入商城相關管理功能。</div></div></div>
            <div class="card-body">
                <div class="qmah-area-tile-grid">
                    @foreach (var item in workspaceItems)
                    {
                        <a class="qmah-area-action"
                           asp-area="Store"
                           asp-controller="@item.Controller"
                           asp-action="Index">
                            <span class="qmah-area-action__icon">
                                <partial name="Admin/_Icon" model="@item.Controller" />
                            </span>
                            <span>
                                <strong>@item.Label</strong>
                                <small>@WorkspaceDescription(item.Controller)</small>
                            </span>
                            <i class="ti ti-chevron-right qmah-area-action__arrow" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header">
                <div><h2 class="card-title mb-1">最近訂單</h2><div class="card-subtitle">最近建立的商城訂單。</div></div>
                <div class="card-actions"><a asp-area="Store" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a></div>
            </div>
            @if (Model.RecentOrders.Count == 0)
            {
                <div class="empty py-5"><div class="empty-icon"><i class="ti ti-inbox"></i></div><p class="empty-title">目前沒有訂單資料</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover card-table qmah-crud-table">
                        <thead><tr><th>訂單</th><th>會員</th><th>狀態</th><th class="text-end">金額</th></tr></thead>
                        <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><a asp-area="Store" asp-controller="Order" asp-action="GetOrder" asp-route-id="@order.Id">@order.OrderNo</a><div class="text-secondary small">@order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div></td>
                                <td>@order.CustomerName</td>
                                <td><span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(order.Status)</span></td>
                                <td class="text-end">@order.TotalAmount.ToString("N0")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="qmah-area-detail-grid qmah-area-detail-grid--2">
        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">商城營運摘要</h2><div class="card-subtitle">商品、庫存、優惠券與付款的目前狀態。</div></div></div>
            <div class="list-group list-group-flush qmah-area-list">
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="Store" asp-controller="Product" asp-action="Index"><span>上架商品</span><strong>@Model.ActiveProductCount / @Model.ProductCount</strong></a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="Store" asp-controller="Product" asp-action="Index"><span>低庫存商品</span><strong class="@(Model.LowStockProductCount > 0 ? "text-warning" : "text-success")">@Model.LowStockProductCount</strong></a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="Store" asp-controller="Coupon" asp-action="Index"><span>優惠券規則</span><strong>@Model.CouponCount</strong></a>
                <div class="list-group-item d-flex align-items-center justify-content-between gap-3"><span>成功付款</span><strong class="text-success">@Model.SuccessfulPaymentCount</strong></div>
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header">
                <div><h2 class="card-title mb-1">最近訂單狀態</h2><div class="card-subtitle">依最近訂單快速檢視目前處理情況。</div></div>
                <div class="card-actions"><a asp-area="Store" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a></div>
            </div>
            @if (Model.RecentOrders.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有訂單資料</p></div>
            }
            else
            {
                <div class="list-group list-group-flush qmah-area-list">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <a class="list-group-item list-group-item-action" asp-area="Store" asp-controller="Order" asp-action="GetOrder" asp-route-id="@order.Id">
                            <div class="d-flex justify-content-between gap-3"><strong>@order.OrderNo</strong><span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(order.Status)</span></div>
                            <div class="text-secondary small mt-1">@order.CustomerName · @order.TotalAmount.ToString("N0") · @order.CreatedAt.ToString("MM/dd HH:mm")</div>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
</div>
