@model QMAH.Web.Areas.Store.ViewModels.StoreDashboardViewModel

@{
    ViewData["Title"] = "商城總覽";
    ViewData["AdminDescription"] = "集中掌握商品、庫存、訂單、優惠券與會員優惠券背包。";
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Store" asp-controller="Product" asp-action="Index" class="btn btn-primary">
            <i class="ti ti-package me-1"></i>商品管理
        </a>
        <a asp-area="Store" asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-receipt me-1"></i>訂單管理
        </a>
    </div>
}

<div class="row row-cards row-cols-1 row-cols-sm-2 row-cols-xl-4 qmah-dashboard-metrics mb-3">
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">商品總數</span><strong class="qmah-metric-value">@Model.ProductCount</strong><span class="qmah-metric-note">上架 @Model.ActiveProductCount 件</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">低庫存商品</span><strong class="qmah-metric-value">@Model.LowStockProductCount</strong><span class="qmah-metric-note">啟用商品庫存 ≤ 5</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">訂單總數</span><strong class="qmah-metric-value">@Model.OrderCount</strong><span class="qmah-metric-note">待處理 @Model.PendingOrderCount 筆</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">優惠券規則</span><strong class="qmah-metric-value">@Model.CouponCount</strong><span class="qmah-metric-note">目前優惠券設定</span></div></div></div>
</div>

<div class="row row-cards">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">商城工作區</h2>
                    <div class="card-subtitle">依用途進入商城相關管理功能。</div>
                </div>
            </div>
            <div class="card-body">
                <div class="qmah-quick-grid">
                    <a class="qmah-quick-link" asp-area="Store" asp-controller="Product" asp-action="Index"><span class="avatar bg-blue-lt"><i class="ti ti-package"></i></span><span><strong>商品管理</strong><small>上架狀態、價格與庫存</small></span></a>
                    <a class="qmah-quick-link" asp-area="Store" asp-controller="Order" asp-action="Index"><span class="avatar bg-green-lt"><i class="ti ti-receipt"></i></span><span><strong>訂單管理</strong><small>付款狀態與取消紀錄</small></span></a>
                    <a class="qmah-quick-link" asp-area="Store" asp-controller="Coupon" asp-action="Index"><span class="avatar bg-orange-lt"><i class="ti ti-ticket"></i></span><span><strong>優惠券規則</strong><small>維護優惠券定義與狀態</small></span></a>
                    <a class="qmah-quick-link" asp-area="Store" asp-controller="CouponBackpack" asp-action="Index"><span class="avatar bg-purple-lt"><i class="ti ti-wallet"></i></span><span><strong>優惠券背包</strong><small>查看與發放會員優惠券</small></span></a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">最近訂單</h2>
                    <div class="card-subtitle">最近建立的商城訂單。</div>
                </div>
                <div class="card-actions">
                    <a asp-area="Store" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a>
                </div>
            </div>

            @if (Model.RecentOrders.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有訂單資料</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover card-table qmah-crud-table">
                        <thead><tr><th>訂單</th><th>會員</th><th>狀態</th><th class="text-end">金額</th></tr></thead>
                        <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><a asp-area="Store" asp-controller="Order" asp-action="GetOrder" asp-route-id="@order.Id">@order.OrderNo</a><div class="text-secondary small">@order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div></td>
                                <td>@order.CustomerName</td>
                                <td><span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(order.Status)</span></td>
                                <td class="text-end">@order.TotalAmount.ToString("N0")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>


<div class="row row-cards mt-3">
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">商城營運摘要</h2>
                    <div class="card-subtitle">商品、庫存、優惠券與付款的目前狀態。</div>
                </div>
            </div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3 py-3"
                   asp-area="Store" asp-controller="Product" asp-action="Index">
                    <span>上架商品</span>
                    <strong>@Model.ActiveProductCount / @Model.ProductCount</strong>
                </a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3 py-3"
                   asp-area="Store" asp-controller="Product" asp-action="Index">
                    <span>低庫存商品</span>
                    <strong class="@(Model.LowStockProductCount > 0 ? "text-warning" : "text-success")">@Model.LowStockProductCount</strong>
                </a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3 py-3"
                   asp-area="Store" asp-controller="Coupon" asp-action="Index">
                    <span>優惠券規則</span>
                    <strong>@Model.CouponCount</strong>
                </a>
                <div class="list-group-item d-flex align-items-center justify-content-between gap-3 py-3">
                    <span>成功付款</span>
                    <strong class="text-success">@Model.SuccessfulPaymentCount</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">最近訂單狀態</h2>
                    <div class="card-subtitle">依最近訂單快速檢視目前處理情況。</div>
                </div>
                <div class="card-actions">
                    <a asp-area="Store" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a>
                </div>
            </div>

            @if (Model.RecentOrders.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有訂單資料</p></div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <a class="list-group-item list-group-item-action py-3"
                           asp-area="Store"
                           asp-controller="Order"
                           asp-action="GetOrder"
                           asp-route-id="@order.Id">
                            <div class="d-flex justify-content-between gap-3">
                                <strong>@order.OrderNo</strong>
                                <span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(order.Status)</span>
                            </div>
                            <div class="text-secondary small mt-1">
                                @order.CustomerName · @order.TotalAmount.ToString("N0") · @order.CreatedAt.ToString("MM/dd HH:mm")
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
