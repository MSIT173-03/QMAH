@model IEnumerable<QMAH.Web.Areas.Store.ViewModels.ProductSimplefyListItem>

@{
    ViewData["Title"] = "商品管理";
    ViewData["AdminDescription"] = "維持既有商品資料模型，提供商品建立、編輯與上下架處理。";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        <i class="ti ti-plus me-1"></i>新增商品
    </a>
}

@{
    var viewData = new ViewDataDictionary(ViewData)
    {
        { "Controller", "Product" },
        { "Action", "Index" }
    };
}
<partial name="OptionSetListPage" view-data="viewData" />

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th class="text-center">圖片</th>
                    <th>商品名稱</th>
                    <th>分類</th>
                    <th>價格</th>
                    <th>庫存</th>
                    <th>狀態</th>
                    <th class="qmah-action-cell qmah-actions--3">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty qmah-empty-state">
                                <div class="empty-icon"><i class="ti ti-package-off"></i></div>
                                <p class="empty-title">目前沒有商品資料</p>
                                <p class="empty-subtitle text-secondary">建立商品後，會在這裡管理上下架狀態與庫存。</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <a asp-action="GetProduct" asp-route-id="@item.Id" aria-label="查看 @item.Name">
                                        <img class="qmah-table-thumbnail" src="@item.ImageUrl" alt="" loading="lazy" />
                                    </a>
                                }
                                else
                                {
                                    <span class="avatar"><i class="ti ti-photo-off"></i></span>
                                }
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="badge bg-blue-lt">@item.Category</span></td>
                            <td>@item.Price.ToString("C0")</td>
                            <td>@item.Stock</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-green-lt" : "bg-secondary-lt")">
                                    @(item.IsActive ? "上架中" : "已下架")
                                </span>
                            </td>
                            <td class="qmah-action-cell qmah-actions--3">
                                <div class="qmah-table-actions">
                                    <a asp-action="GetProduct" asp-route-id="@item.Id" class="btn btn-sm"><i class="ti ti-eye me-1"></i>查看</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm"><i class="ti ti-edit me-1"></i>編輯</a>
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-warning" : "btn-success")">
                                            <i class="ti @(item.IsActive ? "ti-eye-off" : "ti-eye") me-1"></i>@(item.IsActive ? "下架" : "上架")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
