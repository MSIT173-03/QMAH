@model QMAH.Infrastructure.Models.Entities.Product

@{
    ViewData["Title"] = "商品詳細資料";
    ViewData["AdminDescription"] = "檢視商品內容、庫存與上架狀態。";
    var categoryName = ViewBag.CategoryName as string ?? Model.CategoryCode;
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/store.css" asp-append-version="true" />
}

@section PageActions {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="ti ti-edit me-1"></i>編輯商品
    </a>
    <form asp-action="ToggleStatus" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn @(Model.IsActive ? "btn-warning" : "btn-success")">
            <i class="ti @(Model.IsActive ? "ti-eye-off" : "ti-eye") me-1"></i>@(Model.IsActive ? "下架商品" : "重新上架")
        </button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回商品管理
    </a>
}

<div class="row row-cards store-admin-detail-grid">
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">商品圖片</h2></div>
            <div class="card-body d-flex align-items-center justify-content-center store-admin-detail-media">
                @if (!string.IsNullOrWhiteSpace(Model.PrimaryImagePath))
                {
                    <button type="button"
                            class="qmah-product-detail-trigger"
                            data-bs-toggle="modal"
                            data-bs-target="#qmah-image-preview"
                            data-qmah-image-preview="@Model.PrimaryImagePath"
                            data-qmah-image-preview-alt="@Model.Name"
                            aria-label="查看 @Model.Name 原圖">
                        <img src="@Model.PrimaryImagePath"
                             alt="@Model.Name"
                             class="qmah-product-detail-image"
                             loading="eager"
                             decoding="async" />
                        <span class="qmah-product-detail-zoom-hint">
                            <i class="ti ti-zoom-in" aria-hidden="true"></i>查看大圖
                        </span>
                    </button>
                }
                else
                {
                    <div class="empty py-5"><div class="empty-icon"><i class="ti ti-photo-off"></i></div><p class="empty-title">尚無商品圖片</p></div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card h-100 qmah-detail-section">
            <div class="card-header">
                <div>
                    <h2 class="card-title">@Model.Name</h2>
                                    <div class="text-secondary">@(string.IsNullOrWhiteSpace(Model.ExternalRef) ? "尚未設定商品編號" : Model.ExternalRef)</div>
                </div>
                <span class="badge @(Model.IsActive ? "bg-green-lt" : "bg-secondary-lt")">@(Model.IsActive ? "上架中" : "已下架")</span>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">分類</div><div class="datagrid-content">@categoryName</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">價格</div><div class="datagrid-content fw-semibold">@Model.Price.ToString("C0")</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">庫存</div><div class="datagrid-content">@Model.Stock</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">尺寸</div><div class="datagrid-content">@(string.IsNullOrWhiteSpace(Model.SizeText) ? "未標示" : Model.SizeText)</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">關聯文物</div><div class="datagrid-content">@(Model.Artifact?.Name ?? "未關聯")</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">建立時間</div><div class="datagrid-content">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">最後更新</div><div class="datagrid-content">@Model.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div></div>
                </div>

                <hr />
                <h3 class="h4">商品描述</h3>
                <div class="qmah-detail-copy">@(string.IsNullOrWhiteSpace(Model.Description) ? "尚未提供商品描述。" : Model.Description)</div>

                @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                {
                    <div class="mt-4">
                        <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary">
                            <i class="ti ti-external-link me-1"></i>查看來源
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<partial name="Admin/_ImagePreviewModal" model="@("商品大圖")" />
