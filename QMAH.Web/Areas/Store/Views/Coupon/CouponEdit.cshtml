@model QMAH.Web.Areas.Store.ViewModels.CouponEditViewModel

@{
    var isEdit = Model.Id != Guid.Empty;
    ViewData["Title"] = isEdit ? "編輯優惠券規則" : "新增優惠券規則";
    ViewData["AdminDescription"] = "修改優惠券規則與有效期間，不影響既有使用紀錄。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回優惠券規則
    </a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="card qmah-form-card">
            <div class="card-header"><h2 class="card-title">@(isEdit ? "規則資料" : "建立優惠券規則")</h2></div>
            <div class="card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <section class="qmah-form-section">
                        <h3 class="qmah-form-section-title">優惠券內容</h3>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DiscountType" class="form-label"></label>
                                <select asp-for="DiscountType" class="form-select">
                                    <option value="FIXED">固定金額</option>
                                    <option value="PERCENT">百分比</option>
                                </select>
                                <span asp-validation-for="DiscountType" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DiscountValue" class="form-label"></label>
                                <input asp-for="DiscountValue" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="MinimumAmount" class="form-label"></label>
                                <input asp-for="MinimumAmount" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="MinimumAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </section>

                    <section class="qmah-form-section">
                        <h3 class="qmah-form-section-title">有效期間與狀態</h3>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="StartAt" class="form-label"></label>
                                <input asp-for="StartAt" type="datetime-local" class="form-control" />
                                <span asp-validation-for="StartAt" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="EndAt" class="form-label"></label>
                                <input asp-for="EndAt" type="datetime-local" class="form-control" />
                                <span asp-validation-for="EndAt" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <span class="form-check-label">啟用此優惠券規則</span>
                                </label>
                            </div>
                        </div>
                    </section>

                    <div class="qmah-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>儲存
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
