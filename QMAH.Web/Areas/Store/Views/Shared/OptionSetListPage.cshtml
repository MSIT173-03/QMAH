@{
    int curPage = Math.Max(0, Convert.ToInt32(ViewData["Page"]));
    int rows = Math.Max(0, Convert.ToInt32(ViewData["Rows"]));
    int prev = Math.Max(0, curPage - 1);
    int next = curPage + 1;

    string controller = ViewData["Controller"]?.ToString() ?? "";
    string action = ViewData["Action"]?.ToString() ?? "";
}

<section class="qmah-pagination-bar" aria-label="商品清單分頁設定">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="text-secondary small">可調整每頁顯示筆數，按 Enter 套用。</div>
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-1">
        <a asp-controller="@controller" asp-action="@action" asp-route-page="@prev" asp-route-rows="@rows"
            class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-chevron-left" aria-hidden="true"></i>
            上一頁
        </a>
        <input id="list-display-config-page" type="number" min="0" value="@curPage" class="number-input form-control text-center" />
        <a asp-controller="@controller" asp-action="@action" asp-route-page="@next" asp-route-rows="@rows"
           class="btn btn-sm btn-outline-secondary">
           下一頁
            <i class="ti ti-chevron-right" aria-hidden="true"></i>
        </a>

        <div class="d-flex align-items-center ms-md-3">
            <label for="list-display-config-rows" class="form-label mb-0 me-2">每頁筆數</label>
            <input name="list-display-config-rows" id="list-display-config-rows" type="number" min="1" value="@rows" class="number-input form-control text-center" />
        </div>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll("input.number-input").forEach(input => {
        input.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                event.preventDefault();

                const newRows = document.querySelector("input#list-display-config-rows").value
                const newPage = document.querySelector("input#list-display-config-page").value
                const url = new URL(window.location.href)

                url.searchParams.set("page", newPage)
                url.searchParams.set("rows", newRows)

                window.location.href = url.toString()
            }
        })
    })
</script>
