@using QMAH.Web.Infrastructure
@model IEnumerable<QMAH.Web.Areas.Store.ViewModels.CouponTransactionListItemViewModel>

@{
    ViewData["Title"] = "優惠券流水";
    ViewData["AdminDescription"] = "依會員、優惠券或狀態查看發放與使用紀錄。";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    int pageSize = ViewBag.PageSize;

    int start = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int end = Math.Min(currentPage * pageSize, totalCount);
}

@section PageActions {
    <div class="qmah-actions d-flex flex-wrap gap-2">
        <a asp-area="Store" asp-controller="Coupon" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-settings me-1"></i>優惠券規則
        </a>
        <a asp-area="Store" asp-controller="CouponBackpack" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-backpack me-1"></i>優惠券背包
        </a>
        <a asp-area="Store" asp-controller="CouponTransactions" asp-action="Index" class="btn btn-secondary">
            <i class="ti ti-receipt me-1"></i>優惠券流水
        </a>
    </div>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title">查詢優惠券流水</h2>
            <div class="card-subtitle">依會員、優惠券名稱、代碼或狀態篩選紀錄。</div>
        </div>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="qmah-filter-form">
            <div class="row g-2">
                <div class="col-md-6">
                    <input type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control"
                           placeholder="搜尋會員、優惠券名稱或代碼" />
                </div>

                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">全部狀態</option>
                        <option value="AVAILABLE" selected="@(ViewBag.Status == "AVAILABLE")">可使用</option>
                        <option value="USED" selected="@(ViewBag.Status == "USED")">已使用</option>
                        <option value="EXPIRED" selected="@(ViewBag.Status == "EXPIRED")">已過期</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="ti ti-search me-1"></i>搜尋
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="card-header qmah-crud-toolbar">
        <div>
            <h2 class="card-title">流水紀錄</h2>
            <div class="card-subtitle">共 @totalCount 筆</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th>發放時間</th>
                    <th>會員</th>
                    <th>優惠券</th>
                    <th>狀態</th>
                    <th>使用時間</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty qmah-empty-state">
                                <div class="empty-icon"><i class="ti ti-receipt-off"></i></div>
                                <p class="empty-title">目前沒有符合條件的紀錄</p>
                                <p class="empty-subtitle text-secondary">請調整搜尋條件後再試一次。</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <span class="fw-semibold">@item.IssuedAt.ToLocalTime().ToString("yyyy/MM/dd")</span>
                                <div class="text-secondary small">@item.IssuedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@(item.Nickname ?? item.Email)</div>
                                @if (!string.IsNullOrWhiteSpace(item.Nickname))
                                {
                                    <div class="text-secondary small">@item.Email</div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@item.CouponName</div>
                                <code>@item.CouponCode</code>
                            </td>
                            <td>
                                <span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(item.Status)</span>
                            </td>
                            <td class="text-secondary text-nowrap">
                                @(item.UsedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="qmah-pagination-bar d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
    <div class="text-muted">顯示第 @start～@end 筆，共 @totalCount 筆</div>

    <nav aria-label="優惠券流水分頁">
        <div class="btn-list">
            @if (currentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-keyword="@ViewBag.Keyword"
                   asp-route-status="@ViewBag.Status"
                   class="btn btn-secondary">上一頁</a>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-keyword="@ViewBag.Keyword"
                   asp-route-status="@ViewBag.Status"
                   class="btn btn-sm @(i == currentPage ? "btn-primary" : "btn-outline-secondary")">@i</a>
            }

            @if (currentPage < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-keyword="@ViewBag.Keyword"
                   asp-route-status="@ViewBag.Status"
                   class="btn btn-secondary">下一頁</a>
            }
        </div>
    </nav>
</div>
