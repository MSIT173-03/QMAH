@model IEnumerable<QMAH.Web.Areas.Store.ViewModels.OrderSimplefyListItem>

@{
    ViewData["Title"] = "訂單管理";
    ViewData["AdminDescription"] = "檢視訂單、付款與取消紀錄；訂單明細不提供任意刪除，避免破壞交易歷史。";
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/qmah-datatables.css" asp-append-version="true" />
}

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table id="store-orders-table"
               class="table table-vcenter table-hover card-table qmah-crud-table"
               data-ajax-url="@Url.Action("Data", "Order", new { area = "Store" })">
            <thead>
                <tr>
                    <th>訂單編號</th>
                    <th>會員</th>
                    <th>狀態</th>
                    <th>商品數量</th>
                    <th>小計</th>
                    <th>折扣</th>
                    <th>點數</th>
                    <th>總計</th>
                    <th>建立時間</th>
                    <th>付款時間</th>
                    <th>取消時間</th>
                    <th class="qmah-action-cell qmah-actions--1">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="12" class="text-center text-secondary py-5">目前沒有訂單資料。</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code>@item.OrderNo</code></td>
                            <td class="fw-semibold">@item.UserName</td>
                            <td><span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(item.Status)</span></td>
                            <td>@item.ItemsCount</td>
                            <td>@item.ItemsTotal.ToString("C0")</td>
                            <td>@item.DiscountAmount.ToString("C0")</td>
                            <td>@item.PointUsed</td>
                            <td class="fw-semibold">@item.Total.ToString("C0")</td>
                            <td class="text-secondary text-nowrap">@item.CreateAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-secondary">@(item.PaidAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="text-secondary">@(item.CancelledAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="qmah-action-cell qmah-actions--1">
                                <div class="qmah-table-actions">
                                    <a asp-action="GetOrder" asp-route-id="@item.Id" class="btn btn-sm btn-info">查看</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/admin/vendor/datatables/dataTables.min.js"></script>
    <script>
        (() => {
            const tableElement = document.getElementById("store-orders-table");
            if (!tableElement || typeof DataTable === "undefined") return;

            new DataTable(tableElement, {
                processing: true,
                serverSide: true,
                pageLength: 20,
                lengthMenu: [10, 20, 50, 100],
                order: [[8, "desc"]],
                ajax: {
                    url: tableElement.dataset.ajaxUrl,
                    dataSrc: "data"
                },
                columns: [
                    { data: "orderNo" },
                    { data: "userName" },
                    { data: "status" },
                    { data: "itemsCount" },
                    { data: "subtotal" },
                    { data: "discountAmount" },
                    { data: "pointsUsed" },
                    { data: "totalAmount" },
                    { data: "createdAt" },
                    { data: "paidAt" },
                    { data: "cancelledAt" },
                    {
                        data: "actionUrl",
                        orderable: false,
                        searchable: false,
                        render: (url, type) => type === "display"
                            ? `<a class="btn btn-sm btn-info" href="${escapeHtml(url)}">查看</a>`
                            : url
                    }
                ],
                language: {
                    processing: "讀取中……",
                    search: "搜尋：",
                    lengthMenu: "每頁顯示 _MENU_ 筆",
                    info: "第 _START_–_END_ 筆，共 _TOTAL_ 筆",
                    infoEmpty: "目前沒有資料",
                    zeroRecords: "找不到符合條件的訂單",
                    paginate: { first: "第一頁", last: "最後一頁", next: "下一頁", previous: "上一頁" }
                }
            });

            function escapeHtml(value) {
                return String(value ?? "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }
        })();
    </script>
}
