@model QMAH.Web.Areas.Store.ViewModels.OrderFullDetail

@{
    ViewData["Title"] = "訂單詳細資料";
    ViewData["AdminDescription"] = "檢視訂單金額、狀態與商品明細；保留交易歷史。";
    var canCancel = Model.CancelledAt is null && Model.Status != "CANCELLED";
}

@section PageActions {
    @if (canCancel)
    {
        <form asp-controller="Order" asp-action="Cancel" method="post" id="set-cancel-order">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger"><i class="ti ti-x me-1"></i>取消訂單</button>
        </form>
    }
    else
    {
        <button type="button" class="btn btn-danger" disabled><i class="ti ti-x me-1"></i>取消訂單</button>
    }
    <a asp-action="Index" class="btn btn-secondary"><i class="ti ti-arrow-left me-1"></i>返回訂單管理</a>
}

<div class="row row-cards mb-3">
    <div class="col-12 col-lg-5">
        <div class="card h-100 qmah-detail-section">
            <div class="card-header">
                <div><h2 class="card-title">訂單資訊</h2><div class="text-secondary"><code>@Model.Id</code></div></div>
                <span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(Model.Status)</span>
            </div>
            <div class="card-body">
                <dl class="game-admin-definition">
                    <div><dt>會員</dt><dd>@Model.UserName</dd></div>
                    <div><dt>商品數量</dt><dd>@Model.ItemsCount</dd></div>
                    <div><dt>建立時間</dt><dd>@Model.CreateAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd></div>
                    <div><dt>付款時間</dt><dd>@(Model.PaidAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "尚未付款")</dd></div>
                    <div><dt>取消時間</dt><dd>@(Model.CancelledAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</dd></div>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card h-100 qmah-detail-section">
            <div class="card-header"><h2 class="card-title">金額</h2></div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">商品小計</div><div class="datagrid-content">@Model.ItemsTotal.ToString("C0")</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">折扣</div><div class="datagrid-content">@Model.DiscountAmount.ToString("C0")</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">使用點數</div><div class="datagrid-content">@Model.PointUsed</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">訂單總計</div><div class="datagrid-content fw-bold fs-3">@Model.Total.ToString("C0")</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="card-header">
        <div><h2 class="card-title">商品明細</h2><div class="text-secondary">共 @Model.ItemList.Count 筆品項</div></div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead>
                <tr>
                    <th>商品名稱</th>
                    <th>單價</th>
                    <th>數量</th>
                    <th>小計</th>
                    <th class="qmah-action-cell qmah-actions--1">操作</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.ItemList)
            {
                <tr>
                    <td class="fw-semibold">@item.ProductName</td>
                    <td>@item.Price.ToString("C0")</td>
                    <td>@item.Amount</td>
                    <td>@((item.Price * item.Amount).ToString("C0"))</td>
                    <td class="qmah-action-cell qmah-actions--1">
                        <div class="qmah-table-actions">
                            <a asp-area="Store" asp-controller="Product" asp-action="GetProduct" asp-route-id="@item.ProductId" class="btn btn-sm btn-info">查看</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const form = document.getElementById("set-cancel-order");
        if (!form) return;

        form.addEventListener("submit", async event => {
            event.preventDefault();
            const button = form.querySelector("button[type='submit']");
            if (!confirm("確定要取消這筆訂單嗎？")) return;

            button.disabled = true;
            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form)
                });

                if (response.ok) {
                    location.reload();
                    return;
                }

                const result = await response.text();
                alert(result || "訂單取消失敗。");
            } catch {
                alert("訂單取消失敗，請稍後再試。");
            } finally {
                button.disabled = false;
            }
        });
    })();
</script>
}
