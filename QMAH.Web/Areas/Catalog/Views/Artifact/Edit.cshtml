@model QMAH.Infrastructure.Models.Entities.Artifact

@{
    ViewData["Title"] = "文物編輯";
    ViewData["AdminDescription"] = "維護文物主資料、來源授權、圖片與啟用狀態。";
    var previewPath = Model.PrimaryImagePath ?? Model.ThumbnailPath;
    var questionTemplateLabel = Model.ArtifactQuestionEntry?.QuestionTemplateCode switch
    {
        "GENERAL" => "一般鑑定",
        "ERA" => "年代判讀",
        "CATEGORY" => "分類判讀",
        null => null,
        var code => code
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-editor-preview.css" asp-append-version="true" />
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回文物總覽
    </a>
}

<div class="row row-cards qmah-editor-grid">
    <div class="col-12 col-xl-7">
        <form asp-action="Edit" method="post" class="card qmah-form-card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">文物主資料</h2>
                    <div class="text-secondary">標示的欄位會同步供題庫、遊戲與商城使用。</div>
                </div>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">文物名稱</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                <label asp-for="ArtifactRef" class="form-label">故宮編號</label>
                        <input asp-for="ArtifactRef" class="form-control" />
                        <span asp-validation-for="ArtifactRef" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="form-label">分類</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.ArtifactCategoryList" class="form-select">
                            <option value="">請選擇分類</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="EraBucketId" class="form-label">年代區間</label>
                        <select asp-for="EraBucketId" asp-items="ViewBag.EraBucketList" class="form-select">
                            <option value="">請選擇年代</option>
                        </select>
                        <span asp-validation-for="EraBucketId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="EraTextOriginal" class="form-label">原始年代文字</label>
                        <input asp-for="EraTextOriginal" class="form-control" placeholder="保留來源所載文字" />
                        <span asp-validation-for="EraTextOriginal" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CreatorDisplay" class="form-label">作者／製作者</label>
                        <input asp-for="CreatorDisplay" class="form-control" placeholder="未提供可留空" />
                        <span asp-validation-for="CreatorDisplay" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">文物說明</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="請輸入文物說明"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="SizeText" class="form-label">尺寸文字</label>
                        <input asp-for="SizeText"
                               class="form-control"
                               placeholder="例如：長 5.5 公分・寬 3.8 公分・高 2.4 公分" />
                        <span asp-validation-for="SizeText" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <h3 class="qmah-form-section-title border-bottom pb-2 mb-0">來源與授權</h3>
                    </div>

                    <div class="col-12">
                        <label asp-for="SourceUrl" class="form-label">來源網址</label>
                        <input asp-for="SourceUrl" class="form-control" type="url" placeholder="https://..." />
                        <span asp-validation-for="SourceUrl" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="LicenseCode" class="form-label">授權代碼</label>
                        <input asp-for="LicenseCode" class="form-control" />
                        <span asp-validation-for="LicenseCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="AttributionText" class="form-label">來源文字說明</label>
                        <input asp-for="AttributionText" class="form-control" />
                        <span asp-validation-for="AttributionText" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <h3 class="qmah-form-section-title border-bottom pb-2 mb-0">圖片與狀態</h3>
                    </div>

                    <div class="col-12">
                        <label asp-for="PrimaryImagePath" class="form-label">主要圖片路徑</label>
                        <input asp-for="PrimaryImagePath"
                               class="form-control"
                               type="text"
                               data-artifact-primary-image />
                        <span asp-validation-for="PrimaryImagePath" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ThumbnailPath" class="form-label">縮圖路徑</label>
                        <input asp-for="ThumbnailPath"
                               class="form-control"
                               type="text"
                               data-artifact-thumbnail-image />
                        <span asp-validation-for="ThumbnailPath" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <span class="form-check-label">啟用此圖鑑條目</span>
                        </label>
                    </div>
                </div>
            </div>

<div class="card-footer qmah-card-footer">
                <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>儲存文物
                </button>
            </div>
        </form>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card qmah-editor-preview mb-3">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">文物圖片</h2>
                    <div class="card-subtitle">主要圖片優先，未設定時使用縮圖。</div>
                </div>
            </div>

            <div class="qmah-editor-preview__stage">
                <img src="@previewPath"
                     alt="@Model.Name"
                     class="qmah-editor-preview__image"
                     data-artifact-image-preview
                     hidden="@string.IsNullOrWhiteSpace(previewPath)" />

                <button type="button"
                        class="qmah-editor-preview__zoom"
                        data-artifact-image-trigger
                        data-bs-toggle="modal"
                        data-bs-target="#qmah-image-preview"
                        data-qmah-image-preview="@previewPath"
                        data-qmah-image-preview-alt="@Model.Name"
                        aria-label="查看 @Model.Name 原圖"
                        hidden="@string.IsNullOrWhiteSpace(previewPath)">
                    <i class="ti ti-zoom-in" aria-hidden="true"></i>查看大圖
                </button>

                <div class="qmah-editor-preview__empty"
                     data-artifact-image-empty
                     hidden="@(!string.IsNullOrWhiteSpace(previewPath))">
                    <i class="ti ti-photo-off"></i>
                    <span>尚無可預覽圖片</span>
                </div>
            </div>

            <div class="qmah-editor-preview__meta">
                <span class="qmah-editor-preview__headline">@Model.Name</span>
                <span class="qmah-editor-preview__path"
                      data-artifact-image-path>
                    @(string.IsNullOrWhiteSpace(previewPath) ? "尚未設定圖片路徑" : previewPath)
                </span>
            </div>
        </div>

        <div class="card qmah-dashboard-note">
            <div class="card-body">
                <span class="qmah-status qmah-status--info">關聯資訊</span>

                <div class="datagrid mt-3">
                    <div class="datagrid-item">
                        <div class="datagrid-title">題庫關聯</div>
                        <div class="datagrid-content">
                            @if (Model.ArtifactQuestionEntry is null)
                            {
                                <span>未建立</span>
                            }
                            else
                            {
                                <a asp-area="Game"
                                   asp-controller="QuestionEntries"
                                   asp-action="Index"
                                   asp-route-search="@Model.ArtifactRef"
                                   class="text-decoration-none">
                                    已建立 · 難度 @Model.ArtifactQuestionEntry.Difficulty · @questionTemplateLabel
                                </a>
                            }
                        </div>
                    </div>

                    <div class="datagrid-item">
                        <div class="datagrid-title">解鎖紀錄</div>
                        <div class="datagrid-content">@Model.ArtifactUnlocks.Count 筆</div>
                    </div>

                    <div class="datagrid-item">
                        <div class="datagrid-title">目前狀態</div>
                        <div class="datagrid-content">@(Model.IsActive ? "啟用" : "停用")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Admin/_ImagePreviewModal" model="@("文物大圖")" />

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (() => {
            const primary = document.querySelector("[data-artifact-primary-image]");
            const thumbnail = document.querySelector("[data-artifact-thumbnail-image]");
            const preview = document.querySelector("[data-artifact-image-preview]");
            const trigger = document.querySelector("[data-artifact-image-trigger]");
            const empty = document.querySelector("[data-artifact-image-empty]");
            const pathLabel = document.querySelector("[data-artifact-image-path]");

            if (!primary || !thumbnail || !preview || !trigger || !empty || !pathLabel) {
                return;
            }

            const showEmpty = (text) => {
                preview.hidden = true;
                trigger.hidden = true;
                empty.hidden = false;
                empty.querySelector("span").textContent = text;
            };

            const updatePreview = () => {
                const path = primary.value.trim() || thumbnail.value.trim();
                pathLabel.textContent = path || "尚未設定圖片路徑";

                if (!path) {
                    preview.removeAttribute("src");
                    showEmpty("尚無可預覽圖片");
                    return;
                }

                preview.src = path;
                preview.hidden = false;
                trigger.dataset.qmahImagePreview = path;
                trigger.hidden = false;
                empty.hidden = true;
            };

            preview.addEventListener("error", () => showEmpty("圖片無法載入"));
            preview.addEventListener("load", () => {
                if (primary.value.trim() || thumbnail.value.trim()) {
                    preview.hidden = false;
                    trigger.hidden = false;
                    empty.hidden = true;
                }
            });

            primary.addEventListener("input", updatePreview);
            thumbnail.addEventListener("input", updatePreview);
        })();
    </script>
}
