@using System.Linq
@model IEnumerable<QMAH.Web.Models.Entities.Artifact>

@{
    ViewData["Title"] = "文物總覽";
    ViewData["AdminDescription"] = "搜尋、篩選並維護圖鑑中的文物主資料。";
    var keyword = Context.Request.Query["txtKeyword"].ToString();
    var records = Model?.ToList() ?? [];
}

@section PageActions {
    <a asp-area="Catalog" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-layout-dashboard me-1"></i>圖鑑管理總覽
    </a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-header">
        <div>
            <h2 class="card-title">文物資料篩選</h2>
            <div class="text-secondary">以名稱、館藏編號、分類或年代快速縮小清單。</div>
        </div>
        <span class="badge bg-blue-lt">@records.Count 筆結果</span>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-xl-5">
                    <label class="form-label" for="keyword">關鍵字</label>
                    <input class="form-control" id="keyword" name="txtKeyword" value="@keyword"
                           placeholder="文物名稱、館藏編號或年代文字" />
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" for="categoryId">分類</label>
                    <select class="form-select" id="categoryId" name="categoryId" asp-items="ViewBag.ArtifactCategoryList">
                        <option value="">全部分類</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" for="eraBucketId">年代</label>
                    <select class="form-select" id="eraBucketId" name="eraBucketId" asp-items="ViewBag.EraBucketList">
                        <option value="">全部年代</option>
                    </select>
                </div>
                <div class="col-12 col-xl-1 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill" title="搜尋">
                        <i class="ti ti-search"></i><span class="visually-hidden">搜尋</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="清除篩選">
                        <i class="ti ti-refresh"></i><span class="visually-hidden">清除</span>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">文物清單</h2>
            <div class="text-secondary">停用只會更新啟用狀態，不會刪除既有主資料。</div>
        </div>
    </div>

    @if (records.Count == 0)
    {
        <div class="empty py-5">
            <div class="empty-icon"><i class="ti ti-search-off"></i></div>
            <p class="empty-title">找不到符合條件的文物</p>
            <p class="empty-subtitle text-secondary">請調整關鍵字或篩選條件後再試一次。</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead>
                    <tr>
                        <th>文物</th>
                        <th>分類</th>
                        <th>年代</th>
                        <th>授權</th>
                        <th>狀態</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in records)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="avatar avatar-lg">
                                        <img src="@(item.ThumbnailPath ?? item.PrimaryImagePath)" alt="" loading="lazy" />
                                    </span>
                                    <div class="min-width-0">
                                        <div class="fw-semibold text-truncate" title="@item.Name">@item.Name</div>
                                        <div class="text-secondary small">@item.ArtifactRef</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(item.Category?.Name ?? "未分類")</td>
                            <td>
                                <div>@(item.EraBucket?.Name ?? "未標示")</div>
                                @if (!string.IsNullOrWhiteSpace(item.EraTextOriginal))
                                {
                                    <div class="text-secondary small">@item.EraTextOriginal</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary-lt">@(string.IsNullOrWhiteSpace(item.LicenseCode) ? "未標示" : item.LicenseCode)</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-green-lt">啟用</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">停用</span>
                                }
                            </td>
                            <td>
                                <div class="qmah-actions justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="ti ti-edit me-1"></i>編輯
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('確定要停用這筆文物嗎？')">
                                                <i class="ti ti-ban me-1"></i>停用
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
