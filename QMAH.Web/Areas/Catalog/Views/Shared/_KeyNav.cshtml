@model string
@{
    string Cls(string key) => Model == key ? "btn btn-secondary" : "btn btn-outline-secondary";
}
<div class="qmah-actions d-flex flex-wrap gap-2">
    <a asp-area="Catalog" asp-controller="Key" asp-action="Index" class="@Cls("key")"><i class="ti ti-key me-1"></i>鑰匙規則</a>
    <a asp-area="Catalog" asp-controller="KeyBackpack" asp-action="Index" class="@Cls("backpack")"><i class="ti ti-backpack me-1"></i>鑰匙背包</a>
    <a asp-area="Catalog" asp-controller="UnlockStatus" asp-action="Index" class="@Cls("unlock")"><i class="ti ti-lock-open me-1"></i>解鎖狀態</a>
    <a asp-area="Catalog" asp-controller="KeyExchange" asp-action="Index" class="@Cls("exchange")"><i class="ti ti-arrows-exchange me-1"></i>鑰匙兌換</a>
    <a asp-area="Catalog" asp-controller="KeyTransactions" asp-action="Index" class="@Cls("transactions")"><i class="ti ti-receipt me-1"></i>鑰匙流水</a>
    <a asp-area="" asp-controller="Operations" asp-action="EconomyBatches" class="btn btn-outline-secondary"><i class="ti ti-arrows-exchange me-1"></i>批次資產活動</a>
</div>
