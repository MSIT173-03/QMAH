@using QMAH.Web.Infrastructure.AdminNavigation
@inject AdminNavigationService AdminNavigation
@model QMAH.Web.Areas.Catalog.ViewModel.CatalogDashboardViewModel

@{
    ViewData["Title"] = "圖鑑總覽";
    ViewData["AdminDescription"] = "集中掌握文物、分類、年代、鑰匙規則與會員解鎖進度。";

    var workspaceItems = AdminNavigation.GetAreaItems("Catalog");

    string WorkspaceDescription(string controller) => controller switch
    {
        "Artifact" => "搜尋、篩選與維護文物資料",
        "Key" => "管理鑰匙規則與適用範圍",
        "KeyBackPack" => "查看與調整會員鑰匙餘額",
        "KeyBackpack" => "查看與調整會員鑰匙餘額",
        "KeyTransactions" => "追蹤發放、調整與消耗紀錄",
        _ => "進入此管理功能"
    };
}

@section PageActions {
    <a asp-area="Catalog" asp-controller="Artifact" asp-action="Index" class="btn btn-primary">
        <i class="ti ti-photo me-1"></i>文物管理
    </a>
}

<div class="qmah-area-overview">
    <section class="qmah-area-metrics qmah-area-metrics--5" aria-label="圖鑑資料摘要">
        <article class="qmah-area-metric">
            <span class="qmah-area-metric__icon"><i class="ti ti-photo"></i></span>
            <div><span class="qmah-area-metric__label">文物總數</span><strong class="qmah-area-metric__value">@Model.ArtifactCount</strong><span class="qmah-area-metric__note">已啟用 @Model.ActiveArtifactCount 件</span></div>
        </article>
        <article class="qmah-area-metric">
            <span class="qmah-area-metric__icon"><i class="ti ti-category"></i></span>
            <div><span class="qmah-area-metric__label">分類數量</span><strong class="qmah-area-metric__value">@Model.CategoryCount</strong><span class="qmah-area-metric__note">目前圖鑑分類</span></div>
        </article>
        <article class="qmah-area-metric">
            <span class="qmah-area-metric__icon"><i class="ti ti-clock"></i></span>
            <div><span class="qmah-area-metric__label">年代區間</span><strong class="qmah-area-metric__value">@Model.EraBucketCount</strong><span class="qmah-area-metric__note">目前年代設定</span></div>
        </article>
        <article class="qmah-area-metric">
            <span class="qmah-area-metric__icon"><i class="ti ti-key"></i></span>
            <div><span class="qmah-area-metric__label">鑰匙規則</span><strong class="qmah-area-metric__value">@Model.KeyDefinitionCount</strong><span class="qmah-area-metric__note">圖鑑解鎖設定</span></div>
        </article>
        <article class="qmah-area-metric">
            <span class="qmah-area-metric__icon"><i class="ti ti-lock-open"></i></span>
            <div><span class="qmah-area-metric__label">解鎖紀錄</span><strong class="qmah-area-metric__value">@Model.UnlockCount</strong><span class="qmah-area-metric__note">會員圖鑑進度</span></div>
        </article>
    </section>

    <div class="qmah-area-overview-grid">
        <section class="card qmah-area-card qmah-area-workbench">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">圖鑑工作區</h2>
                    <div class="card-subtitle">依用途進入圖鑑相關管理功能。</div>
                </div>
            </div>
            <div class="card-body">
                <div class="qmah-area-tile-grid">
                    @foreach (var item in workspaceItems)
                    {
                        <a class="qmah-area-action"
                           asp-area="Catalog"
                           asp-controller="@item.Controller"
                           asp-action="Index">
                            <span class="qmah-area-action__icon">
                                <partial name="Admin/_Icon" model="@item.Controller" />
                            </span>
                            <span>
                                <strong>@item.Label</strong>
                                <small>@WorkspaceDescription(item.Controller)</small>
                            </span>
                            <i class="ti ti-chevron-right qmah-area-action__arrow" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="card qmah-area-card">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">最近解鎖</h2>
                    <div class="card-subtitle">會員最近取得的圖鑑進度。</div>
                </div>
            </div>
            @if (Model.RecentUnlocks.Count == 0)
            {
                <div class="empty py-5">
                    <div class="empty-icon"><i class="ti ti-inbox"></i></div>
                    <p class="empty-title">目前沒有解鎖紀錄</p>
                    <p class="empty-subtitle text-secondary">完成圖鑑解鎖後會顯示在這裡。</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush qmah-area-list">
                    @foreach (var item in Model.RecentUnlocks)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between gap-3">
                                <strong>@item.ArtifactName</strong>
                                <span class="badge bg-blue-lt">@(item.UnlockMethod switch { "KEY" => "鑰匙", "GAME" => "遊戲", _ => item.UnlockMethod })</span>
                            </div>
                            <div class="text-secondary small mt-1">@item.UnlockedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <div class="qmah-area-detail-grid qmah-area-detail-grid--3">
        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">分類分布</h2><div class="card-subtitle">各分類的文物數量與啟用狀態。</div></div></div>
            @if (Model.CategoryBreakdown.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有分類資料</p></div>
            }
            else
            {
                <div class="list-group list-group-flush qmah-area-list">
                    @foreach (var item in Model.CategoryBreakdown)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div><div class="fw-semibold">@item.Name</div><div class="text-secondary small">已啟用 @item.ActiveCount 件</div></div>
                            <span class="badge bg-blue-lt">@item.Count 件</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">年代分布</h2><div class="card-subtitle">各年代區間的文物數量與啟用狀態。</div></div></div>
            @if (Model.EraBreakdown.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有年代資料</p></div>
            }
            else
            {
                <div class="list-group list-group-flush qmah-area-list">
                    @foreach (var item in Model.EraBreakdown)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div><div class="fw-semibold">@item.Name</div><div class="text-secondary small">已啟用 @item.ActiveCount 件</div></div>
                            <span class="badge bg-secondary-lt">@item.Count 件</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card qmah-area-card">
            <div class="card-header"><div><h2 class="card-title mb-1">鑰匙範圍</h2><div class="card-subtitle">依適用範圍整理目前的鑰匙規則。</div></div></div>
            @if (Model.KeyScopeBreakdown.Count == 0)
            {
                <div class="empty py-5"><p class="empty-title">目前沒有鑰匙規則</p></div>
            }
            else
            {
                <div class="list-group list-group-flush qmah-area-list">
                    @foreach (var item in Model.KeyScopeBreakdown)
                    {
                        var scopeLabel = item.Name switch
                        {
                            "GLOBAL" => "全域",
                            "CATEGORY" => "分類",
                            "ERA" => "年代",
                            "ARTIFACT" => "指定文物",
                            _ => item.Name
                        };

                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div><div class="fw-semibold">@scopeLabel</div><div class="text-secondary small">已啟用 @item.ActiveCount 條</div></div>
                            <span class="badge bg-green-lt">@item.Count 條</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
