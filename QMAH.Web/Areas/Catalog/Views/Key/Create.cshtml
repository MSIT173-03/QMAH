@model QMAH.Web.Models.Entities.KeyDefinition

<style>

    /* 排版樣式 */
    .editor-card {
        width: 500px;
        background: #1c2835;
        border: 1px solid #304452;
        border-radius: 7px;
        padding: 10px;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px solid #304452;
        background: #1a2632;
    }

    /* Button樣式 */
    .btn-cancel {
        background: transparent;
        border: none;
        color: #76aabd;
        font-size: 12px;
        padding: 8px 12px;
    }

    .btn-save {
        background: #79b0c4;
        border: 1px solid #79b0c4;
        color: #102027;
        border-radius: 5px;
        padding: 8px 15px;
        font-size: 12px;
        font-weight: 700;
    }


    /* IsActivate樣式 */
    .form-label-custom {
        display: block;
        margin-bottom: 6px;
        font-size: 11px;
        color: #bdd0d7;
        font-weight: 600;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 15px;
    }

    .switch-container {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 5px;
    }

    .text-danger {
        font-size: 10px;
    }

</style>


@{
    ViewData["Title"] = "新增鑰匙";
}

<h1>鑰匙資訊</h1>


<hr />

@* 錯誤訊息，選填資料與所選Scope type不同。 *@
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" style="width:auto">
        @ViewBag.ErrorMessage
    </div>
}

<div class="editor-card">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label">鑰匙名稱</label>
                <br /><br />
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Code" class="control-label"></label>
                <br /><br />
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="ScopeType" class="control-label"></label>
                <br /><br />
                <input asp-for="ScopeType" class="form-control" />
                <span asp-validation-for="ScopeType" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">類別</label>
                <br /><br />
                <select name="categoryId" id="cat" asp-items="ViewBag.ArtifactCategoriesList"
                        class="form-control bar_edit">
                    <option value="" class="midddle_text">-- 請選擇 --</option>
                </select>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="EraBucketId" class="control-label">年代</label>
                <br /><br />
                <select name="eraBucketId" id="cat" asp-items="ViewBag.EraBucketList"
                        class="form-control bar_edit">
                    <option value="" class="midddle_text">-- 請選擇 --</option>
                </select>
            </div>

            <br />

            <div class="form-row">

                <div>

                    <label asp-for="IsActive" class="control-label">啟用狀態</label>

                    <br/><br/>

                    <div class="switch-container">

                        <input asp-for="IsActive" class="form-check-input" style="width:40px" type="checkbox" />

                        <span style="font-size:10px;">啟用此圖鑑條目</span>

                    </div>

                    <span asp-validation-for="IsActive" class="text-danger"></span>

                </div>

            </div>

            <br />

            <div class="form-footer">

                <a asp-action="Index" class="btn-cancel">取消</a>

                <button type="submit" class="btn-save">儲存</button>

            </div>
        </form>
    </div>
</div>