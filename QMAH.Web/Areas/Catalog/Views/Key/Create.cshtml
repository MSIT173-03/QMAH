@model QMAH.Web.Models.Entities.KeyDefinition

@{
    ViewData["Title"] = "新增鑰匙";
    ViewData["AdminDescription"] = "建立圖鑑解鎖規則，設定適用的解鎖範圍。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回鑰匙總覽
    </a>
}

@if (ViewBag.ErrorMessage is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@errorMessage
    </div>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
        <form asp-action="Create" method="post" class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">鑰匙資訊</h2>
                    <div class="text-secondary">建立後可在鑰匙總覽繼續調整規則。</div>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">鑰匙名稱</label>
                        <input asp-for="Name" class="form-control" placeholder="例如：青銅器鑑定鑰匙" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Code" class="form-label">鑰匙代碼</label>
                        <input asp-for="Code" class="form-control" placeholder="例如：KEY_BRONZE" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ScopeType" class="form-label">適用範圍</label>
                        <input asp-for="ScopeType" class="form-control" placeholder="例如：CATEGORY、ERA 或 GLOBAL" />
                        <span asp-validation-for="ScopeType" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="form-label">分類</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.ArtifactCategoryList" class="form-select">
                            <option value="">不限定分類</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="EraBucketId" class="form-label">年代</label>
                        <select asp-for="EraBucketId" asp-items="ViewBag.EraBucketList" class="form-select">
                            <option value="">不限定年代</option>
                        </select>
                        <span asp-validation-for="EraBucketId" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <span class="form-check-label">啟用此鑰匙規則</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存鑰匙</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card h-100 qmah-dashboard-note">
            <div class="card-body">
                <span class="qmah-status qmah-status--info">設定提示</span>
                <h2 class="card-title mt-3">先決定解鎖範圍</h2>
                <p class="text-secondary mb-0">Scope 會決定鑰匙套用到全域、特定分類或特定年代；分類與年代留空時，代表不限制該條件。</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
