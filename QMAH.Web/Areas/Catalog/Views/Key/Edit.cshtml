@model QMAH.Web.Models.Entities.KeyDefinition

@{
    ViewData["Title"] = "鑰匙編輯";
    ViewData["AdminDescription"] = "調整既有解鎖規則的名稱與適用範圍。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回鑰匙總覽
    </a>
}

@if (ViewBag.ErrorMessage is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@errorMessage
    </div>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
        <form asp-action="Edit" method="post" class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">鑰匙資訊</h2>
                    <div class="text-secondary">代碼通常是系統識別值，修改前請確認沒有外部資料依賴。</div>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">鑰匙名稱</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Code" class="form-label">鑰匙代碼</label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ScopeType" class="form-label">適用範圍</label>
                        <input asp-for="ScopeType" class="form-control" />
                        <span asp-validation-for="ScopeType" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="form-label">分類</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.ArtifactCategoryList" class="form-select">
                            <option value="">不限定分類</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="EraBucketId" class="form-label">年代</label>
                        <select asp-for="EraBucketId" asp-items="ViewBag.EraBucketList" class="form-select">
                            <option value="">不限定年代</option>
                        </select>
                        <span asp-validation-for="EraBucketId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存變更</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
