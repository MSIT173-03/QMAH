@using System.Linq
@model IEnumerable<QMAH.Web.Models.Entities.KeyDefinition>

@{
    ViewData["Title"] = "鑰匙總覽";
    ViewData["AdminDescription"] = "維護圖鑑解鎖規則，以及分類與年代的適用範圍。";
    var records = Model?.ToList() ?? [];
}

@section PageActions {
    <div class="qmah-actions">
        <a asp-area="Catalog" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-layout-dashboard me-1"></i>圖鑑管理總覽
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>新增鑰匙
        </a>
    </div>
}

<div class="card">
    <div class="card-header">
        <div>
            <h2 class="card-title">解鎖規則</h2>
            <div class="text-secondary">共 @records.Count 筆規則；停用後仍保留歷史交易關聯。</div>
        </div>
    </div>

    @if (records.Count == 0)
    {
        <div class="empty py-5">
            <div class="empty-icon"><i class="ti ti-key-off"></i></div>
            <p class="empty-title">目前沒有鑰匙規則</p>
            <p class="empty-subtitle text-secondary">建立第一把鑰匙後，才能讓解鎖流程使用。</p>
            <div class="empty-action">
                <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增鑰匙</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead>
                    <tr>
                        <th>鑰匙</th>
                        <th>適用範圍</th>
                        <th>分類</th>
                        <th>年代</th>
                        <th>狀態</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in records)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Name</div>
                                <div class="text-secondary small">@item.Code</div>
                            </td>
                            <td><span class="badge bg-blue-lt">@AdminDisplayLabels.Scope(item.ScopeType)</span></td>
                            <td>@(item.Category?.Name ?? "全域")</td>
                            <td>@(item.EraBucket?.Name ?? "全域")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-green-lt">啟用</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">停用</span>
                                }
                            </td>
                            <td>
                                <div class="qmah-actions justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="ti ti-edit me-1"></i>編輯
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('確定要停用這把鑰匙嗎？')">
                                                <i class="ti ti-ban me-1"></i>停用
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
