@model IEnumerable<QMAH.Web.Models.Entities.KeyDefinition>

<style>

    /*按鈕樣式 */
    .btn_edit {
        font-size: 30px;
        border: solid 5px seagreen;
        background-color: seagreen;
        border-radius: 5px;
        padding: 2px;
    }

    /*標題樣式 */
    .midddle_title {
        margin: auto;
        text-align: center;
        font-size: 3em;
    }

    /*內文樣式 */
    .midddle_text {
        text-align: center;
    }

    th {
        text-align: center;
        border: solid 2px #336b59;
    }

    td {
        border: solid 2px #336b59;
    }


    /*標頭樣式 */
    #keyTable thead th {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        #keyTable thead th:hover {
            background-color: #2c4f50;
        }
</style>



@{
    ViewData["Title"] = "鑰匙總覽";
}


<h1 class="midddle_title">-鑰匙清單-</h1>
<br />
<br />

<p>
    <button type="button" class="btn btn_edit" onclick="location.href='@Url.Action("Create", "Key")'">創建鑰匙</button>
</p>

<table class="table" id="keyTable">
    <thead>
        <tr>
            <th style="width : 5%;" data-column="0">
                序
            </th>
            <th style="width: 20%;" data-column="1">
                鑰匙名稱
            </th>
            <th style="width: 20%;" data-column="2">
                鑰匙代碼
            </th>
            <th style="width: 20%;" data-column="3">
                鑰匙類型
            </th>
            <th style="width: 10%;" data-column="4">
                鑰匙類別
            </th>
            <th style="width: 10%;" data-column="5">
                鑰匙年代
            </th>
            <th style="width: 5%;">
                啟用狀態
            </th>
            <th style="width : 10%;">編輯</th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = 0;
            foreach (var item in Model)
            {
                count++;
                <tr>
                    <td class="midddle_text">
                        @count
                    </td>
                    <td class="midddle_text">
                        @Html.DisplayFor(model => item.Name)
                    </td>
                    <td class="midddle_text">
                        @Html.DisplayFor(model => item.Code)
                    </td>
                    <td class="midddle_text">
                        @Html.DisplayFor(model => item.ScopeType)
                    </td>
                    <td class="midddle_text">
                        @Html.DisplayFor(model => item.Category.Name)
                    </td>
                    <td class="midddle_text">
                        @Html.DisplayFor(model => item.EraBucket.Name)
                    </td>
                    <td class="midddle_text">
                        @Html.DisplayFor(model => item.IsActive)
                    </td>
                    <td class="midddle_text" style="font-size : 20px;">
                        <a asp-action="Edit" asp-route-id="@item.Id">編輯</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('確定要刪除嗎?')">刪除</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    const table = document.getElementById("keyTable");
    const headers = table.querySelectorAll("thead th");

    let sortColumn = -1;
    let sortAscending = true;

    headers.forEach(header => {

        header.style.cursor = "pointer";

        header.addEventListener("click", function() {

            const column = parseInt(this.dataset.column);

            if (sortColumn === column) {
                sortAscending = !sortAscending;
            } else {
                sortColumn = column;
                sortAscending = true;
            }

            const tbody = table.querySelector("tbody");
            const rows = Array.from(tbody.querySelectorAll("tr"));

            rows.sort((a, b) => {

                const valueA = a.children[column].textContent.trim();
                const valueB = b.children[column].textContent.trim();

                const numberA = Number(valueA);
                const numberB = Number(valueB);

                if (!isNaN(numberA) && !isNaN(numberB)) {
                    return sortAscending
                        ? numberA - numberB
                        : numberB - numberA;
                }

                return sortAscending
                    ? valueA.localeCompare(valueB)
                    : valueB.localeCompare(valueA);
            });

            rows.forEach(row => tbody.appendChild(row));

            headers.forEach(h => {
                h.textContent = h.textContent
                    .replace(" ↑", "")
                    .replace(" ↓", "");
            });

            this.textContent += sortAscending ? " ↑" : " ↓";
        });
    });
</script>