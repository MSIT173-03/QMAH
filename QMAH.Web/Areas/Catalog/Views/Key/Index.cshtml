@using System.Linq
@model IEnumerable<QMAH.Infrastructure.Models.Entities.KeyDefinition>

@{
    ViewData["Title"] = "鑰匙規則";
    ViewData["AdminDescription"] = "維護圖鑑解鎖規則，以及分類與年代的適用範圍。";
    var records = Model?.ToList() ?? [];
    var activeCount = records.Count(item => item.IsActive);
    var inactiveCount = records.Count - activeCount;
}

@section PageActions {
    <div class="qmah-actions d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>新增鑰匙規則
        </a>
        <a asp-area="Catalog" asp-controller="Key" asp-action="Index" class="btn btn-secondary">
            <i class="ti ti-key me-1"></i>鑰匙規則
        </a>
        <a asp-area="Catalog" asp-controller="KeyBackpack" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-backpack me-1"></i>鑰匙背包
        </a>
        <a asp-area="Catalog" asp-controller="KeyTransactions" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-receipt me-1"></i>鑰匙流水
        </a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="text-secondary mb-1">規則總數</div>
                    <div class="h2 mb-0">@records.Count</div>
                </div>
                <div class="text-primary fs-1">
                    <i class="ti ti-key"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="text-secondary mb-1">啟用中</div>
                    <div class="h2 mb-0 text-success">@activeCount</div>
                </div>
                <div class="text-success fs-1">
                    <i class="ti ti-circle-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div>
                    <div class="text-secondary mb-1">已停用</div>
                    <div class="h2 mb-0 text-secondary">@inactiveCount</div>
                </div>
                <div class="text-secondary fs-1">
                    <i class="ti ti-ban"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">解鎖規則</h2>
            <div class="card-subtitle">停用規則仍會保留既有背包與歷史交易關聯。</div>
        </div>
    </div>

    @if (records.Count == 0)
    {
        <div class="empty py-5">
            <div class="empty-icon"><i class="ti ti-key-off"></i></div>
            <p class="empty-title">目前沒有鑰匙規則</p>
            <p class="empty-subtitle text-secondary">建立第一把鑰匙後，才能讓解鎖流程使用。</p>
            <div class="empty-action">
                <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增鑰匙</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead>
                    <tr>
                        <th>名稱</th>
                        <th>代號</th>
                        <th>適用範圍</th>
                        <th>分類</th>
                        <th>年代</th>
                        <th>狀態</th>
                        <th class="w-1 text-center pe-3 pe-md-4">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in records)
                    {
                        <tr>
                            <td><div class="fw-semibold">@item.Name</div></td>
                            <td><code class="text-secondary">@item.Code</code></td>
                            <td><span class="badge bg-blue-lt">@AdminDisplayLabels.Scope(item.ScopeType)</span></td>
                            <td>@(item.Category?.Name ?? "全域")</td>
                            <td>@(item.EraBucket?.Name ?? "全域")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-green-lt">啟用</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">停用</span>
                                }
                            </td>
                            <td class="text-center pe-3 pe-md-4">
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-3">
                                        <i class="ti ti-edit me-1"></i>編輯
                                    </a>
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm px-3 @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                onclick="return confirm('@(item.IsActive ? "確定要停用這把鑰匙嗎？" : "確定要重新啟用這把鑰匙嗎？")')">
                                            <i class="ti @(item.IsActive ? "ti-ban" : "ti-check") me-1"></i>@(item.IsActive ? "停用" : "啟用")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
