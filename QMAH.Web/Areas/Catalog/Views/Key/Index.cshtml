@using System.Linq
@model IEnumerable<QMAH.Web.Models.Entities.KeyDefinition>

@{
    ViewData["Title"] = "鑰匙總覽";
    ViewData["AdminDescription"] = "維護圖鑑解鎖規則，以及分類與年代的適用範圍。";
    var records = Model?.ToList() ?? [];
}

@section PageActions {
    <a asp-area="Catalog" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="ti ti-layout-dashboard me-1"></i>圖鑑管理總覽
    </a>
    <a asp-action="Create" class="btn btn-primary">
        <i class="ti ti-plus me-1"></i>新增鑰匙
    </a>
}

<div class="card qmah-list-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">解鎖規則</h2>
            <div class="text-secondary">共 @records.Count 筆規則；停用不會刪除既有關聯。</div>
        </div>
    </div>

    @if (records.Count == 0)
    {
        <div class="empty py-5">
            <div class="empty-icon"><i class="ti ti-key-off"></i></div>
            <p class="empty-title">目前沒有鑰匙規則</p>
            <p class="empty-subtitle text-secondary">新增鑰匙後即可設定圖鑑解鎖範圍。</p>
            <div class="empty-action">
                <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增鑰匙</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead>
                    <tr>
                        <th>名稱</th>
                        <th>代號</th>
                        <th>適用範圍</th>
                        <th>分類</th>
                        <th>年代</th>
                        <th>狀態</th>
                        <th class="qmah-action-cell qmah-actions--2">操作</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in records)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td><code class="text-secondary">@item.Code</code></td>
                        <td><span class="badge bg-blue-lt">@AdminDisplayLabels.Scope(item.ScopeType)</span></td>
                        <td>@(item.Category?.Name ?? "全域")</td>
                        <td>@(item.EraBucket?.Name ?? "全域")</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-green-lt" : "bg-secondary-lt")">
                                @(item.IsActive ? "啟用" : "停用")
                            </span>
                        </td>
                        <td class="qmah-action-cell qmah-actions--2">
                            <div class="qmah-table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">編輯
                                </a>
                                <form asp-action="ToggleActive" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success")"
                                            onclick="return confirm('@(item.IsActive ? "確定要停用這把鑰匙嗎？" : "確定要重新啟用這把鑰匙嗎？")')">
                                        @(item.IsActive ? "停用" : "啟用")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
