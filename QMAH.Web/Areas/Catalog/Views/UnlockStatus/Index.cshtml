@{
    ViewData["Title"] = "解鎖狀態";
    ViewData["AdminDescription"] = "檢視會員的圖鑑解鎖進度，依分類重置並退還鑰匙，或補解鎖。";
    var owners = ViewBag.Owners as List<QMAH.Web.Areas.Catalog.Controllers.UnlockOwnerRow> ?? [];
    var stats = ViewBag.UnlockStats as List<QMAH.Web.Areas.Catalog.Controllers.UnlockCategoryStat> ?? [];
    Guid? selectedUserId = ViewBag.SelectedUserId is Guid id ? id : null;
    var selectedNickname = ViewBag.SelectedNickname as string ?? "未命名會員";
    int totalArtifacts = ViewBag.TotalArtifacts ?? 0;
}

@section PageActions {
    @await Html.PartialAsync("_KeyNav", "unlock")
}

@if (!selectedUserId.HasValue)
{
    <div class="card qmah-filter-panel mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-9"><input type="text" name="txtKeyword" value="@ViewBag.Keyword" class="form-control" placeholder="搜尋會員暱稱、帳號或 Email" /></div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill"><i class="ti ti-search me-1"></i>搜尋</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">清除</a>
                </div>
            </form>
        </div>
    </div>
    <div class="card qmah-list-card">
        <div class="card-header"><div><h2 class="card-title">會員解鎖進度</h2><div class="card-subtitle">管理員排在前面，其餘依註冊順序。圖鑑共 @totalArtifacts 件文物。</div></div></div>
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead><tr><th>會員</th><th>已解鎖</th><th>可退鑰匙</th><th class="text-center pe-3 pe-md-4">操作</th></tr></thead>
                <tbody>
                @foreach (var owner in owners)
                {
                    <tr>
                        <td><div class="fw-semibold">@(string.IsNullOrWhiteSpace(owner.Nickname) ? owner.Email ?? "未命名會員" : owner.Nickname)</div>
                            @if (!string.IsNullOrWhiteSpace(owner.Nickname)) { <div class="text-secondary small">@owner.Email</div> }</td>
                        <td>@owner.Unlocked／@totalArtifacts</td>
                        <td>@owner.Refundable</td>
                        <td class="text-center pe-3 pe-md-4"><a asp-action="Index" asp-route-userId="@owner.Id" class="btn btn-sm btn-primary px-3"><i class="ti ti-lock-open me-1"></i>查看解鎖</a></td>
                    </tr>
                }
                @if (owners.Count == 0) { <tr><td colspan="4" class="text-center text-secondary py-4">沒有符合的會員</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card qmah-list-card">
        <div class="card-header qmah-crud-toolbar">
            <div>
                <h2 class="card-title">@selectedNickname 的解鎖狀態</h2>
                <div class="card-subtitle">已解鎖 @stats.Sum(x => x.Unlocked)／@totalArtifacts。清除時當初用鑰匙解鎖的會退回背包並留下流水「後台返還鑰匙（清除解鎖）」，遊戲獎勵與管理員解鎖不退。</div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="KeyBackpack" asp-action="Index" asp-route-userId="@selectedUserId" class="btn btn-outline-secondary"><i class="ti ti-backpack me-1"></i>查看背包</a>
                <form method="post" asp-action="Reset" onsubmit="return confirm('清除 @selectedNickname 的全部解鎖並退還鑰匙？');">
                    <input type="hidden" name="userId" value="@selectedUserId" />
                    <button class="btn btn-outline-danger" type="submit" disabled="@(stats.Sum(x => x.Unlocked) == 0)"><i class="ti ti-lock me-1"></i>清除全部並退鑰匙</button>
                </form>
                <form method="post" asp-action="Grant" onsubmit="return confirm('替 @selectedNickname 解鎖全部尚未解鎖的文物（不扣鑰匙）？');">
                    <input type="hidden" name="userId" value="@selectedUserId" />
                    <button class="btn btn-outline-primary" type="submit"><i class="ti ti-lock-open me-1"></i>全部解鎖</button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回會員清單</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead><tr><th>圖鑑分類</th><th>已解鎖／總數</th><th>可退鑰匙</th><th class="text-center pe-3 pe-md-4">操作</th></tr></thead>
                <tbody>
                @foreach (var stat in stats)
                {
                    <tr>
                        <td class="fw-semibold">@stat.Name</td>
                        <td>@stat.Unlocked／@stat.Total</td>
                        <td>@stat.Refundable</td>
                        <td class="text-center pe-3 pe-md-4">
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <a asp-action="Category" asp-route-userId="@selectedUserId" asp-route-categoryId="@stat.Id" class="btn btn-sm btn-primary px-3"><i class="ti ti-edit me-1"></i>逐件調整</a>
                                <form method="post" asp-action="Reset" onsubmit="return confirm('清除「@stat.Name」的 @stat.Unlocked 筆解鎖，退還 @stat.Refundable 把鑰匙？');">
                                    <input type="hidden" name="userId" value="@selectedUserId" /><input type="hidden" name="categoryId" value="@stat.Id" />
                                    <button class="btn btn-sm btn-outline-danger px-3" type="submit" disabled="@(stat.Unlocked == 0)">清除並退鑰匙</button>
                                </form>
                                <form method="post" asp-action="Grant">
                                    <input type="hidden" name="userId" value="@selectedUserId" /><input type="hidden" name="categoryId" value="@stat.Id" />
                                    <button class="btn btn-sm btn-outline-secondary px-3" type="submit" disabled="@(stat.Unlocked >= stat.Total)">解鎖此分類</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
