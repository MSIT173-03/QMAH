@model QMAH.Web.Models.Entities.UserKeyBalance

@{
    ViewData["Title"] = "新增背包紀錄";
    ViewData["AdminDescription"] = "為會員新增鑰匙餘額；若已有同一組關聯，系統會累加數量。";
    Guid? returnUserId = ViewBag.ReturnUserId is Guid id ? id : null;
}

@section PageActions {
    <a asp-action="Index" asp-route-userId="@returnUserId" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回鑰匙背包
    </a>
}

@if (ViewBag.ErrorMessage is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@errorMessage
    </div>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
        <form asp-action="Create" method="post" class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">新增會員鑰匙</h2>
                    <div class="text-secondary">請選擇會員與鑰匙，再輸入要增加的數量。</div>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="UserId" class="form-label">會員</label>
                        <select name="userId" id="userId" asp-items="ViewBag.UserProfileList" class="form-select">
                            <option value="">請選擇會員</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="KeyDefinitionId" class="form-label">鑰匙種類</label>
                        <select name="keydefinitionId" id="keydefinitionId" asp-items="ViewBag.KeyDefinitionList" class="form-select">
                            <option value="">請選擇鑰匙</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Balance" class="form-label">增加數量</label>
                        <input asp-for="Balance" class="form-control" type="number" min="1" placeholder="例如：1" />
                        <span asp-validation-for="Balance" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" asp-route-userId="@returnUserId" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增紀錄</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card h-100 qmah-dashboard-note">
            <div class="card-body">
                <span class="qmah-status qmah-status--info">累加規則</span>
                <h2 class="card-title mt-3">同一組關聯會累加</h2>
                <p class="text-secondary mb-0">如果會員已經持有這把鑰匙，送出後會在原有餘額上增加數量，不會建立重複紀錄。</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
