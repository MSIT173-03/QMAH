@using System.Linq
@using QMAH.Web.Areas.Catalog.ViewModel
@model IEnumerable<UserKeyBalanceViewModel>

@{
    ViewData["Title"] = "鑰匙背包總覽";
    ViewData["AdminDescription"] = "查詢會員持有的鑰匙並調整目前餘額。";
    var keyword = Context.Request.Query["txtKeyword"].ToString();
    var records = Model?.ToList() ?? [];
    var selectedUserId = Context.Request.Query["userId"].ToString();
    var hasSelectedUser = Guid.TryParse(selectedUserId, out _);
    var memberKeyword = Context.Request.Query["memberKeyword"].ToString();
    var ownerSummaries = ViewBag.OwnerSummaries as IEnumerable<UserKeyOwnerSummaryViewModel> ?? [];
    var selectedRecord = records.FirstOrDefault();
}

@section PageActions {
    <a asp-area="Catalog" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="ti ti-layout-dashboard me-1"></i>圖鑑管理總覽
    </a>
    <a asp-controller="KeyBackPack" asp-action="Create" class="btn btn-primary">
        <i class="ti ti-plus me-1"></i>新增背包紀錄
    </a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                @if (!hasSelectedUser)
                {
                    <div class="col-12 col-lg">
                        <label class="form-label" for="memberKeyword">搜尋會員</label>
                        <input class="form-control" id="memberKeyword" name="memberKeyword"
                               value="@memberKeyword" placeholder="會員編號或暱稱" />
                    </div>
                }
                else
                {
                    <div class="col-12 col-lg-5">
                        <label class="form-label" for="userId">會員</label>
                        <select class="form-select" id="userId" name="userId"
                                asp-items="ViewBag.UserProfileList" required></select>
                    </div>
                    <div class="col-12 col-lg">
                        <label class="form-label" for="keyword">鑰匙名稱</label>
                        <input class="form-control" id="keyword" name="txtKeyword"
                               value="@keyword" placeholder="搜尋鑰匙名稱" />
                    </div>
                }

                <div class="col-12 col-lg-auto">
                    <div class="qmah-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-search me-1"></i>搜尋
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="ti ti-refresh me-1"></i>清除
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    @if (!hasSelectedUser)
    {
        <div class="card-header">
            <div>
                <h2 class="card-title">會員背包</h2>
                <div class="text-secondary">選擇會員後查看持有的鑰匙。</div>
            </div>
            <span class="badge bg-blue-lt">@ownerSummaries.Count() 位會員</span>
        </div>

        @if (!ownerSummaries.Any())
        {
            <div class="empty py-5">
                <div class="empty-icon"><i class="ti ti-user-search"></i></div>
                <p class="empty-title">找不到符合條件的會員</p>
                <p class="empty-subtitle text-secondary">請調整會員關鍵字後再試一次。</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table">
                    <thead>
                        <tr>
                            <th>會員</th>
                            <th>鑰匙種類</th>
                            <th>鑰匙總數</th>
                            <th class="qmah-action-cell qmah-actions--1">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var owner in ownerSummaries)
                    {
                        <tr>
                            <td class="qmah-member-cell">
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(owner.Nickname) ? "未命名會員" : owner.Nickname)
                                </div>
                                <div class="qmah-member-id">@owner.UserId</div>
                            </td>
                            <td>@owner.KeyTypeCount</td>
                            <td><span class="badge bg-green-lt">@owner.TotalBalance</span></td>
                            <td class="qmah-action-cell qmah-actions--1">
                                <div class="qmah-table-actions">
                                    <a asp-action="Index" asp-route-userId="@owner.UserId"
                                       class="btn btn-sm btn-outline-secondary">查看
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="card-header">
            <div>
                <h2 class="card-title">
                    @(selectedRecord is null || string.IsNullOrWhiteSpace(selectedRecord.Nickname)
                        ? "會員背包"
                        : $"{selectedRecord.Nickname} 的背包")
                </h2>
                <div class="text-secondary">共 @records.Count 筆鑰匙紀錄。</div>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-secondary">
                <i class="ti ti-arrow-left me-1"></i>返回會員清單
            </a>
        </div>

        @if (records.Count == 0)
        {
            <div class="empty py-5">
                <div class="empty-icon"><i class="ti ti-backpack-off"></i></div>
                <p class="empty-title">目前沒有符合條件的鑰匙</p>
                <p class="empty-subtitle text-secondary">可清除搜尋條件，或新增一筆背包紀錄。</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table">
                    <thead>
                        <tr>
                            <th>鑰匙</th>
                            <th>代號</th>
                            <th>餘額</th>
                            <th>最後更新</th>
                            <th class="qmah-action-cell qmah-actions--2">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in records)
                    {
                        <tr>
                            <td class="fw-semibold">@item.UserKeyBalance.KeyDefinition.Name</td>
                            <td><code class="text-secondary">@item.UserKeyBalance.KeyDefinition.Code</code></td>
                            <td>
                                <span class="badge @(item.UserKeyBalance.Balance > 0 ? "bg-green-lt" : "bg-secondary-lt")">
                                    @item.UserKeyBalance.Balance
                                </span>
                            </td>
                            <td class="text-secondary text-nowrap">
                                @item.UserKeyBalance.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
                            </td>
                            <td class="qmah-action-cell qmah-actions--2">
                                <div class="qmah-table-actions">
                                    <a asp-action="Edit"
                                       asp-route-userId="@item.UserKeyBalance.UserId"
                                       asp-route-keydefinitionId="@item.UserKeyBalance.KeyDefinitionId"
                                       class="btn btn-sm btn-outline-secondary">編輯
                                    </a>
                                    <form asp-action="Delete" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@item.UserKeyBalance.UserId" />
                                        <input type="hidden" name="keydefinitionId" value="@item.UserKeyBalance.KeyDefinitionId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('確定要刪除此筆背包紀錄嗎？')">
                                            刪除
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
