@using QMAH.Web.Areas.Catalog.ViewModel
@model IEnumerable<UserKeyBalanceViewModel>

@{
    ViewData["Title"] = "鑰匙背包";
    ViewData["AdminDescription"] = "查詢會員並查看持有的鑰匙餘額。";

    var records = Model?.ToList() ?? [];
    var ownerSummaries =
        ViewBag.OwnerSummaries as IEnumerable<UserKeyOwnerSummaryViewModel> ?? [];

    Guid? selectedUserId =
        ViewBag.SelectedUserId is Guid id ? id : null;

    var selectedNickname =
        ViewBag.SelectedNickname as string ?? "未命名會員";
}

@section PageActions {
    <div class="qmah-actions d-flex flex-wrap gap-2">
        <a asp-area="Catalog" asp-controller="Key" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-key me-1"></i>鑰匙規則
        </a>
        <a asp-area="Catalog" asp-controller="KeyBackpack" asp-action="Index" class="btn btn-secondary">
            <i class="ti ti-backpack me-1"></i>鑰匙背包
        </a>
        <a asp-area="Catalog" asp-controller="KeyExchange" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-arrows-exchange me-1"></i>鑰匙兌換
        </a>
        <a asp-area="Catalog" asp-controller="KeyTransactions" asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-receipt me-1"></i>鑰匙流水
        </a>
        <a asp-area="" asp-controller="Operations" asp-action="EconomyBatches" class="btn btn-outline-secondary">
            <i class="ti ti-arrows-exchange me-1"></i>批次資產活動
        </a>
    </div>
}

@if (!selectedUserId.HasValue)
{
    <div class="card qmah-filter-panel mb-3">
        <div class="card-header">
            <div>
                <h2 class="card-title">查詢會員背包</h2>
                    <div class="card-subtitle">依會員暱稱、Email 或會員編號搜尋。</div>
            </div>
        </div>

        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  class="qmah-filter-form">
                <div class="row g-2">
                    <div class="col-md-9">
                        <input type="text"
                               name="txtKeyword"
                               value="@ViewBag.Keyword"
                               class="form-control"
                               placeholder="搜尋會員暱稱、Email 或會員編號" />
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            <i class="ti ti-search me-1"></i>搜尋
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            清除
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card qmah-list-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">會員背包</h2>
                <div class="card-subtitle">
                    選擇會員後查看鑰匙餘額。
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table qmah-backpack-table">
                <colgroup>
                    <col class="qmah-col-owner" />
                    <col class="qmah-col-type" />
                    <col class="qmah-col-count" />
                    <col class="qmah-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>會員</th>
                        <th>鑰匙種類</th>
                        <th>鑰匙總數</th>
                        <th class="text-center pe-3 pe-md-4">操作</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!ownerSummaries.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty qmah-empty-state">
                                    <div class="empty-icon">
                                        <i class="ti ti-user-search"></i>
                                    </div>
                                    <p class="empty-title">
                                        目前沒有符合條件的會員
                                    </p>
                                    <p class="empty-subtitle text-secondary">
                                        請調整搜尋條件後再試一次。
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var owner in ownerSummaries)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(owner.Nickname)
                                            ? owner.Email ?? "未命名會員"
                                            : owner.Nickname)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(owner.Nickname))
                                    {
                                        <div class="text-secondary small">@owner.Email</div>
                                    }
                                </td>
                                <td>@owner.KeyTypeCount</td>
                                <td class="text-success fw-bold">
                                    @owner.TotalBalance
                                </td>
                                <td class="text-center pe-3 pe-md-4">
                                    <a asp-action="Index"
                                       asp-route-userId="@owner.UserId"
                                       class="btn btn-sm btn-primary px-3">
                                        <i class="ti ti-backpack me-1"></i>查看背包
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card qmah-list-card">
        <div class="card-header qmah-crud-toolbar">
            <div>
                <h2 class="card-title">@selectedNickname 的鑰匙背包</h2>
                <div class="card-subtitle">
                    共 @records.Count 種可操作鑰匙
                </div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i>返回會員清單
            </a>
        </div>

        @if (records.Count == 0)
        {
            <div class="empty py-5">
                <div class="empty-icon">
                    <i class="ti ti-backpack-off"></i>
                </div>
                <p class="empty-title">
                    目前沒有背包紀錄
                </p>
                <p class="empty-subtitle text-secondary">
                    目前沒有可操作的鑰匙定義。
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table qmah-crud-table">
                    <thead>
                        <tr>
                            <th>鑰匙</th>
                            <th>餘額</th>
                            <th>最後更新</th>
                            <th class="w-1 text-center pe-3 pe-md-4">操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in records)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @item.KeyName
                                    </div>
                                    <div class="text-secondary small">
                                        @item.KeyCode
                                        @if (!item.IsActive)
                                        {
                                            <span class="badge bg-secondary-lt ms-1">已停用，只可扣除</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <span class="badge @(item.Balance > 0
                                        ? "bg-green-lt"
                                        : "bg-secondary-lt")">
                                        @item.Balance
                                    </span>
                                </td>

                                <td>
                                    @(item.UpdatedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "尚無異動")
                                </td>

                                <td class="text-center pe-3 pe-md-4">
                                    <div class="d-flex flex-wrap justify-content-center gap-2">
                                        <a asp-action="Adjust"
                                           asp-route-userId="@item.UserId"
                                           asp-route-keyDefinitionId="@item.KeyDefinitionId"
                                           class="btn btn-sm btn-outline-secondary px-3">
                                            <i class="ti ti-adjustments me-1"></i>@(item.Balance == 0 ? "新增" : "調整")
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    var stats = ViewBag.UnlockStats as List<QMAH.Web.Areas.Catalog.Controllers.UnlockCategoryStat> ?? [];
    <div class="card qmah-list-card mt-3">
        <div class="card-header qmah-crud-toolbar">
            <div>
                <h2 class="card-title">圖鑑解鎖狀態</h2>
                <div class="card-subtitle">依圖鑑分類清除解鎖，當初用鑰匙解鎖的會退回上方背包並留下流水「後台返還鑰匙（清除解鎖）」。遊戲獎勵與管理員解鎖不退。</div>
            </div>
            <div class="d-flex gap-2">
                <form method="post" asp-action="ResetUnlocks" onsubmit="return confirm('清除 @selectedNickname 的全部解鎖並退還鑰匙？');">
                    <input type="hidden" name="userId" value="@selectedUserId" />
                    <button class="btn btn-outline-danger" type="submit" disabled="@(stats.Sum(x => x.Unlocked) == 0)"><i class="ti ti-lock me-1"></i>清除全部並退鑰匙</button>
                </form>
                <form method="post" asp-action="GrantUnlocks" onsubmit="return confirm('替 @selectedNickname 解鎖全部尚未解鎖的文物（不扣鑰匙）？');">
                    <input type="hidden" name="userId" value="@selectedUserId" />
                    <button class="btn btn-outline-primary" type="submit"><i class="ti ti-lock-open me-1"></i>全部解鎖</button>
                </form>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead><tr><th>圖鑑分類</th><th>已解鎖／總數</th><th>可退鑰匙</th><th class="text-center pe-3 pe-md-4">操作</th></tr></thead>
                <tbody>
                @foreach (var stat in stats)
                {
                    <tr>
                        <td class="fw-semibold">@stat.Name</td>
                        <td>@stat.Unlocked／@stat.Total</td>
                        <td>@stat.Refundable</td>
                        <td class="text-center pe-3 pe-md-4">
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <form method="post" asp-action="ResetUnlocks" onsubmit="return confirm('清除「@stat.Name」的 @stat.Unlocked 筆解鎖，退還 @stat.Refundable 把鑰匙？');">
                                    <input type="hidden" name="userId" value="@selectedUserId" /><input type="hidden" name="categoryId" value="@stat.Id" />
                                    <button class="btn btn-sm btn-outline-danger px-3" type="submit" disabled="@(stat.Unlocked == 0)">清除並退鑰匙</button>
                                </form>
                                <form method="post" asp-action="GrantUnlocks">
                                    <input type="hidden" name="userId" value="@selectedUserId" /><input type="hidden" name="categoryId" value="@stat.Id" />
                                    <button class="btn btn-sm btn-outline-secondary px-3" type="submit" disabled="@(stat.Unlocked >= stat.Total)">解鎖此分類</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
