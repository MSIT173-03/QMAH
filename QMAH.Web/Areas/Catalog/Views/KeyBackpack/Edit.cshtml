@model QMAH.Web.Models.Entities.UserKeyBalance

@{
    ViewData["Title"] = "背包編輯";
    ViewData["AdminDescription"] = "調整會員目前持有的鑰匙與餘額。";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回鑰匙背包總覽
    </a>
}

@if (ViewBag.ErrorMessage is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@errorMessage
    </div>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
        <form asp-action="Edit" method="post" class="card">
            <div class="card-header">
                <div>
                    <h2 class="card-title">會員背包資訊</h2>
                    <div class="text-secondary">儲存後會更新最後異動時間。</div>
                </div>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="UserId" class="form-label">會員</label>
                        <select name="userId" id="userId" asp-items="ViewBag.UserProfileList" class="form-select">
                            <option value="">請選擇會員</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="KeyDefinitionId" class="form-label">鑰匙種類</label>
                        <select name="keydefinitionId" id="keydefinitionId" asp-items="ViewBag.KeyDefinitionList" class="form-select">
                            <option value="">請選擇鑰匙</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Balance" class="form-label">目前餘額</label>
                        <input asp-for="Balance" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Balance" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存變更</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
