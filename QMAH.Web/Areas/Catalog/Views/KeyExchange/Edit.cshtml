@using QMAH.Infrastructure.Models.Entities
@model QMAH.Web.Areas.Catalog.ViewModel.KeyExchangeEditViewModel

@{
    var isNew = Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "新增鑰匙兌換" : "編輯鑰匙兌換";
    ViewData["AdminDescription"] = "以資料化比例管理鑰匙兌換，並在儲存前檢查回收套利風險。";
    var keys = ViewBag.KeyDefinitions as IEnumerable<KeyDefinition> ?? [];
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回鑰匙兌換</a>
}

<div class="row row-cards">
    <div class="col-12 col-xl-8">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="card qmah-form-card">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="RowVersion" type="hidden" />
            <div class="card-header"><div><h2 class="card-title">兌換規則</h2><div class="text-secondary">來源與目標由伺服器重新驗證；會員端只會讀取啟用且仍有用途的規則。</div></div></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="SourceKeyDefinitionId" class="form-label">來源鑰匙</label>
                        <select asp-for="SourceKeyDefinitionId" class="form-select">
                            <option value="">請選擇來源鑰匙</option>
                            @foreach (var key in keys)
                            {
                                <option value="@key.Id">@key.Name（@key.Code）</option>
                            }
                        </select>
                        <span asp-validation-for="SourceKeyDefinitionId" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="SourceAmount" class="form-label">來源數量</label>
                        <input asp-for="SourceAmount" class="form-control" min="1" inputmode="numeric" />
                        <span asp-validation-for="SourceAmount" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="TargetKeyDefinitionId" class="form-label">目標鑰匙</label>
                        <select asp-for="TargetKeyDefinitionId" class="form-select">
                            <option value="">請選擇目標鑰匙</option>
                            @foreach (var key in keys)
                            {
                                <option value="@key.Id">@key.Name（@key.Code）</option>
                            }
                        </select>
                        <span asp-validation-for="TargetKeyDefinitionId" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="TargetAmount" class="form-label">目標數量</label>
                        <input asp-for="TargetAmount" class="form-control" min="1" inputmode="numeric" />
                        <span asp-validation-for="TargetAmount" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="SortOrder" class="form-label">顯示順序</label>
                        <input asp-for="SortOrder" class="form-control" min="0" inputmode="numeric" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Description" class="form-label">說明</label>
                        <input asp-for="Description" class="form-control" maxlength="300" placeholder="例如：一般鑰匙兌換分類鑰匙" />
                    </div>
                    <div class="col-12">
                        <label class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><span class="form-check-label">啟用這條兌換規則</span></label>
                    </div>
                </div>
            </div>
            <div class="card-footer qmah-card-footer"><a asp-action="Index" class="btn btn-outline-secondary">取消</a><button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>儲存規則</button></div>
        </form>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card qmah-dashboard-note h-100"><div class="card-body"><span class="qmah-status qmah-status--info">設定原則</span><h2 class="card-title mt-3">比例可以調，但不能製造套利</h2><p class="text-secondary mb-0">系統會比較來源與目標的回收點數價值。目標鑰匙若能回收出高於來源投入的點數，這條規則不會儲存。</p></div></div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
