@model IEnumerable<QMAH.Infrastructure.Models.Entities.KeyExchangeRule>

@{
    ViewData["Title"] = "鑰匙兌換";
    ViewData["AdminDescription"] = "維護鑰匙兌換比例；規則來自資料庫，會員端不需要寫死平衡數值。";
    var records = Model?.ToList() ?? [];
}

@section PageActions {
    <div class="qmah-actions d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>新增兌換規則</a>
        <a asp-area="Catalog" asp-controller="Key" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-key me-1"></i>鑰匙規則</a>
        <a asp-area="" asp-controller="Operations" asp-action="EconomyBatches" class="btn btn-outline-secondary"><i class="ti ti-users-group me-1"></i>批次資產活動</a>
    </div>
}

<div class="alert alert-info d-flex align-items-start gap-2" role="note">
    <i class="ti ti-info-circle fs-2" aria-hidden="true"></i>
    <div>兌換只會提供給目標範圍仍有可解鎖文物的會員。停用規則不會刪除歷史流水；儲存時也會檢查來源與目標的回收價值，避免形成套利。</div>
</div>

<div class="card qmah-list-card">
    <div class="card-header">
        <div><h2 class="card-title">兌換規則</h2><div class="card-subtitle">來源數量 → 目標數量；同一組來源與目標只保留一條規則。</div></div>
    </div>
    @if (records.Count == 0)
    {
        <div class="empty py-5"><div class="empty-icon"><i class="ti ti-arrows-exchange"></i></div><p class="empty-title">目前沒有兌換規則</p><p class="empty-subtitle text-secondary">先建立一般鑰匙到分類、年代或萬用鑰匙的兌換規則。</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table qmah-crud-table">
                <thead><tr><th>來源</th><th>目標</th><th>排序</th><th>說明</th><th>狀態</th><th class="w-1 text-center">操作</th></tr></thead>
                <tbody>
                @foreach (var rule in records)
                {
                    <tr>
                        <td><strong>@rule.SourceAmount × @rule.SourceKeyDefinition.Name</strong><div class="small text-secondary"><code>@rule.SourceKeyDefinition.Code</code></div></td>
                        <td><strong>@rule.TargetAmount × @rule.TargetKeyDefinition.Name</strong><div class="small text-secondary"><code>@rule.TargetKeyDefinition.Code</code></div></td>
                        <td>@rule.SortOrder</td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(rule.Description) ? "—" : rule.Description)</td>
                        <td><span class="badge @(rule.IsActive ? "bg-green-lt" : "bg-secondary-lt")">@(rule.IsActive ? "啟用" : "停用")</span></td>
                        <td class="text-center">
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-secondary"><i class="ti ti-edit me-1"></i>編輯</a>
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@rule.Id" />
                                    <button type="submit" class="btn btn-sm @(rule.IsActive ? "btn-outline-danger" : "btn-outline-success")" onclick="return confirm('@(rule.IsActive ? "確定停用這條兌換規則嗎？" : "確定啟用這條兌換規則嗎？")')">@(rule.IsActive ? "停用" : "啟用")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
