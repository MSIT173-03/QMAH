@model QMAH.Web.Areas.Catalog.ViewModel.CatalogImportViewModel

@{
    ViewData["Title"] = "文物資料匯入";
    ViewData["AdminDescription"] = "先檢查故宮資料，再匯入文物；題庫預設同步，商城商品由管理員決定。";
    var preview = Model.Preview;
}

@section Styles {
    <link rel="stylesheet" href="~/css/areas/catalog.css" asp-append-version="true" />
}

@section PageActions {
    <a asp-area="Catalog" asp-controller="Artifact" asp-action="Index" class="btn btn-outline-primary">查詢已匯入文物</a>
    <a asp-area="Catalog" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>返回圖鑑總覽
    </a>
}

<section class="card mb-4" aria-labelledby="source-title">
    <div class="card-body">
        <h2 id="source-title" class="card-title">查詢故宮原始資料</h2>
        <p class="text-secondary">依名稱、故宮編號或年代查詢，不會匯入或修改資料。要查詢本站內容，請使用「查詢已匯入文物」。</p>
        <form id="source-search" action="@Url.Action("SourcePreview")" class="row g-2 align-items-end">
            <div class="col-sm-3"><label for="browse-dataset" class="form-label">文物類別</label><select id="browse-dataset" name="dataset" class="form-select">
                @foreach (var category in QMAH.Infrastructure.CatalogImport.NpmOpenDataClient.DatasetDisplayNames)
                {
                    <option value="@category.Key">@category.Value</option>
                }
            </select></div>
            <div class="col-sm-6"><label for="browse-query" class="form-label">關鍵字</label><input id="browse-query" name="query" type="search" class="form-control" placeholder="名稱、故宮編號或年代；留空查詢全部" /></div>
            <div class="col-sm-3"><button class="btn btn-primary" type="submit">查詢資料</button></div>
        </form>
        <p id="source-status" class="text-secondary mt-3 mb-0" role="status" aria-live="polite">選擇類別後按「查詢資料」，即可瀏覽官方內容。</p>
    </div>
    <div id="source-results" class="table-responsive" hidden><table class="table table-vcenter card-table"><thead><tr><th>文物名稱</th><th>故宮編號</th><th>年代</th><th>來源</th></tr></thead><tbody id="source-rows"></tbody></table></div>
    <div id="source-pagination" class="card-footer" hidden>
        <button type="button" id="source-prev" class="btn btn-outline-secondary">上一頁</button><span id="source-page"></span><button type="button" id="source-next" class="btn btn-outline-secondary">下一頁</button>
    </div>
</section>

<div class="row row-cards qmah-import-page">
    <div class="col-12">
        <form asp-action="PreviewSource" method="post" class="card qmah-form-card mb-4">
            @Html.AntiForgeryToken()
            <div class="card-header">
                <div>
                    <h2 class="card-title">從故宮官方資料匯入</h2>
                    <div class="text-secondary">系統會下載官方資料與圖片，並先顯示新增、更新與排除筆數。</div>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="ti ti-alert-circle me-1"></i>@Model.ErrorMessage
                    </div>
                }
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <fieldset class="mb-3">
                    <legend class="form-label">文物類別</legend>
                    <div class="row g-2">
                        @foreach (var category in new[]
                        {
                            (Value: "bronzes", Label: "銅器"),
                            (Value: "ceramics", Label: "陶瓷"),
                            (Value: "jades", Label: "玉器"),
                            (Value: "enamelWares", Label: "琺瑯器"),
                            (Value: "lacquerWares", Label: "漆器"),
                            (Value: "coins", Label: "錢幣"),
                            (Value: "carvings", Label: "雕刻"),
                            (Value: "paintings", Label: "繪畫")
                        })
                        {
                            <div class="col-6 col-md-3">
                                <label class="form-check">
                                    <input class="form-check-input"
                                           name="datasets"
                                           type="checkbox"
                                           value="@category.Value"
                                           checked="@(category.Value == "bronzes")" />
                                    <span class="form-check-label">@category.Label</span>
                                </label>
                            </div>
                        }
                    </div>
                    <div class="form-hint">直接勾選要一起匯入的類別。</div>
                </fieldset>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="mode">資料範圍</label>
                        <select class="form-select" id="mode" name="mode">
                            <option value="both">新增與既有更新</option>
                            <option value="new">只取新增文物</option>
                            <option value="update">只檢查既有文物</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="maxItems">每個類別最多取幾筆</label>
                        <select class="form-select" id="maxItems" name="maxItems">
                            <option value="10">10 筆</option>
                            <option value="20">20 筆</option>
                            <option value="32" selected>32 筆</option>
                            <option value="50">50 筆</option>
                            <option value="100">100 筆</option>
                        </select>
                        <div class="form-hint">這個上限會分別套用到每個勾選的類別。</div>
                    </div>
                </div>

                <div class="border rounded p-3 bg-light-subtle">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" id="sourceSyncQuestionBank" name="syncQuestionBank" value="true" type="checkbox" checked />
                        <input name="syncQuestionBank" value="false" type="hidden" />
                        <label class="form-check-label" for="sourceSyncQuestionBank">
                            <strong>同步題庫（預設開啟）</strong>
                            <span class="d-block text-secondary small">新增文物會一併加入題庫。</span>
                        </label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" id="sourceSyncShop" name="syncShop" value="true" type="checkbox" />
                        <input name="syncShop" value="false" type="hidden" />
                        <label class="form-check-label" for="sourceSyncShop">
                            <strong>同步商城商品</strong>
                            <span class="d-block text-secondary small">為新增文物建立展示商品；既有商品保留人工調整。</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="card-footer qmah-card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-cloud-download me-1"></i>下載並預檢
                </button>
            </div>
        </form>

        <details class="mb-4">
        <summary class="btn btn-outline-secondary mb-3">進階匯入：上傳 JSON 與圖片 ZIP</summary>
        <form asp-action="Preview" method="post" enctype="multipart/form-data" class="card qmah-form-card">
            @Html.AntiForgeryToken()
            <div class="card-header">
                <div>
                    <h2 class="card-title">進階：上傳資料包</h2>
                    <div class="text-secondary">需要匯入自行整理的資料時，可上傳 JSON 與圖片資產 ZIP。</div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="artifactsFile">文物資料包 <span class="text-danger">*</span></label>
                    <input class="form-control" id="artifactsFile" name="artifactsFile" type="file" accept=".json,application/json" required />
                    <div class="form-hint">請使用已完成年代與圖片品質檢查的文物資料包。</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="productsFile">商城商品資料包（可選）</label>
                    <input class="form-control" id="productsFile" name="productsFile" type="file" accept=".json,application/json" />
                    <div class="form-hint">勾選商城同步但未提供此檔時，系統會依新增文物建立展示商品，不覆蓋既有商品。</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="mediaArchive">圖片資產 ZIP（可選）</label>
                    <input class="form-control" id="mediaArchive" name="mediaArchive" type="file" accept=".zip,application/zip" />
                    <div class="form-hint">ZIP 內保留 media 根目錄以下的相對路徑；若資料包有圖片，請一併提供。</div>
                </div>

                <div class="border rounded p-3 bg-light-subtle">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" id="syncQuestionBank" name="syncQuestionBank" value="true" type="checkbox" checked />
                        <input name="syncQuestionBank" value="false" type="hidden" />
                        <label class="form-check-label" for="syncQuestionBank">
                            <strong>同步題庫（預設開啟）</strong>
                            <span class="d-block text-secondary small">新增文物會一併加入題庫；只有特殊資料包才取消。</span>
                        </label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" id="syncShop" name="syncShop" value="true" type="checkbox" />
                        <input name="syncShop" value="false" type="hidden" />
                        <label class="form-check-label" for="syncShop">
                            <strong>同步商城商品</strong>
                            <span class="d-block text-secondary small">不勾選時只匯入文物與題庫，不讀取或建立商品。</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="card-footer qmah-card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-search me-1"></i>預檢資料包
                </button>
            </div>
        </form>
        </details>
    </div>

    <div class="col-12">
        <details>
        <summary class="text-secondary mb-2">查看匯入規則與資料保護方式</summary>
        <div class="card qmah-dashboard-note">
            <div class="card-header">
                <h2 class="card-title">匯入原則</h2>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>只接受已通過資料品質檢查的文物資料。</li>
                    <li>相同的故宮編號或商品編號會判定為既有資料，不會覆蓋既有圖片與人工調整。</li>
                    <li>分類與年代必須能對應既有規則；無法確認的資料會在預檢時排除。</li>
                    <li>資料庫與圖片會用同一個確認碼完成匯入，任一階段失敗都不會留下半套資料。</li>
                </ul>
            </div>
        </div>
        </details>
    </div>
</div>

@if (preview is not null)
{
    <div id="import-preview" tabindex="-1" class="card mt-4 qmah-list-card qmah-import-preview-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">預檢結果</h2>
                <div class="text-secondary">確認筆數與警告後，才會執行正式匯入。</div>
            </div>
        </div>
        <details class="card-body">
            <summary>查看本次候選文物（@Model.Artifacts.Count 件）</summary>
            <p class="text-secondary mt-2">以下為送入預檢的內容；實際新增、更新與排除數量以預檢結果為準。</p>
            <div class="table-responsive"><table class="table"><thead><tr><th>文物名稱</th><th>故宮編號</th></tr></thead><tbody>
                @foreach (var artifact in Model.Artifacts)
                {
                    <tr><td>@artifact.Name</td><td>@artifact.ArtifactRef</td></tr>
                }
            </tbody></table></div>
        </details>
        <div class="table-responsive">
            <table class="table table-vcenter card-table qmah-import-summary-table">
                <tbody>
                    <tr><th>文物候選</th><td>@preview.ArtifactCandidateCount</td><th>新增／更新／不變</th><td>@preview.NewArtifactCount / @preview.UpdatedArtifactCount / @preview.UnchangedArtifactCount</td></tr>
                    <tr><th>題庫入口</th><td>@preview.NewQuestionEntryCount 筆新增</td><th>既有題庫</th><td>@preview.ExistingQuestionEntryCount 筆</td></tr>
                    <tr><th>商城商品</th><td>@preview.ProductCandidateCount</td><th>新增／更新／不變</th><td>@preview.NewProductCount / @preview.UpdatedProductCount / @preview.UnchangedProductCount</td></tr>
                    <tr><th>排除資料</th><td>@preview.InvalidArtifactCount 筆文物欄位無效</td><th>分類或對應不完整</th><td>@preview.UnmappedArtifactCount 筆文物／@preview.InvalidProductCount 筆商品欄位無效／@preview.UnmappedProductCount 筆商品</td></tr>
                </tbody>
            </table>
        </div>
        @if (preview.MissingCategories.Count > 0 || preview.Warnings.Count > 0)
        {
            <div class="card-body">
                @if (preview.MissingCategories.Count > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        固定基準尚缺分類：@string.Join("、", preview.MissingCategories)
                    </div>
                }
                @foreach (var warning in preview.Warnings)
                {
                    <div class="text-secondary small mb-1"><i class="ti ti-alert-triangle me-1"></i>@warning</div>
                }
            </div>
        }
        <div class="card-footer qmah-card-footer qmah-card-footer--split">
            <div class="text-secondary small">
                題庫同步：@(preview.SyncQuestionBank ? "開啟" : "關閉")；商城同步：@(preview.SyncShop ? "開啟" : "關閉")
            </div>
            <form asp-action="Import" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="stageId" value="@Model.StageId" />
                <input type="hidden" name="approvalToken" value="@Model.ApprovalToken" />
                <button type="submit" class="btn btn-success" onclick="return confirm('確認依預檢結果匯入資料嗎？')">
                    <i class="ti ti-database-import me-1"></i>確認匯入
                </button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/areas/catalog-import.js" asp-append-version="true"></script>
}
