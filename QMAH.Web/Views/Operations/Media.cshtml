@model QMAH.Web.Models.MediaAdminFilterViewModel

@{
    ViewData["Title"] = "圖庫管理";
    ViewData["AdminDescription"] = "查看社群上傳圖片、預覽內容並處理顯示狀態；圖片檔案透過管理權限受控讀取。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var start = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
    var avatarStart = Model.AvatarTotalCount == 0 ? 0 : ((Model.AvatarPage - 1) * Model.AvatarPageSize) + 1;
    var avatarEnd = Math.Min(Model.AvatarPage * Model.AvatarPageSize, Model.AvatarTotalCount);
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-chart-dots-3 me-1"></i>返回營運中心</a>
    <a asp-action="AuditLogs" class="btn btn-outline-secondary"><i class="ti ti-history me-1"></i>稽核紀錄</a>
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/qmah-operations.css" asp-append-version="true" />
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-body">
        <form method="get" asp-action="Media" class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label asp-for="Keyword" class="form-label">搜尋圖片</label>
                <input asp-for="Keyword" class="form-control" placeholder="檔名、替代文字、上傳者或貼文" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Source" class="form-label">圖片用途</label>
                <select asp-for="Source" class="form-select">
                    <option value="">全部社群圖片</option>
                    <option value="POST">貼文內文圖片</option>
                    <option value="EVENT">活動公告附圖</option>
                    <option value="UNLINKED">未關聯圖片</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Status" class="form-label">顯示狀態</label>
                <select asp-for="Status" class="form-select">
                    <option value="">全部狀態</option>
                    <option value="ACTIVE">可使用</option>
                    <option value="HIDDEN">已隱藏</option>
                    <option value="DELETED">已刪除</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="Sort" class="form-label">排序方式</label>
                <select asp-for="Sort" class="form-select">
                    <option value="NEWEST">最新上傳</option>
                    <option value="OLDEST">最早上傳</option>
                    <option value="SEQUENCE">圖片編號</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-1">
                <label asp-for="PageSize" class="form-label">每頁筆數</label>
                <select asp-for="PageSize" class="form-select">
                    @foreach (var size in new[] { 10, 20, 30, 50, 100 })
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-1">
                <button type="submit" class="btn btn-primary w-100" title="套用篩選"><i class="ti ti-filter" aria-hidden="true"></i><span class="visually-hidden">套用篩選</span></button>
            </div>
        </form>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead><tr><th>預覽</th><th>圖片編號</th><th>檔案資訊</th><th>上傳者</th><th>關聯內容</th><th>狀態</th><th>操作</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary py-5">目前沒有符合條件的圖片。</td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="qmah-media-preview-cell">
                            @if (item.Status != "DELETED")
                            {
                                <img src="@Url.Action("MediaContent", "Operations", new { id = item.Id })" class="avatar avatar-md object-cover" alt="@(item.AltText ?? "社群圖片")" loading="lazy" />
                            }
                            else
                            {
                                <span class="avatar avatar-md bg-secondary-lt"><i class="ti ti-photo-off" aria-hidden="true"></i></span>
                            }
                        </td>
                        <td><span class="fw-semibold">@item.SequenceNo</span><div class="small text-secondary">@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</div></td>
                        <td><div class="text-truncate qmah-media-filename" title="@item.OriginalFileName">@item.OriginalFileName</div><div class="small text-secondary">@FormatFileSize(item.FileSize)</div></td>
                        <td>@item.OwnerName</td>
                        <td class="qmah-media-relation">
                            @if (!string.IsNullOrWhiteSpace(item.AvatarOwnerName))
                            {
                                <div><i class="ti ti-user-circle me-1" aria-hidden="true"></i>會員頭貼：@item.AvatarOwnerName</div>
                            }
                            @if (item.EventId.HasValue)
                            {
                                <div>
                                    <i class="ti ti-calendar-event me-1" aria-hidden="true"></i>活動公告附圖：
                                    <a asp-area="Social" asp-controller="SocialEventAdmin" asp-action="Edit" asp-route-id="@item.EventId">
                                        @(string.IsNullOrWhiteSpace(item.EventTitle) ? "已關聯活動" : item.EventTitle)
                                    </a>
                                </div>
                                <div class="small text-secondary">透過活動同步貼文關聯</div>
                            }
                            else if (item.PostId.HasValue)
                            {
                                <div>
                                    <i class="ti ti-message-circle me-1" aria-hidden="true"></i>貼文內文圖片：
                                    <a asp-area="Social" asp-controller="SocialPostAdmin" asp-action="Edit" asp-route-id="@item.PostId">
                                        @(string.IsNullOrWhiteSpace(item.PostTitle) ? "已關聯貼文" : item.PostTitle)
                                    </a>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.PostAuthorName))
                                {
                                    <div class="small text-secondary">發布者：@item.PostAuthorName</div>
                                }
                            }
                            @if (!item.PostId.HasValue && string.IsNullOrWhiteSpace(item.AvatarOwnerName))
                            {
                                <span class="text-secondary">尚未關聯貼文或頭貼</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary-lt">@AdminDisplayLabels.Status(item.Status)</span></td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (item.Status != "ACTIVE")
                                {
                                    <form asp-action="SetMediaStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="ACTIVE" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" @(item.Status == "DELETED" ? "disabled" : null)>恢復顯示</button>
                                    </form>
                                }
                                @if (item.Status == "ACTIVE")
                                {
                                    <form asp-action="SetMediaStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="HIDDEN" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">暫時隱藏</button>
                                    </form>
                                }
                                @if (item.Status != "DELETED")
                                {
                                    <form asp-action="SetMediaStatus" method="post" onsubmit="return confirm('確定要將這張圖片標記為已刪除嗎？');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="DELETED" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">標記刪除</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
<div class="card-footer qmah-card-footer qmah-card-footer--split">
        <span class="text-secondary">顯示第 @start～@end 筆，共 @Model.TotalCount 筆</span>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="圖片清單分頁">
                <ul class="pagination m-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Media" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-source="@Model.Source" asp-route-sort="@Model.Sort">上一頁</a></li>
                    <li class="page-item disabled"><span class="page-link">第 @Model.Page / @Model.TotalPages 頁</span></li>
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Media" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-source="@Model.Source" asp-route-sort="@Model.Sort">下一頁</a></li>
                </ul>
            </nav>
        }
    </div>
</div>

<section class="card qmah-list-card mt-3" aria-labelledby="avatar-index-title">
    <div class="card-header">
        <div>
            <h2 id="avatar-index-title" class="card-title mb-1">會員頭貼索引</h2>
            <p class="text-secondary mb-0">顯示目前由系統管理的會員頭貼，方便確認檔案用途與擁有者。</p>
        </div>
        <span class="badge bg-secondary-lt">@Model.AvatarTotalCount 位會員</span>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Media" class="row g-3 align-items-end mb-4">
            <input type="hidden" name="keyword" value="@Model.Keyword" />
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="hidden" name="source" value="@Model.Source" />
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="hidden" name="page" value="@Model.Page" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="avatarPage" value="1" />
            <div class="col-12 col-lg-5">
                <label asp-for="AvatarKeyword" class="form-label">搜尋會員頭貼</label>
                <input asp-for="AvatarKeyword" class="form-control" placeholder="輸入會員暱稱" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label asp-for="AvatarSort" class="form-label">頭貼排序</label>
                <select asp-for="AvatarSort" class="form-select">
                    <option value="NAME">依暱稱</option>
                    <option value="NEWEST">最近更新</option>
                    <option value="OLDEST">最早更新</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="AvatarPageSize" class="form-label">每頁筆數</label>
                <select asp-for="AvatarPageSize" class="form-select">
                    @foreach (var size in new[] { 10, 20, 30, 50, 100 })
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="ti ti-search me-1" aria-hidden="true"></i>套用</button>
            </div>
        </form>
        <div class="small text-secondary mb-3">顯示第 @avatarStart～@avatarEnd 筆，共 @Model.AvatarTotalCount 位會員</div>
        @if (Model.AvatarItems.Count == 0)
        {
            <div class="qmah-empty-state"><i class="ti ti-user-off" aria-hidden="true"></i><span>目前沒有可顯示的會員頭貼。</span></div>
        }
        else
        {
            <div class="qmah-media-avatar-grid">
                @foreach (var avatar in Model.AvatarItems)
                {
                    <div class="qmah-media-avatar-item">
                        <img src="@avatar.AvatarPath" alt="@avatar.OwnerName 的會員頭貼" loading="lazy" decoding="async" />
                        <div class="qmah-media-avatar-item__body">
                            <span>@avatar.OwnerName</span>
                            <a asp-area="User" asp-controller="Members" asp-action="Edit" asp-route-id="@avatar.UserId" class="btn btn-sm btn-outline-primary">編輯頭貼</a>
                        </div>
                    </div>
                }
            </div>
        }
        @if (Model.AvatarTotalPages > 1)
        {
            <div class="qmah-card-footer qmah-card-footer--split mt-4">
                <span class="text-secondary">第 @Model.AvatarPage / @Model.AvatarTotalPages 頁</span>
                <nav aria-label="會員頭貼索引分頁">
                    <ul class="pagination m-0">
                        <li class="page-item @(Model.AvatarPage <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Media" asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-source="@Model.Source" asp-route-sort="@Model.Sort" asp-route-avatarKeyword="@Model.AvatarKeyword" asp-route-avatarSort="@Model.AvatarSort" asp-route-avatarPage="@(Model.AvatarPage - 1)" asp-route-avatarPageSize="@Model.AvatarPageSize">上一頁</a></li>
                        <li class="page-item disabled"><span class="page-link">@Model.AvatarPage / @Model.AvatarTotalPages</span></li>
                        <li class="page-item @(Model.AvatarPage >= Model.AvatarTotalPages ? "disabled" : null)"><a class="page-link" asp-action="Media" asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize" asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status" asp-route-source="@Model.Source" asp-route-sort="@Model.Sort" asp-route-avatarKeyword="@Model.AvatarKeyword" asp-route-avatarSort="@Model.AvatarSort" asp-route-avatarPage="@(Model.AvatarPage + 1)" asp-route-avatarPageSize="@Model.AvatarPageSize">下一頁</a></li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</section>

@functions {
    private static string FormatFileSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024d * 1024d):0.##} MB",
        >= 1024 => $"{bytes / 1024d:0.##} KB",
        _ => $"{bytes} bytes"
    };
}
