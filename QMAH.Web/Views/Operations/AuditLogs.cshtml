@model QMAH.Web.Models.AuditLogFilterViewModel

@{
    ViewData["Title"] = "稽核紀錄";
    ViewData["AdminDescription"] = "查看後台寫入操作的時間、操作者與處理結果；可依管理區域、日期、狀態與操作者查找，不保存密碼、Token 或請求內容。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var start = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-chart-dots-3 me-1"></i>返回營運中心</a>
    <a asp-action="Media" class="btn btn-outline-secondary"><i class="ti ti-photo me-1"></i>圖庫管理</a>
}

<div class="card qmah-filter-panel mb-3">
    <div class="card-body">
        <form method="get" asp-action="AuditLogs" class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label asp-for="Keyword" class="form-label">搜尋</label>
                <input asp-for="Keyword" class="form-control" placeholder="操作者、功能或處理說明" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="AreaCode" class="form-label">管理區域</label>
                <select asp-for="AreaCode" class="form-select">
                    <option value="">全部區域</option>
                    <option value="Root">營運中心</option>
                    <option value="Catalog">圖鑑管理</option>
                    <option value="Game">遊戲管理</option>
                    <option value="Social">社群管理</option>
                    <option value="Store">商城管理</option>
                    <option value="User">會員管理</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="From" class="form-label">開始日期</label>
                <input asp-for="From" type="date" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="To" class="form-label">結束日期</label>
                <input asp-for="To" type="date" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label asp-for="StatusCode" class="form-label">結果代碼</label>
                <input asp-for="StatusCode" class="form-control" inputmode="numeric" placeholder="例如 200" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <button type="submit" class="btn btn-primary w-100"><i class="ti ti-filter me-1"></i>套用篩選</button>
            </div>
        </form>
        <div class="qmah-audit-note mt-3" role="note">
            <i class="ti ti-shield-check" aria-hidden="true"></i>
            <span>稽核紀錄會保留具管理權限的寫入操作、操作者、路徑與回應結果；不保存密碼、Token 或請求內容。若要追查欄位差異，請搭配該筆資料的最後更新時間查看。</span>
        </div>
    </div>
</div>

<div class="card qmah-list-card">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table qmah-crud-table">
            <thead><tr><th>時間</th><th>操作者</th><th>管理操作</th><th>結果</th><th>處理說明</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-5">目前沒有符合條件的稽核紀錄。</td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    var completed = AdminDisplayLabels.AuditResult(item.ResultStatusCode) == "完成";
                    <tr>
                        <td class="text-nowrap">@item.OccurredAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</td>
                        <td>@item.ActorName</td>
                        <td>
                            <span class="badge bg-secondary-lt mb-1">@AdminDisplayLabels.AuditArea(item.Area)</span>
                            <div>@AdminDisplayLabels.AuditTarget(item.Area, item.Controller, item.Action)</div>
                        </td>
                        <td>
                            <span class="badge @(completed ? "bg-success-lt text-success" : "bg-danger-lt text-danger")">@(completed ? "完成" : "未完成")</span>
                            <small class="d-block text-secondary mt-1">HTTP @item.ResultStatusCode</small>
                        </td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(item.Detail) ? "—" : item.Detail)</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
<div class="card-footer qmah-card-footer qmah-card-footer--split">
        <span class="text-secondary">顯示第 @start～@end 筆，共 @Model.TotalCount 筆</span>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="稽核紀錄分頁">
                <ul class="pagination m-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-action="AuditLogs" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-keyword="@Model.Keyword" asp-route-areaCode="@Model.AreaCode" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-statusCode="@Model.StatusCode">上一頁</a></li>
                    <li class="page-item disabled"><span class="page-link">第 @Model.Page / @Model.TotalPages 頁</span></li>
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="AuditLogs" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-keyword="@Model.Keyword" asp-route-areaCode="@Model.AreaCode" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-statusCode="@Model.StatusCode">下一頁</a></li>
                </ul>
            </nav>
        }
    </div>
</div>
