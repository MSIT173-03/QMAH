@model QMAH.Web.Models.OperationsDashboardViewModel

@{
    ViewData["Title"] = "營運中心";
    ViewData["AdminDescription"] = "集中查看會員、營收、遊戲、社群、活動與圖庫的長期資料；統計依資料庫紀錄計算，不代表即時在線人數。";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var rangeDays = (Model.To - Model.From).Days + 1;
    var isPresetRange = rangeDays is 7 or 30 or 90 or 180 or 365;
}

@section PageActions {
    <a asp-action="AuditLogs" class="btn btn-outline-secondary"><i class="ti ti-history me-1"></i>稽核紀錄</a>
    <a asp-action="Media" class="btn btn-outline-secondary"><i class="ti ti-photo me-1"></i>圖庫管理</a>
}

<div class="qmah-operations-dashboard" data-qmah-operations-dashboard data-dashboard-url="@Url.Action("DashboardData", "Operations")">
    <div class="card qmah-filter-panel mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end" data-qmah-operations-filter>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="days" class="form-label">快速範圍</label>
                    <select id="days" name="days" class="form-select">
                        <option value="7" selected="@(rangeDays == 7 ? "selected" : null)">最近 7 天</option>
                        <option value="30" selected="@(rangeDays == 30 ? "selected" : null)">最近 30 天</option>
                        <option value="90" selected="@(rangeDays == 90 ? "selected" : null)">最近 90 天</option>
                        <option value="180" selected="@(rangeDays == 180 ? "selected" : null)">最近 180 天</option>
                        <option value="365" selected="@(rangeDays == 365 ? "selected" : null)">最近 365 天</option>
                        <option value="" selected="@(!isPresetRange ? "selected" : null)">自訂日期區間</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="from" class="form-label">開始日期</label>
                    <input id="from" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="to" class="form-label">結束日期</label>
                    <input id="to" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <button type="submit" class="btn btn-primary w-100"><i class="ti ti-filter me-1"></i>更新統計</button>
                </div>
            </form>
            <div class="form-hint mt-2">目前顯示 @Model.From.ToString("yyyy/MM/dd") 至 @Model.To.ToString("yyyy/MM/dd")，最多保留一年逐日資料。</div>
        </div>
    </div>

    <div id="operations-dashboard-content"
         data-qmah-operations-content
         aria-live="polite"
         aria-busy="true">
        <div class="qmah-operations-loading" role="status" aria-label="正在載入營運統計">
            <div class="row row-cards">
                @for (var index = 0; index < 6; index++)
                {
                    <div class="col-12 col-sm-6 col-xl-2"><div class="qmah-operations-loading__block qmah-operations-loading__block--kpi"></div></div>
                }
            </div>
            <div class="qmah-operations-loading__row">
                <div class="qmah-operations-loading__block qmah-operations-loading__block--chart"></div>
                <div class="qmah-operations-loading__block qmah-operations-loading__block--chart"></div>
            </div>
            <span class="visually-hidden">正在載入資料，完成後會顯示圖表與詳細統計</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const root = document.querySelector("[data-qmah-operations-dashboard]");
            const form = root?.querySelector("[data-qmah-operations-filter]");
            const content = root?.querySelector("[data-qmah-operations-content]");
            const preset = form?.querySelector("#days");
            const from = form?.querySelector("#from");
            const to = form?.querySelector("#to");
            let requestController;

            if (!root || !form || !content) return;

            const getDashboardUrl = () => {
                const url = new URL(root.dataset.dashboardUrl, window.location.origin);
                const query = new URLSearchParams(new FormData(form));
                for (const [key, value] of query) {
                    if (value) url.searchParams.set(key, value);
                }
                return url;
            };

            const showError = () => {
                content.innerHTML = `
                    <div class="qmah-empty-state qmah-operations-error" role="alert">
                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                        <div>
                            <strong>統計資料暫時無法載入</strong>
                            <p class="mb-2">請確認資料庫連線後再試一次，日期條件不會遺失</p>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-qmah-retry>重新載入</button>
                        </div>
                    </div>`;
                content.querySelector("[data-qmah-retry]")?.addEventListener("click", loadDashboard);
            };

            async function loadDashboard() {
                requestController?.abort();
                requestController = new AbortController();
                content.setAttribute("aria-busy", "true");
                root.classList.add("is-loading");

                try {
                    const response = await fetch(getDashboardUrl(), {
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        signal: requestController.signal
                    });
                    if (!response.ok) throw new Error(`Dashboard request failed: ${response.status}`);
                    content.innerHTML = await response.text();
                } catch (error) {
                    if (error?.name !== "AbortError") showError();
                } finally {
                    content.removeAttribute("aria-busy");
                    root.classList.remove("is-loading");
                }
            }

            [from, to].forEach((input) => input?.addEventListener("change", () => {
                if (preset) preset.value = "";
            }));

            form.addEventListener("submit", (event) => {
                event.preventDefault();
                const url = getDashboardUrl();
                window.history.replaceState(null, "", `${window.location.pathname}${url.search}`);
                loadDashboard();
            });

            loadDashboard();
        })();
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/qmah-operations.css" asp-append-version="true" />
}
