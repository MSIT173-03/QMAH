@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<QMAH.Infrastructure.Models.Entities.ArtifactCategory> ?? [];
    var rows = ViewBag.Rows as List<QMAH.Web.Controllers.OperationsController.UnlockResetRow> ?? [];
    string? q = ViewBag.Query;
    Guid? categoryId = ViewBag.CategoryId;
    bool onlyUnlocked = ViewBag.OnlyUnlocked ?? true;
    int pageNo = ViewBag.Page ?? 1;
    int pages = ViewBag.Pages ?? 1;
    int scopeUnlocks = ViewBag.ScopeUnlocks ?? 0;
    int scopeRefundable = ViewBag.ScopeRefundable ?? 0;
    int totalMembers = ViewBag.TotalMembers ?? 0;
    var scopeName = categories.FirstOrDefault(item => item.Id == categoryId)?.Name ?? "全部分類";
}

@section PageActions {
    <div class="qmah-actions d-flex flex-wrap gap-2">
        <a asp-action="EconomyBatches" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>返回資產異動</a>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="q">搜尋會員</label>
                <input class="form-control" id="q" name="q" value="@q" placeholder="帳號或 Email" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="categoryId">範圍（文物分類）</label>
                <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">全部分類</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == categoryId)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="onlyUnlocked" value="true" checked="@onlyUnlocked" />
                    <span class="form-check-label">只看有解鎖的</span>
                </label>
                <input type="hidden" name="onlyUnlocked" value="false" />
            </div>
            <div class="col-md-2"><button class="btn btn-primary w-100" type="submit"><i class="ti ti-search me-1"></i>查詢</button></div>
        </form>
        <div class="text-muted small mt-3">範圍「@scopeName」共 @scopeUnlocks 筆解鎖，其中 @scopeRefundable 筆可退鑰匙。符合條件的會員 @totalMembers 位，每頁 20 位。</div>
    </div>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>會員</th><th class="text-end">解鎖數</th><th class="text-end">可退鑰匙</th><th class="text-end">鑰匙背包</th><th class="text-end">操作</th></tr></thead>
            <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.Name<div class="text-muted small">@row.Email</div></td>
                    <td class="text-end">@row.Total</td>
                    <td class="text-end">@row.KeyUnlocks</td>
                    <td class="text-end">@row.KeyBalance</td>
                    <td class="text-end text-nowrap">
                        <form method="post" class="d-inline" asp-action="UnlockReset" onsubmit="return confirm('清除 @row.Name 在「@scopeName」的 @row.Total 筆解鎖，並退還 @row.KeyUnlocks 把鑰匙？');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@row.Id" /><input type="hidden" name="categoryId" value="@categoryId" />
                            <input type="hidden" name="q" value="@q" /><input type="hidden" name="onlyUnlocked" value="@onlyUnlocked" /><input type="hidden" name="page" value="@pageNo" />
                            <button class="btn btn-sm btn-outline-danger" type="submit" disabled="@(row.Total == 0)">清除並退鑰匙</button>
                        </form>
                        <form method="post" class="d-inline" asp-action="UnlockGrant" onsubmit="return confirm('替 @row.Name 解鎖「@scopeName」尚未解鎖的文物（不扣鑰匙）？');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@row.Id" /><input type="hidden" name="categoryId" value="@categoryId" />
                            <input type="hidden" name="q" value="@q" /><input type="hidden" name="onlyUnlocked" value="@onlyUnlocked" /><input type="hidden" name="page" value="@pageNo" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">全部解鎖</button>
                        </form>
                    </td>
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">沒有符合的會員</td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (pages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <a class="btn btn-sm btn-outline-secondary @(pageNo <= 1 ? "disabled" : "")" asp-action="UnlockReset" asp-all-route-data='new Dictionary<string, string?> { ["q"] = q, ["categoryId"] = categoryId?.ToString(), ["onlyUnlocked"] = onlyUnlocked.ToString(), ["page"] = (pageNo - 1).ToString() }'>上一頁</a>
            <span class="text-muted small">第 @pageNo / @pages 頁</span>
            <a class="btn btn-sm btn-outline-secondary @(pageNo >= pages ? "disabled" : "")" asp-action="UnlockReset" asp-all-route-data='new Dictionary<string, string?> { ["q"] = q, ["categoryId"] = categoryId?.ToString(), ["onlyUnlocked"] = onlyUnlocked.ToString(), ["page"] = (pageNo + 1).ToString() }'>下一頁</a>
        </div>
    }
</div>

<div class="card border-danger">
    <div class="card-body">
        <h3 class="card-title text-danger">全體清除（範圍：@scopeName）</h3>
        <p class="text-muted mb-3">會清除所有會員在此範圍的 @scopeUnlocks 筆解鎖，並退還 @scopeRefundable 把鑰匙。請輸入「清除全部」才能執行。</p>
        <form method="post" asp-action="UnlockReset" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryId" value="@categoryId" />
            <div class="col-md-4"><input class="form-control" name="confirmText" placeholder="清除全部" autocomplete="off" /></div>
            <div class="col-auto"><button class="btn btn-danger" type="submit"><i class="ti ti-lock me-1"></i>全體清除並退鑰匙</button></div>
        </form>
    </div>
</div>
