<!doctype html>
<html lang="zh-Hant" data-bs-theme="light" class="qmah-preload">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f6f4" data-qmah-theme-color />
    <title>@(ViewData["Title"] ?? "管理員登入")｜清明鑑定屋 QMAH</title>
    <link rel="icon" href="~/images/brand/qmah-favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" href="https://fonts.gstatic.com/s/plusjakartasans/v12/LDIoaomQNQcsA88c7O9yZ4KMCoOg4Ko20yw.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="https://fonts.gstatic.com/s/sourceserif4/v14/vEFy2_tTDB4M7-auWDN0ahZJW3IX2ih5nk3AucvUHf6OAVIJmeUDygwjivBtnhtdDg.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="~/fonts/qmah-auth-noto-sans-tc-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="~/fonts/qmah-auth-noto-sans-tc-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="~/fonts/qmah-source-serif-4-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="~/fonts/qmah-auth-noto-serif-tc-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script>
        (() => {
            const root = document.documentElement;
            let savedTheme = null;
            try {
                savedTheme = localStorage.getItem("qmah-admin-theme");
            } catch {
                // 儲存空間被瀏覽器封鎖時仍使用系統偏好，不阻止登入頁載入。
            }
            const theme = savedTheme === "dark" || savedTheme === "light"
                ? savedTheme
                : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            root.dataset.bsTheme = theme;
            root.style.colorScheme = theme;
        })();
    </script>
    <link rel="stylesheet" href="~/admin/css/qmah-admin-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-tabler.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-interactions.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* 等登入頁樣式完成後才顯示，避免先看到未套版內容 */
        html.qmah-preload body { visibility: hidden; }
        html.qmah-preload { background: #f3f6f4; }
    </style>
    <noscript><style>html.qmah-preload body { visibility: visible; }</style></noscript>
    <script>document.documentElement.classList.remove("qmah-preload");</script>
</head>
<body class="qmah-auth-body">
    <a class="qmah-skip-link" href="#auth-main">跳至登入表單</a>

    <button type="button" class="qmah-auth-theme-toggle" data-qmah-theme-toggle aria-label="切換深色模式" aria-pressed="false">
        <span class="qmah-auth-theme-icon qmah-auth-theme-icon--moon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20.4 15.3A8.5 8.5 0 0 1 8.7 3.6 8.5 8.5 0 1 0 20.4 15.3Z" /></svg>
        </span>
        <span class="qmah-auth-theme-icon qmah-auth-theme-icon--sun" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" /></svg>
        </span>
    </button>

    <main id="auth-main" class="qmah-auth-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/admin/js/qmah-interactions.js" asp-append-version="true"></script>
    <script>
        (() => {
            const root = document.documentElement;
            const toggle = document.querySelector("[data-qmah-theme-toggle]");
            const themeColor = document.querySelector("[data-qmah-theme-color]");
            const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
            const themeStorageKey = "qmah-admin-theme";
            let themeTransitionPromise = null;
            let pendingThemeRequest = null;

            const writeStorage = (key, value) => {
                try {
                    localStorage.setItem(key, value);
                } catch {
                    // 儲存空間不可用時，主題仍可在本頁切換。
                }
            };

            const sync = () => {
                const isDark = root.dataset.bsTheme === "dark";
                toggle?.setAttribute("aria-pressed", String(isDark));
                toggle?.setAttribute("aria-label", isDark ? "切換淺色模式" : "切換深色模式");
                themeColor?.setAttribute("content", isDark ? "#101b1f" : "#f3f6f4");
            };

            const applyTheme = (theme, persist = true) => {
                root.dataset.bsTheme = theme;
                root.style.colorScheme = theme;
                if (persist) writeStorage(themeStorageKey, theme);
                sync();
            };

            const getGeometry = () => {
                const visualViewport = window.visualViewport;
                const width = Number.isFinite(visualViewport?.width) && visualViewport.width > 0
                    ? visualViewport.width
                    : (Number.isFinite(window.innerWidth) && window.innerWidth > 0
                        ? window.innerWidth
                        : Math.max(1, document.documentElement.clientWidth || 1));
                const height = Number.isFinite(visualViewport?.height) && visualViewport.height > 0
                    ? visualViewport.height
                    : (Number.isFinite(window.innerHeight) && window.innerHeight > 0
                        ? window.innerHeight
                        : Math.max(1, document.documentElement.clientHeight || 1));
                const rect = toggle?.getBoundingClientRect();
                const usable = rect
                    && Number.isFinite(rect.left)
                    && Number.isFinite(rect.top)
                    && Number.isFinite(rect.width)
                    && Number.isFinite(rect.height)
                    && rect.width > 0
                    && rect.height > 0;
                const rawX = usable ? rect.left + rect.width / 2 : width - 40;
                const rawY = usable ? rect.top + rect.height / 2 : 32;
                const x = Math.min(width, Math.max(0, Number.isFinite(rawX) ? rawX : width / 2));
                const y = Math.min(height, Math.max(0, Number.isFinite(rawY) ? rawY : height / 2));
                const radius = Math.max(1, Math.hypot(Math.max(x, width - x), Math.max(y, height - y)));
                return { x, y, radius };
            };

            const setTransitionGeometry = () => {
                const geometry = getGeometry();
                root.style.setProperty("--qmah-theme-x", `${geometry.x}px`);
                root.style.setProperty("--qmah-theme-y", `${geometry.y}px`);
                root.style.setProperty("--qmah-theme-radius", `${geometry.radius}px`);
            };

            const cleanupTransition = (transitionClass, previousToggleTransitionName) => {
                root.classList.remove(transitionClass);
                root.style.removeProperty("--qmah-theme-x");
                root.style.removeProperty("--qmah-theme-y");
                root.style.removeProperty("--qmah-theme-radius");

                if (!toggle) return;
                if (previousToggleTransitionName) {
                    toggle.style.setProperty("view-transition-name", previousToggleTransitionName);
                } else {
                    toggle.style.removeProperty("view-transition-name");
                }
            };

            const runThemeTransition = (theme, persist) => {
                if (reduceMotion.matches || typeof document.startViewTransition !== "function") {
                    applyTheme(theme, persist);
                    return Promise.resolve();
                }

                const transitionClass = `qmah-theme-transition--${theme}`;
                const previousToggleTransitionName = toggle?.style.getPropertyValue("view-transition-name") || "";
                setTransitionGeometry();
                root.classList.add(transitionClass);
                toggle?.style.setProperty("view-transition-name", "qmah-theme-toggle");

                let transition;
                try {
                    transition = document.startViewTransition(() => applyTheme(theme, persist));
                } catch {
                    cleanupTransition(transitionClass, previousToggleTransitionName);
                    applyTheme(theme, persist);
                    return Promise.resolve();
                }

                return Promise.resolve(transition?.finished)
                    .catch(() => {
                        // View Transition 只是增強效果；動畫失敗時仍保留主題切換。
                    })
                    .then(() => {
                        if (root.dataset.bsTheme !== theme) {
                            applyTheme(theme, persist);
                        }
                    })
                    .finally(() => cleanupTransition(transitionClass, previousToggleTransitionName));
            };

            const switchTheme = (theme, persist = true) => {
                if (theme !== "dark" && theme !== "light") return Promise.resolve();

                pendingThemeRequest = { theme, persist };
                if (themeTransitionPromise) return themeTransitionPromise;

                toggle?.setAttribute("aria-busy", "true");
                let lastThemeRequest = null;
                themeTransitionPromise = (async () => {
                    while (pendingThemeRequest) {
                        const request = pendingThemeRequest;
                        pendingThemeRequest = null;
                        lastThemeRequest = request;

                        if (request.theme === root.dataset.bsTheme) continue;
                        // 快速連點只保留最後意圖，整段期間只維持一個原生 transition。
                        await runThemeTransition(request.theme, request.persist);
                    }
                })().catch(() => {
                    const fallbackRequest = pendingThemeRequest || lastThemeRequest;
                    pendingThemeRequest = null;
                    if (fallbackRequest && fallbackRequest.theme !== root.dataset.bsTheme) {
                        applyTheme(fallbackRequest.theme, fallbackRequest.persist);
                    }
                }).finally(() => {
                    toggle?.removeAttribute("aria-busy");
                    themeTransitionPromise = null;
                    if (pendingThemeRequest) {
                        void switchTheme(pendingThemeRequest.theme, pendingThemeRequest.persist);
                    }
                });

                return themeTransitionPromise;
            };

            toggle?.addEventListener("click", () => {
                const nextTheme = root.dataset.bsTheme === "dark" ? "light" : "dark";
                void switchTheme(nextTheme);
            });

            window.addEventListener("storage", (event) => {
                if (event.key !== themeStorageKey || (event.newValue !== "dark" && event.newValue !== "light")) return;
                if (event.newValue === root.dataset.bsTheme) return;
                void switchTheme(event.newValue, false);
            });

            sync();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
