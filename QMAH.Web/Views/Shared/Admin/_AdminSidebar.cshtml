@using QMAH.Web.Infrastructure.AdminNavigation
@inject AdminNavigationService AdminNavigation
@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isDashboard = string.IsNullOrWhiteSpace(currentArea) && currentController == "Home";
    var areaItems = AdminNavigation.GetAreaItems(currentArea);
}
<aside class="navbar navbar-vertical navbar-expand-xl" aria-label="後台主要導覽">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-qmah-mobile-sidebar-toggle
                aria-controls="admin-sidebar-menu" aria-expanded="false" aria-label="開啟側邊導覽">
            <span class="navbar-toggler-icon"></span>
        </button>
        <a class="navbar-brand qmah-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="清明鑑定屋後台首頁">
            <img class="qmah-brand-logo qmah-brand-logo--light" src="~/images/brand/qmah-logo.svg" alt="清明鑑定屋 QMAH" />
            <img class="qmah-brand-logo qmah-brand-logo--dark" src="~/images/brand/qmah-logo-dark.svg" alt="" />
        </a>
        <div class="collapse navbar-collapse" id="admin-sidebar-menu" aria-hidden="true">
            <ul class="navbar-nav pt-lg-2">
                <li class="nav-item">
                    <a class="nav-link @(isDashboard ? "active" : null)" asp-area="" asp-controller="Home" asp-action="Index" title="總覽"
                       aria-current="@(isDashboard ? "page" : null)">
                        <span class="nav-link-icon"><partial name="Admin/_Icon" model="@("dashboard")" /></span>
                        <span class="nav-link-title">總覽</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentArea == "Catalog" ? "active" : null)" asp-area="Catalog" asp-controller="Artifact" asp-action="Index" title="圖鑑管理"
                       aria-current="@(currentArea == "Catalog" ? "page" : null)">
                        <span class="nav-link-icon"><partial name="Admin/_Icon" model="@("catalog")" /></span>
                        <span class="nav-link-title">圖鑑管理</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentArea == "Game" ? "active" : null)" asp-area="Game" asp-controller="Home" asp-action="Index" title="遊戲管理"
                       aria-current="@(currentArea == "Game" ? "page" : null)">
                        <span class="nav-link-icon"><partial name="Admin/_Icon" model="@("game")" /></span>
                        <span class="nav-link-title">遊戲管理</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentArea == "Social" ? "active" : null)" asp-area="Social" asp-controller="Home" asp-action="Index" title="社群管理"
                       aria-current="@(currentArea == "Social" ? "page" : null)">
                        <span class="nav-link-icon"><partial name="Admin/_Icon" model="@("social")" /></span>
                        <span class="nav-link-title">社群管理</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentArea == "Store" ? "active" : null)" asp-area="Store" asp-controller="Home" asp-action="Index" title="商城管理"
                       aria-current="@(currentArea == "Store" ? "page" : null)">
                        <span class="nav-link-icon"><partial name="Admin/_Icon" model="@("store")" /></span>
                        <span class="nav-link-title">商城管理</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentArea == "User" ? "active" : null)" asp-area="User" asp-controller="Home" asp-action="Index" title="會員管理"
                       aria-current="@(currentArea == "User" ? "page" : null)">
                        <span class="nav-link-icon"><partial name="Admin/_Icon" model="@("user")" /></span>
                        <span class="nav-link-title">會員管理</span>
                    </a>
                </li>
                @if (areaItems.Count > 0)
                {
                    <li class="nav-item qmah-sidebar-section-label"><span>功能選單</span></li>
                    @foreach (var item in areaItems)
                    {
                        var isCurrentController = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
                        <li class="nav-item qmah-sidebar-subnav">
                            <a class="nav-link @(isCurrentController ? "active" : null)"
                               asp-area="@currentArea" asp-controller="@item.Controller" asp-action="Index"
                               aria-current="@(isCurrentController ? "page" : null)" title="@item.Label">
                                <span class="nav-link-title">@item.Label</span>
                            </a>
                        </li>
                    }
                }
            </ul>
            <div class="qmah-sidebar-footer mt-auto">
                <span>QMAH</span>
                <strong>內容管理後台</strong>
            </div>
        </div>
    </div>
    <div class="qmah-sidebar-backdrop" data-qmah-sidebar-backdrop aria-hidden="true"></div>
</aside>
