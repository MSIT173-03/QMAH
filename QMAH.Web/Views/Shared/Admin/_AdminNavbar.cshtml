@{
    var isAdmin = User.IsInRole("Admin");
    var currentAccount = User.Identity?.IsAuthenticated == true
        ? (User.Identity.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "目前帳號")
        : "未登入";
    var accountInitial = currentAccount.Length > 0 ? currentAccount[..1].ToUpperInvariant() : "帳";

    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAccountPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase);

    var sectionName = isAccountPage
        ? "總覽"
        : isAdmin
        ? currentArea switch
        {
            "Catalog" => "圖鑑管理",
            "Game" => "遊戲管理",
            "Social" => "社群管理",
            "Store" => "商城管理",
            "User" => "會員管理",
            _ => "總覽"
        }
        : "個人中心";
}
<header class="navbar d-print-none qmah-topbar" aria-label="後台工具列">
    <div class="container-xl">
        <button type="button" class="qmah-sidebar-toggle d-none d-xl-inline-flex" data-qmah-sidebar-toggle
                aria-controls="admin-sidebar-menu" aria-expanded="true" title="收合側邊欄">
            <partial name="Admin/_Icon" model="@("sidebar")" />
        </button>

        <div class="qmah-location" aria-label="目前位置">
            <span class="qmah-location__root">管理後台</span>
            <span class="qmah-location__divider" aria-hidden="true">/</span>
            <strong>@sectionName</strong>
        </div>

        <div class="navbar-nav flex-row ms-auto align-items-center qmah-topbar-actions">
            <div class="nav-item">
                <button type="button"
                        class="qmah-theme-toggle"
                        data-qmah-theme-toggle
                        aria-label="切換深色模式"
                        aria-pressed="false">
                    <span class="qmah-theme-icon qmah-theme-icon--moon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M20.4 15.3A8.5 8.5 0 0 1 8.7 3.6 8.5 8.5 0 1 0 20.4 15.3Z" /></svg>
                    </span>
                    <span class="qmah-theme-icon qmah-theme-icon--sun" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" /></svg>
                    </span>
                </button>
            </div>

            <div class="nav-item dropdown">
                <button class="qmah-account" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="開啟帳號選單">
                    <span class="avatar avatar-sm">@accountInitial</span>

                    <span class="qmah-account__text">
                        <strong>@currentAccount</strong>
                        <small>@(isAccountPage ? "管理後台" : isAdmin ? "內容管理" : "個人中心")</small>
                    </span>

                    <span class="qmah-account__chevron" aria-hidden="true">⌄</span>
                </button>

                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">回到管理總覽</a>
                    <div class="dropdown-divider"></div>
                    <form asp-area="User" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item">登出</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
