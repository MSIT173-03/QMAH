@using Microsoft.EntityFrameworkCore
@inject QMAH.Web.Data.QmahDbContext DbContext

@{
    var isAdmin = User.IsInRole("Admin");
    var isContentModerator = User.IsInRole("ContentModerator");
    var isEventModerator = User.IsInRole("EventModerator");

    var currentAccount = User.Identity?.IsAuthenticated == true
        ? (User.Identity.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "目前帳號")
        : "未登入";
    var accountInitial = currentAccount.Length > 0 ? currentAccount[..1].ToUpperInvariant() : "帳";

    string? avatarPath = null;
    var userIdValue = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    if (Guid.TryParse(userIdValue, out var currentUserId))
    {
        avatarPath = await DbContext.UserProfiles
            .AsNoTracking()
            .Where(profile => profile.UserId == currentUserId)
            .Select(profile => profile.AvatarPath)
            .SingleOrDefaultAsync();
    }

    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAccountPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase);

    var sectionName = isAccountPage
        ? "總覽"
        : isAdmin
        ? currentArea switch
        {
            "Catalog" => "圖鑑管理",
            "Game" => "遊戲管理",
            "Social" => "社群管理",
            "Store" => "商城管理",
            "User" => "會員管理",
            _ => "總覽"
        }
        : "個人中心";

    var roleLabel = isAdmin
        ? "系統管理員"
        : isContentModerator && isEventModerator
            ? "內容與活動審核"
            : isContentModerator
                ? "內容審核"
                : isEventModerator
                    ? "活動審核"
                    : "一般帳號";
}
<header class="navbar d-print-none qmah-topbar" aria-label="後台工具列">
    <div class="container-xl">
        <button type="button"
                class="qmah-mobile-menu d-xl-none"
                data-qmah-mobile-sidebar-toggle
                aria-controls="admin-sidebar-menu"
                aria-expanded="false"
                aria-label="開啟側邊導覽">
            <i class="ti ti-menu-2" aria-hidden="true"></i>
        </button>

        <a class="qmah-mobile-brand d-xl-none"
           asp-area=""
           asp-controller="Home"
           asp-action="Index"
           aria-label="清明鑑定屋後台首頁">
            <img class="qmah-mobile-brand-logo qmah-mobile-brand-logo--light"
                 src="~/images/brand/qmah-logo.svg"
                 alt="清明鑑定屋 QMAH" />
            <img class="qmah-mobile-brand-logo qmah-mobile-brand-logo--dark"
                 src="~/images/brand/qmah-logo-dark.svg"
                 alt="" />
        </a>

        <button type="button"
                class="qmah-sidebar-toggle d-none d-xl-inline-flex"
                data-qmah-sidebar-toggle
                aria-controls="admin-sidebar-menu"
                aria-expanded="true"
                title="收合側邊欄">
            <span class="qmah-sidebar-toggle-icon qmah-sidebar-toggle-icon--collapse" aria-hidden="true">
                <partial name="Admin/_Icon" model="@("sidebar-collapse")" />
            </span>
            <span class="qmah-sidebar-toggle-icon qmah-sidebar-toggle-icon--expand" aria-hidden="true">
                <partial name="Admin/_Icon" model="@("sidebar-expand")" />
            </span>
        </button>

        <div class="qmah-location" aria-label="目前位置">
            <span class="qmah-location__root">管理後台</span>
            <span class="qmah-location__divider" aria-hidden="true">/</span>
            <strong>@sectionName</strong>
        </div>

        <div class="navbar-nav flex-row ms-auto align-items-center qmah-topbar-actions">
            <div class="nav-item">
                <button type="button"
                        class="qmah-theme-toggle"
                        data-qmah-theme-toggle
                        aria-label="切換深色模式"
                        aria-pressed="false">
                    <span class="qmah-theme-icon qmah-theme-icon--moon" aria-hidden="true">
                        <i class="ti ti-moon"></i>
                    </span>
                    <span class="qmah-theme-icon qmah-theme-icon--sun" aria-hidden="true">
                        <i class="ti ti-sun"></i>
                    </span>
                </button>
            </div>

            <div class="nav-item dropdown">
                <button class="qmah-account"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="開啟帳號選單">
                    <span class="avatar avatar-sm qmah-account__avatar position-relative overflow-hidden">
                        @accountInitial
                        @if (!string.IsNullOrWhiteSpace(avatarPath))
                        {
                            <img src="@avatarPath"
                                 alt=""
                                 aria-hidden="true"
                                 loading="eager"
                                 decoding="async"
                                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
                                 onerror="this.remove();" />
                        }
                    </span>
                    <span class="qmah-account__text">
                        <strong>@currentAccount</strong>
                        <small>@roleLabel</small>
                    </span>
                    <span class="qmah-account__chevron" aria-hidden="true">
                        <i class="ti ti-chevron-down"></i>
                    </span>
                </button>

                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow qmah-account-menu">
                    <div class="qmah-account-menu__summary">
                        <span class="avatar qmah-account-menu__avatar position-relative overflow-hidden">
                            @accountInitial
                            @if (!string.IsNullOrWhiteSpace(avatarPath))
                            {
                                <img src="@avatarPath"
                                     alt=""
                                     aria-hidden="true"
                                     loading="eager"
                                     decoding="async"
                                     style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
                                     onerror="this.remove();" />
                            }
                        </span>
                        <div class="min-w-0">
                            <strong class="d-block text-truncate">@currentAccount</strong>
                            <span class="d-block">@roleLabel · @sectionName</span>
                        </div>
                    </div>

                    <div class="dropdown-divider"></div>

                    <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="ti ti-layout-dashboard"></i>
                        <span>回到管理總覽</span>
                    </a>

                    <div class="dropdown-divider"></div>

                    <form asp-area="User" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="ti ti-logout"></i>
                            <span>登出</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
