@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString()?.ToLowerInvariant();
    var areaKey = currentArea switch
    {
        "catalog" => "catalog",
        "game" => "game",
        "social" => "social",
        "store" => "store",
        "user" => "user",
        _ when string.Equals(
            ViewContext.RouteData.Values["controller"]?.ToString(),
            "Operations",
            StringComparison.OrdinalIgnoreCase) => "operations",
        _ => "dashboard"
    };
}
<!doctype html>
<html lang="zh-Hant" data-bs-theme="light" class="qmah-styles-pending">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f6f4" data-qmah-theme-color />
    <title>@ViewData["Title"]｜清明鑑定屋後台</title>
    <link rel="icon" href="~/images/brand/qmah-favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <style>
        /* 樣式尚未完成時先保留背景，避免短暫顯示未套版的後台內容 */
        html.qmah-styles-pending { background: #f3f6f4; }
        html[data-bs-theme="dark"].qmah-styles-pending { background: #151c1f; }
        html.qmah-styles-pending body { visibility: hidden; }
    </style>
    <noscript><style>html.qmah-styles-pending body { visibility: visible; }</style></noscript>
    <link rel="stylesheet" href="~/admin/css/qmah-fonts.css" asp-append-version="true" />

    <script>
        (() => {
            const root = document.documentElement;
            const savedTheme = localStorage.getItem("qmah-admin-theme");
            const theme = savedTheme === "dark" || savedTheme === "light"
                ? savedTheme
                : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

            root.dataset.bsTheme = theme;
            root.style.colorScheme = theme;

            if (localStorage.getItem("qmah-admin-sidebar") === "collapsed") {
                root.dataset.qmahSidebar = "collapsed";
            }
        })();
    </script>

    <link rel="stylesheet" href="~/admin/vendor/tabler/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/vendor/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-tabler.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-lists.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-actions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-area-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/qmah-admin-typography.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="qmah-admin qmah-area-@areaKey" data-qmah-area="@areaKey">
    <div class="qmah-theme-wash" data-qmah-theme-wash aria-hidden="true"></div>
    <a class="qmah-skip-link" href="#admin-main">跳至主要內容</a>
    <div class="page qmah-admin-shell">
        <partial name="Admin/_AdminSidebar" />
        <partial name="Admin/_AdminNavbar" />

        <div class="page-wrapper">
            <main id="admin-main" class="qmah-admin-main">
                @if (IsSectionDefined("PageHeader"))
                {
                    @await RenderSectionAsync("PageHeader")
                }
                else
                {
                    <div class="page-header d-print-none">
                        <div class="container-xl">
                            <div class="row align-items-center g-3">
                                <div class="col">
                                    <h1 class="page-title">
                                        @if (areaKey != "dashboard")
                                        {
                                            <span class="qmah-page-title-icon" aria-hidden="true">
                                                <partial name="Admin/_Icon" model="@areaKey" />
                                            </span>
                                        }
                                        <span>@(ViewData["Title"] ?? "管理後台")</span>
                                    </h1>
                                    @if (ViewData["AdminDescription"] is string description && !string.IsNullOrWhiteSpace(description))
                                    {
                                        <p class="qmah-page-description">@description</p>
                                    }
                                </div>

                                @if (IsSectionDefined("PageActions"))
                                {
                                    <div class="col-auto ms-auto d-print-none qmah-page-actions">
                                        <div class="qmah-actions">
                                            @await RenderSectionAsync("PageActions")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="page-body">
                    <div class="container-xl">
                        <partial name="Admin/_AdminAlerts" />
                        @RenderBody()
                    </div>
                </div>
            </main>

            <footer class="footer footer-transparent d-print-none qmah-admin-footer">
                <div class="container-xl">
                    <div class="qmah-admin-footer__inner">
                        <div class="qmah-admin-footer__identity">
                            <strong>清明鑑定屋 QMAH</strong>
                            <span>文物典藏與互動學習平台</span>
                        </div>
                        <nav class="qmah-admin-footer__links" aria-label="頁尾導覽">
                            <a asp-area="" asp-controller="Home" asp-action="Index">管理總覽</a>
                            <a asp-area="" asp-controller="Operations" asp-action="Index">營運中心</a>
                        </nav>
                        <div class="qmah-admin-footer__meta">© @DateTime.Now.Year QMAH 專題團隊 · 僅供專題展示與開發使用</div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <button type="button"
            class="qmah-back-to-top d-print-none"
            data-qmah-back-to-top
            aria-label="回到頁面頂端"
            title="回到頂端"
            hidden>
        <i class="ti ti-arrow-up" aria-hidden="true"></i>
    </button>

    <script>document.documentElement.classList.remove("qmah-styles-pending");</script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/admin/vendor/tabler/tabler.min.js" asp-append-version="true"></script>
    <script src="~/admin/js/qmah-admin.js" asp-append-version="true"></script>
    <script src="~/admin/js/qmah-interactions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (() => {
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
            const backToTop = document.querySelector("[data-qmah-back-to-top]");

            const syncBackToTop = () => {
                if (backToTop) {
                    backToTop.hidden = window.scrollY < 640;
                }
            };

            syncBackToTop();
            window.addEventListener("scroll", syncBackToTop, { passive: true });

            backToTop?.addEventListener("click", () => {
                window.scrollTo({
                    top: 0,
                    behavior: reduceMotion.matches ? "auto" : "smooth"
                });
            });

            document.querySelectorAll('.qmah-detail-nav a[href^="#"]').forEach((link) => {
                link.addEventListener("click", (event) => {
                    const selector = link.getAttribute("href");
                    const target = selector ? document.querySelector(selector) : null;
                    if (!target) return;

                    event.preventDefault();
                    target.scrollIntoView({
                        behavior: reduceMotion.matches ? "auto" : "smooth",
                        block: "start"
                    });
                    history.replaceState(null, "", selector);
                });
            });

            const editableSelector = [
                'input:not([type="hidden"]):not([type="submit"]):not([type="button"]):not([readonly]):not([disabled])',
                'textarea:not([readonly]):not([disabled])',
                'select:not([disabled])'
            ].join(",");

            const dirtyForms = new Set();

            document.querySelectorAll('form[method="post"]').forEach((form) => {
                if (!form.querySelector(editableSelector)) {
                    return;
                }

                const markDirty = () => dirtyForms.add(form);
                form.addEventListener("input", markDirty);
                form.addEventListener("change", markDirty);

                form.addEventListener("submit", (event) => {
                    if (!event.defaultPrevented) {
                        dirtyForms.delete(form);
                    }
                });
            });

            window.addEventListener("beforeunload", (event) => {
                if (dirtyForms.size === 0) {
                    return;
                }

                event.preventDefault();
                event.returnValue = "";
            });
        })();
    </script>
</body>
</html>
