@model string
@switch (Model)
{
    case "dashboard": <svg class="qmah-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" /></svg> break;
    case "catalog": <svg class="qmah-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M5 7l1 12h12l1-12M9 11h6M3 4h18v3H3z" /></svg> break;
    case "game": <svg class="qmah-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10l3 3-2 7H6l-2-7 3-3zM8 7l2-3h4l2 3M8 13h8M10 16h4" /></svg> break;
    case "social": <svg class="qmah-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v10H9l-4 4V5zM8 9h8M8 12h5" /></svg> break;
    case "store": <svg class="qmah-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 11H6L5 8zM8 8a4 4 0 0 1 8 0M9 12h6" /></svg> break;
    case "user": <svg class="qmah-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM17 11a3 3 0 0 0 0-6M17 15h1a3 3 0 0 1 3 3v2" /></svg> break;

    case "Artifact": <i class="ti ti-building-monument"></i> break;
    case "Key": <i class="ti ti-key"></i> break;
    case "KeyBackpack": <i class="ti ti-backpack"></i> break;
    case "KeyTransactions": <i class="ti ti-history"></i> break;

    case "QuestionEntries": <i class="ti ti-list-check"></i> break;
    case "Rooms": <i class="ti ti-door"></i> break;
    case "Players": <i class="ti ti-users-group"></i> break;
    case "Rounds": <i class="ti ti-refresh-dot"></i> break;
    case "Answers": <i class="ti ti-message"></i> break;
    case "Votes": <i class="ti ti-checkbox"></i> break;

    case "Product": <i class="ti ti-package"></i> break;
    case "Order": <i class="ti ti-receipt"></i> break;
    case "Coupon": <i class="ti ti-ticket"></i> break;
    case "CouponBackpack": <i class="ti ti-wallet"></i> break;

    case "SocialPostAdmin": <i class="ti ti-file-pencil"></i> break;
    case "SocialReportAdmin": <i class="ti ti-shield-alert"></i> break;
    case "SocialEventAdmin": <i class="ti ti-calendar-check"></i> break;
    case "Announcements": <i class="ti ti-speakerphone"></i> break;

    case "Members": <i class="ti ti-user-cog"></i> break;
    case "Achievements": <i class="ti ti-award"></i> break;
    case "PointTransactions": <i class="ti ti-coins"></i> break;

    case "search": <i class="ti ti-search"></i> break;
    case "theme": <i class="ti ti-sun"></i> break;
    case "sidebar": <i class="ti ti-layout-sidebar-left-collapse"></i> break;
    default: <i class="ti ti-point"></i> break;
}
