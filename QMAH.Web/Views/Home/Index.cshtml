@model QMAH.Web.Models.HomeDashboardViewModel

@{
    ViewData["Title"] = "管理總覽";
    ViewData["AdminDescription"] = "查看目前主要資料狀態，或直接進入各區後台。";

    var activeArtifactRate = Model.ArtifactCount == 0
        ? 0
        : (int)Math.Round(Model.ActiveArtifactCount * 100d / Model.ArtifactCount);

    var activeMemberRate = Model.MemberCount == 0
        ? 0
        : (int)Math.Round(Model.ActiveMemberCount * 100d / Model.MemberCount);

    var activeProductRate = Model.ProductCount == 0
        ? 0
        : (int)Math.Round(Model.ActiveProductCount * 100d / Model.ProductCount);
}

<div class="qmah-dashboard-metrics">
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">啟用文物</span><strong class="qmah-metric-value">@Model.ActiveArtifactCount</strong><span class="qmah-metric-note">共 @Model.ArtifactCount 件 · @activeArtifactRate%</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">公開貼文</span><strong class="qmah-metric-value">@Model.PublishedPostCount</strong><span class="qmah-metric-note">目前公開中的貼文</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">已發布活動</span><strong class="qmah-metric-value">@Model.ActiveEventCount</strong><span class="qmah-metric-note">已審核並發布</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">正常會員</span><strong class="qmah-metric-value">@Model.ActiveMemberCount</strong><span class="qmah-metric-note">共 @Model.MemberCount 人 · @activeMemberRate%</span></div></div></div>
    <div class="col"><div class="card qmah-metric-card h-100"><div class="card-body"><span class="qmah-metric-label">上架商品</span><strong class="qmah-metric-value">@Model.ActiveProductCount</strong><span class="qmah-metric-note">共 @Model.ProductCount 件 · @activeProductRate%</span></div></div></div>
</div>

<div class="row row-cards mb-3">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body"><div class="text-secondary">今日訂單</div><div class="h1 mb-0">@Model.TodayOrderCount</div></div></div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body"><div class="text-secondary">本月訂單</div><div class="h1 mb-0">@Model.MonthOrderCount</div></div></div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body"><div class="text-secondary">今日已付款營收</div><div class="h1 mb-0">@Model.TodayPaidRevenue.ToString("C0")</div></div></div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body"><div class="text-secondary">本月已付款營收</div><div class="h1 mb-0">@Model.MonthPaidRevenue.ToString("C0")</div></div></div>
    </div>
</div>

<div class="row row-cards mb-3">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-header"><div><h2 class="card-title mb-1">近 14 日付款趨勢</h2><div class="card-subtitle">只計入已有 PaidAt 的訂單。</div></div></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead><tr><th>日期</th><th>訂單數</th><th class="text-end">已付款營收</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.RecentOrderTrend)
                    {
                        <tr><td>@item.Date.ToString("yyyy/MM/dd")</td><td>@item.Orders</td><td class="text-end">@item.Revenue.ToString("C0")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header"><div><h2 class="card-title mb-1">訂單狀態</h2><div class="card-subtitle">目前資料庫中的狀態分布。</div></div></div>
            <div class="list-group list-group-flush">
            @if (Model.OrderStatuses.Count == 0)
            {
                <div class="list-group-item text-secondary">目前沒有訂單。</div>
            }
            else
            {
                @foreach (var item in Model.OrderStatuses)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Store" asp-controller="Order" asp-action="Index"><span>@QMAH.Web.Infrastructure.AdminDisplayLabels.Status(item.Status)</span><strong>@item.Count</strong></a>
                }
            }
            </div>
        </div>
    </div>
</div>

<div class="row row-cards mb-3">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-header"><div><h2 class="card-title mb-1">熱門商品</h2><div class="card-subtitle">依已付款訂單的銷售數量排序。</div></div></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead><tr><th>商品</th><th>數量</th><th class="text-end">成交金額</th></tr></thead>
                    <tbody>
                    @if (Model.HotProducts.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-secondary py-4">目前沒有已付款商品。</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.HotProducts)
                        {
                            <tr><td class="fw-semibold"><a asp-area="Store" asp-controller="Product" asp-action="GetProduct" asp-route-id="@item.ProductId">@item.Name</a></td><td>@item.Quantity</td><td class="text-end">@item.Revenue.ToString("C0")</td></tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header"><div><h2 class="card-title mb-1">交易摘要</h2><div class="card-subtitle">由既有訂單、優惠券與點數流水計算。</div></div></div>
            <div class="list-group list-group-flush qmah-status-list">
                <div class="list-group-item d-flex justify-content-between gap-3"><span>平均已付款客單</span><strong>@Model.AveragePaidOrderAmount.ToString("C0")</strong></div>
                <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Store" asp-controller="CouponBackpack" asp-action="Index"><span>已使用優惠券</span><strong>@Model.UsedCouponCount</strong></a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="User" asp-controller="PointTransactions" asp-action="Index"><span>點數異動筆數</span><strong>@Model.PointTransactionCount</strong></a>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards qmah-dashboard-primary">
    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header"><div><h2 class="card-title mb-1">各區管理</h2><div class="card-subtitle">選擇要處理的後台區域。</div></div></div>
            <div class="card-body">
                <div class="qmah-quick-grid">
                    <a class="qmah-quick-link" asp-area="Catalog" asp-controller="Home" asp-action="Index"><span class="avatar"><i class="ti ti-archive"></i></span><span><strong>圖鑑總覽</strong><small>文物、分類、年代、鑰匙與解鎖紀錄</small></span></a>
                    <a class="qmah-quick-link" asp-area="Game" asp-controller="Home" asp-action="Index"><span class="avatar"><i class="ti ti-device-gamepad-2"></i></span><span><strong>遊戲總覽</strong><small>題庫、房間、玩家與遊戲紀錄</small></span></a>
                    <a class="qmah-quick-link" asp-area="Social" asp-controller="Home" asp-action="Index"><span class="avatar"><i class="ti ti-messages"></i></span><span><strong>社群總覽</strong><small>貼文、活動、公告與檢舉處理</small></span></a>
                    <a class="qmah-quick-link" asp-area="" asp-controller="Operations" asp-action="Index"><span class="avatar"><i class="ti ti-chart-dots-3"></i></span><span><strong>營運中心</strong><small>營收、遊戲人流、稽核與圖庫管理</small></span></a>
                    <a class="qmah-quick-link" asp-area="User" asp-controller="Home" asp-action="Index"><span class="avatar"><i class="ti ti-id"></i></span><span><strong>會員總覽</strong><small>帳號、角色、成就與點數紀錄</small></span></a>
                    <a class="qmah-quick-link" asp-area="Store" asp-controller="Home" asp-action="Index"><span class="avatar"><i class="ti ti-shopping-bag"></i></span><span><strong>商城總覽</strong><small>商品、庫存、訂單、付款與優惠券</small></span></a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header"><div><h2 class="card-title mb-1">目前狀態</h2><div class="card-subtitle">幾個需要快速確認的數字。</div></div></div>
            <div class="list-group list-group-flush qmah-status-list">
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="Catalog" asp-controller="Artifact" asp-action="Index"><span>停用文物</span><strong>@(Model.ArtifactCount - Model.ActiveArtifactCount)</strong></a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="User" asp-controller="Members" asp-action="Index"><span>非正常狀態會員</span><strong>@(Model.MemberCount - Model.ActiveMemberCount)</strong></a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="Store" asp-controller="Product" asp-action="Index"><span>未上架商品</span><strong>@(Model.ProductCount - Model.ActiveProductCount)</strong></a>
                <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3" asp-area="Social" asp-controller="SocialEventAdmin" asp-action="Index"><span>已發布活動</span><strong>@Model.ActiveEventCount</strong></a>
            </div>
        </div>
    </div>
</div>

<div class="qmah-dashboard-data">
    <div class="card">
        <div class="card-header"><div><h2 class="card-title mb-1">內容資料</h2><div class="card-subtitle">圖鑑與社群目前的公開內容。</div></div></div>
        <div class="list-group list-group-flush qmah-data-list">
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Catalog" asp-controller="Artifact" asp-action="Index"><span>文物總數</span><strong>@Model.ArtifactCount</strong></a>
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Social" asp-controller="SocialPostAdmin" asp-action="Index"><span>公開貼文</span><strong>@Model.PublishedPostCount</strong></a>
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Social" asp-controller="SocialEventAdmin" asp-action="Index"><span>已發布活動</span><strong>@Model.ActiveEventCount</strong></a>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><div><h2 class="card-title mb-1">會員資料</h2><div class="card-subtitle">目前會員帳號的基本狀態。</div></div></div>
        <div class="list-group list-group-flush qmah-data-list">
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="User" asp-controller="Members" asp-action="Index"><span>會員總數</span><strong>@Model.MemberCount</strong></a>
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="User" asp-controller="Members" asp-action="Index"><span>正常會員</span><strong>@Model.ActiveMemberCount</strong></a>
            <div class="list-group-item d-flex justify-content-between gap-3"><span>正常會員比例</span><strong>@activeMemberRate%</strong></div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><div><h2 class="card-title mb-1">商城資料</h2><div class="card-subtitle">目前商品與上架狀態。</div></div></div>
        <div class="list-group list-group-flush qmah-data-list">
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Store" asp-controller="Product" asp-action="Index"><span>商品總數</span><strong>@Model.ProductCount</strong></a>
            <a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-area="Store" asp-controller="Product" asp-action="Index"><span>上架商品</span><strong>@Model.ActiveProductCount</strong></a>
            <div class="list-group-item d-flex justify-content-between gap-3"><span>商品上架比例</span><strong>@activeProductRate%</strong></div>
        </div>
    </div>
</div>

<div class="card qmah-dashboard-shortcuts">
    <div class="card-header"><div><h2 class="card-title mb-1">常用功能</h2><div class="card-subtitle">直接前往平常較常使用的管理頁面。</div></div></div>
    <div class="card-body">
        <div class="qmah-quick-grid">
            <a class="qmah-quick-link" asp-area="Catalog" asp-controller="Artifact" asp-action="Index"><span class="avatar"><i class="ti ti-photo"></i></span><span><strong>文物管理</strong><small>搜尋與維護文物資料</small></span></a>
            <a class="qmah-quick-link" asp-area="Game" asp-controller="Rooms" asp-action="Index"><span class="avatar"><i class="ti ti-door"></i></span><span><strong>房間管理</strong><small>查看目前房間與遊戲狀態</small></span></a>
            <a class="qmah-quick-link" asp-area="Social" asp-controller="SocialReportAdmin" asp-action="Index"><span class="avatar"><i class="ti ti-message-2-exclamation"></i></span><span><strong>檢舉管理</strong><small>查看與處理檢舉紀錄</small></span></a>
            <a class="qmah-quick-link" asp-area="User" asp-controller="Members" asp-action="Index"><span class="avatar"><i class="ti ti-user-cog"></i></span><span><strong>會員帳號</strong><small>查看會員狀態與角色</small></span></a>
            <a class="qmah-quick-link" asp-area="Store" asp-controller="Order" asp-action="Index"><span class="avatar"><i class="ti ti-receipt"></i></span><span><strong>訂單管理</strong><small>查看付款與訂單狀態</small></span></a>
        </div>
    </div>
</div>
