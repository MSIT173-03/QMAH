{
  "name": "qmah-client",
  "version": "0.0.0",
  "scripts": {
    "prestart": "node scripts/link-game-assets.mjs",
    "prestart:https": "node scripts/link-game-assets.mjs",
    "prestart:http": "node scripts/link-game-assets.mjs",
    "prebuild": "node scripts/ensure-dependencies.mjs && node scripts/link-game-assets.mjs",
    "prewatch": "node scripts/ensure-dependencies.mjs && node scripts/link-game-assets.mjs",
    "pretest": "node scripts/ensure-dependencies.mjs && node scripts/link-game-assets.mjs",
    "ng": "ng",
    "start": "node scripts/serve-auto.mjs",
    "start:https": "node scripts/serve-auto.mjs --api-protocol https",
    "start:http": "node scripts/serve-auto.mjs --api-protocol http",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretest:critical": "node scripts/ensure-dependencies.mjs && node scripts/link-game-assets.mjs",
    "test:critical": "ng test --watch=false --include=src/app/core/guards/auth-guard.spec.ts --include=src/app/core/services/api-read-deadline.spec.ts --include=src/app/core/services/notification-live.spec.ts --include=src/app/features/auth/login/login.spec.ts --include=src/app/features/member/economy/economy.spec.ts --include=src/app/store/pages/checkout/checkout.spec.ts --include=src/app/store/pages/orders/orders.spec.ts --include=src/app/shared/social-markup.spec.ts",
    "test:setup": "node --test scripts/ensure-dependencies.test.mjs scripts/dev-server-lifecycle.test.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@lucide/angular": "1.47.0",
    "@microsoft/signalr": "^10.0.11",
    "angularx-qrcode": "^21.0.5",
    "emoji-picker-element": "^1.29.1",
    "ngx-image-cropper": "^9.1.7",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.5",
    "daisyui": "^5.7.32",
    "jsdom": "30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@parcel/watcher": "2.6.0",
    "glob": "14.0.4",
    "minimatch": "11.0.8",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
