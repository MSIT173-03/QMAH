{
  "name": "qmah-client",
  "version": "0.0.0",
  "scripts": {
    "prestart": "node scripts/link-game-assets.mjs",
    "prestart:https": "node scripts/link-game-assets.mjs",
    "prestart:http": "node scripts/link-game-assets.mjs",
    "prebuild": "node scripts/link-game-assets.mjs",
    "prewatch": "node scripts/link-game-assets.mjs",
    "pretest": "node scripts/link-game-assets.mjs",
    "ng": "ng",
    "start": "node scripts/serve-auto.mjs",
    "start:https": "ng serve --proxy-config proxy.conf.json",
    "start:http": "ng serve --proxy-config proxy.http.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "@lucide/angular": "1.47.0",
    "@microsoft/signalr": "^10.0.11",
    "angularx-qrcode": "^21.0.5",
    "ngx-image-cropper": "^9.1.7",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.5",
    "daisyui": "^5.7.32",
    "jsdom": "30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
