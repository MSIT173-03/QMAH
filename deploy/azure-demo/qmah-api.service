[Unit]
Description=QMAH API
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=qmah
Group=qmah
WorkingDirectory=/opt/qmah/api
ExecStart=/opt/qmah/api/QMAH.Api
EnvironmentFile=/etc/qmah/api.env
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
