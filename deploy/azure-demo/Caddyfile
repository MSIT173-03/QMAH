{$QMAH_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        Strict-Transport-Security "max-age=604800"
        -Server
    }
    @admin path /admin /admin/*
    handle @admin {
        reverse_proxy 127.0.0.1:5102
    }
    @sharedMedia path /images/* /fonts/*
    @referenceMedia path /images/brand/* /images/login/* /images/store/* /fonts/*
    @versionedScroll {
        path /images/login/museum/qingming-court/*.webp
        query v=*
    }
    handle @sharedMedia {
        root * /opt/qmah/client
        header @referenceMedia Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
        # The query contains the image content hash; unchanged original images
        # can be reused across visits and deployments without another download.
        header @versionedScroll {
            Cache-Control "public, max-age=31536000, immutable"
            defer
        }
        route {
            file_server {
                pass_thru
            }
            reverse_proxy 127.0.0.1:5101
        }
    }
    @api path /api/* /hubs/* /media/* /uploads/* /signin-google /Callback /signin-oidc /signout-callback-oidc
    handle @api {
        reverse_proxy 127.0.0.1:5101
    }
    @bundles path *.js *.css *.map *.wasm
    handle @bundles {
        root * /opt/qmah/client
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @staticAssets path /assets/* /patterns/* /favicon.ico /manifest.webmanifest
    handle @staticAssets {
        root * /opt/qmah/client
        header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
        file_server
    }
    @spaRoutes path / /home /login /register /forgot-password /reset-password /verify-email /member /member/profile /member/security /member/economy /member/achievements /member/daily-activity /member/addresses /member/coupons /member/notifications /artifact-list /key-list /game /game/account /game/training /game/minigames /game/how-to /game/appreciation /game/rooms /game/room/* /game/test /social /social/posts /social/posts/* /social/events /social/events/* /social/members/* /social/announcements /store /store/products /store/product/* /store/coupons /store/cart /store/checkout /store/orders /privacy-policy /terms
    handle @spaRoutes {
        root * /opt/qmah/client
        header Cache-Control "no-store"
        header {
            Content-Type "text/html; charset=utf-8"
            Content-Disposition "inline"
            defer
        }
        rewrite * /index.html
        file_server
    }
    handle {
        root * /opt/qmah/client
        header Cache-Control "no-store"
        header {
            Content-Type "text/html; charset=utf-8"
            Content-Disposition "inline"
            defer
        }
        rewrite * /index.html
        file_server {
            status 404
        }
    }
}
