{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QMAH API（https）",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/QMAH.Api/bin/Debug/net10.0/QMAH.Api.dll",
      "cwd": "${workspaceFolder}/QMAH.Api",
      "launchBrowser": false,
      "preLaunchTask": "QMAH 建置 API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7249;http://localhost:5147"
      }
    },
    {
      "name": "QMAH Angular 前台",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}/QMAH.Client"
    }
  ],
  "compounds": [
    {
      "name": "QMAH 前台開發（API＋Angular）",
      "configurations": ["QMAH API（https）", "QMAH Angular 前台"]
    }
  ]
}
